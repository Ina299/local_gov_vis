-10205-43eb45017edd3452af792eb9","targetRecordSha256":"aa68464470d50c8dba7140f6324149ea016265fe8edf04da4e339ae9d2d06a6f","sheetId":"cached-10205-c49dd1963e65bba21a8eaa8e","add":{"department":null,"amounts":[],"indicators":[],"ratings":[],"evidence":[{"sourceUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9574.pdf","sourcePageUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9574.pdf","format":"pdf","fetchedAt":"2026-10-21T09:09:31.428Z","sha256":"e60615be0e95fea5ed0a76307c04631672ffcc7dbcfc1c9ed684dc0d984fdfea","rawText":"事業評価チェック表","page":null,"sheet":null,"cell":"extracted-text:chars:253-262"},{"sourceUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9574.pdf","sourcePageUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9574.pdf","format":"pdf","fetchedAt":"2026-10-21T09:09:31.428Z","sha256":"e60615be0e95fea5ed0a76307c04631672ffcc7dbcfc1c9ed684dc0d984fdfea","rawText":"太田市を代表する観光スポットとして、1 年を通して観光誘客のできる公園として両事業を実施していく。","page":null,"sheet":null,"cell":"extracted-text:chars:480-529"},{"sourceUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9574.pdf","sourcePageUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9574.pdf","format":"pdf","fetchedAt":"2026-10-21T09:09:31.428Z","sha256":"e60615be0e95fea5ed0a76307c04631672ffcc7dbcfc1c9ed684dc0d984fdfea","rawText":"\nＰ\nＬ\nＡ\nＮ\n\nＤ\nＯ\n\n「北部運動公園事業推進協議会」が事業運営を委託され実施している。（協議会は、太田市、観光協会、商工会議所、地元区長会、\n関係機関等で構成）\n平成 20 年 3 月 31 日に供用開始となった八王子山公園（北部運動公園）において、おおた芝桜まつりは平成 20 年度の全国都市緑\n化ぐんまフェアから 9 回、イルミネーションは平成 21 年度から 7 回それぞれ事業を実施している。","page":null,"sheet":null,"cell":"extracted-text:chars:270-474"}],"purpose":"太田市を代表する観光スポットとして、1 年を通して観光誘客のできる公園として両事業を実施していく。","activities":"「北部運動公園事業推進協議会」が事業運営を委託され実施している。（協議会は、太田市、観光協会、商工会議所、地元区長会、関係機関等で構成）\n平成 20 年 3 月 31 日に供用開始となった八王子山公園（北部運動公園）において、おおた芝桜まつりは平成 20 年度の全国都市緑化ぐんまフェアから 9 回、イルミネーションは平成 21 年度から 7 回それぞれ事業を実施している。"}},{"targetId":"cached-10205-474496009c16f3fa016be7f4","targetRecordSha256":"f3cc4db8f5ab8ba84ffcda0850e97af21215acd26ae045aa910c5220210ff38d","sheetId":"cached-10205-1e15ed5066bf4032a6a42a9a","add":{"department":null,"amounts":[],"indicators":[],"ratings":[],"evidence":[{"sourceUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9576.pdf","sourcePageUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9576.pdf","format":"pdf","fetchedAt":"2026-10-21T09:09:34.829Z","sha256":"352d468dd692e585fa3df723e3b7b2ee7a47ceafe164770fc349ed929a0e1036","rawText":"事業評価チェック表","page":null,"sheet":null,"cell":"extracted-text:chars:140-149"},{"sourceUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9576.pdf","sourcePageUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9576.pdf","format":"pdf","fetchedAt":"2026-10-21T09:09:34.829Z","sha256":"352d468dd692e585fa3df723e3b7b2ee7a47ceafe164770fc349ed929a0e1036","rawText":"・放課後や長期休業中の学習指導を行い、児童生徒の基礎学力を定着させる。\n・授業中の学習支援を行い、児童生徒の学習規律及び基礎学力を身に付けさせる。\n・個別の学習指導を行い、相談室等に登校してくる児童生徒の学力を向上させる。","page":null,"sheet":null,"cell":"extracted-text:chars:235-346"},{"sourceUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9576.pdf","sourcePageUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9576.pdf","format":"pdf","fetchedAt":"2026-10-21T09:09:34.829Z","sha256":"352d468dd692e585fa3df723e3b7b2ee7a47ceafe164770fc349ed929a0e1036","rawText":"個別に支援が必要な児童生徒に対し、生活習慣や学習規律を身に付けさせ、学力を定着させるため、小中学校に人的配置を行う。","page":null,"sheet":null,"cell":"extracted-text:chars:171-229"}],"purpose":"・放課後や長期休業中の学習指導を行い、児童生徒の基礎学力を定着させる。\n・授業中の学習支援を行い、児童生徒の学習規律及び基礎学力を身に付けさせる。\n・個別の学習指導を行い、相談室等に登校してくる児童生徒の学力を向上させる。","activities":"個別に支援が必要な児童生徒に対し、生活習慣や学習規律を身に付けさせ、学力を定着させるため、小中学校に人的配置を行う。"}},{"targetId":"cached-10205-561653151bfae23bf45e3bec","targetRecordSha256":"d90b28e484a1dad84784998951f5df890d16bedae806e62c359b497853588b0a","sheetId":"cached-10205-78496aacf8652f5bf224dd1e","add":{"department":null,"amounts":[],"indicators":[],"ratings":[],"evidence":[{"sourceUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9575.pdf","sourcePageUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9575.pdf","format":"pdf","fetchedAt":"2026-10-21T09:09:33.168Z","sha256":"031e7cb833863e8813e5d6696baa5e6724e99e79f5a940ce8eb1837755451f48","rawText":"事業評価チェック表","page":null,"sheet":null,"cell":"extracted-text:chars:282-291"},{"sourceUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9575.pdf","sourcePageUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9575.pdf","format":"pdf","fetchedAt":"2026-10-21T09:09:33.168Z","sha256":"031e7cb833863e8813e5d6696baa5e6724e99e79f5a940ce8eb1837755451f48","rawText":"納期内納付及び自主納付の促進と滞納額の縮減","page":null,"sheet":null,"cell":"extracted-text:chars:485-506"},{"sourceUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9575.pdf","sourcePageUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9575.pdf","format":"pdf","fetchedAt":"2026-10-21T09:09:33.168Z","sha256":"031e7cb833863e8813e5d6696baa5e6724e99e79f5a940ce8eb1837755451f48","rawText":"地方自治体の貴重な自主財源となる税収確保の重要性は増大し、税務行政における厳正かつ公平な事務執行を通じて地方財政\nの基盤となる財源を適正に確保していくことが強く求められております。税務行政は、各自治体が自己の責任と権限に基づき、市民に不公平\n感を招かない賦課及び徴収が求められていることから、公平公正そして適切な収納業務に取り組むものです。","page":null,"sheet":null,"cell":"extracted-text:chars:309-479"}],"purpose":"納期内納付及び自主納付の促進と滞納額の縮減","activities":"地方自治体の貴重な自主財源となる税収確保の重要性は増大し、税務行政における厳正かつ公平な事務執行を通じて地方財政の基盤となる財源を適正に確保していくことが強く求められております。税務行政は、各自治体が自己の責任と権限に基づき、市民に不公平感を招かない賦課及び徴収が求められていることから、公平公正そして適切な収納業務に取り組むものです。"}},{"targetId":"cached-10205-74398b6347d2616424f8ed83","targetRecordSha256":"51e0ab3fd6f7d795c218de717a227ccae0fb2efcc530f2b08887a34f71c8509a","sheetId":"cached-10205-f4fd8800c1d3655d101310a9","add":{"department":null,"amounts":[],"indicators":[],"ratings":[],"evidence":[{"sourceUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9568.pdf","sourcePageUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9568.pdf","format":"pdf","fetchedAt":"2026-10-21T09:09:21.186Z","sha256":"592970c5a90cbf54f123aee01489bb5f12fde23ad99b8ef175b619548356b0c5","rawText":"事業評価チェック表","page":null,"sheet":null,"cell":"extracted-text:chars:120-129"},{"sourceUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9568.pdf","sourcePageUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9568.pdf","format":"pdf","fetchedAt":"2026-10-21T09:09:21.186Z","sha256":"592970c5a90cbf54f123aee01489bb5f12fde23ad99b8ef175b619548356b0c5","rawText":"・各部（本校）開催事業：ジュニア世代のスポーツ普及啓発を図るとともに、トップアスリートを輩出すべく強化体制を確立する\n施策を講じる。同時にスポーツを通じた青少年の健全育成を図る。\n・各部（支部）支援事業：地域におけるスポーツの普及及び底辺拡大を図るため、支部活動に対し公的支援を行う。\n・特別活動各種事業：大会、合宿、強化練習会、講習会等に積極的に参加し、競技力の向上と意識改革を図る。\n・スポーツ指導者派遣事業：専門的知識を持つ優秀な指導者を派遣することにより、スポーツ選手のより一層の技術力の向上を図る。","page":null,"sheet":null,"cell":"extracted-text:chars:213-467"},{"sourceUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9568.pdf","sourcePageUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9568.pdf","format":"pdf","fetchedAt":"2026-10-21T09:09:21.186Z","sha256":"592970c5a90cbf54f123aee01489bb5f12fde23ad99b8ef175b619548356b0c5","rawText":"ジュニアスポーツ競技者の強化育成及び普及啓発を積極的に推進し、競技力向上はもとより、健全な青少年育成に寄与する。","page":null,"sheet":null,"cell":"extracted-text:chars:151-207"}],"purpose":"・各部（本校）開催事業：ジュニア世代のスポーツ普及啓発を図るとともに、トップアスリートを輩出すべく強化体制を確立する施策を講じる。同時にスポーツを通じた青少年の健全育成を図る。\n・各部（支部）支援事業：地域におけるスポーツの普及及び底辺拡大を図るため、支部活動に対し公的支援を行う。\n・特別活動各種事業：大会、合宿、強化練習会、講習会等に積極的に参加し、競技力の向上と意識改革を図る。\n・スポーツ指導者派遣事業：専門的知識を持つ優秀な指導者を派遣することにより、スポーツ選手のより一層の技術力の向上を図る。","activities":"ジュニアスポーツ競技者の強化育成及び普及啓発を積極的に推進し、競技力向上はもとより、健全な青少年育成に寄与する。"}},{"targetId":"cached-10205-74fec8b9d71d46f0249ff147","targetRecordSha256":"9378ea12112283a00e909036ae4b2544d3508589aaece53d35277eb9d118145d","sheetId":"cached-10205-e31f34be0c75301bf1e39150","add":{"department":null,"amounts":[],"indicators":[],"ratings":[],"evidence":[{"sourceUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9573.pdf","sourcePageUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9573.pdf","format":"pdf","fetchedAt":"2026-10-21T09:09:29.750Z","sha256":"d9d1de7f8177c6469b8280725f5eb5aac30cbeb6d93c9cb2d79105bd9b1b481b","rawText":"事業評価チェック表","page":null,"sheet":null,"cell":"extracted-text:chars:176-185"},{"sourceUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9573.pdf","sourcePageUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9573.pdf","format":"pdf","fetchedAt":"2026-10-21T09:09:29.750Z","sha256":"d9d1de7f8177c6469b8280725f5eb5aac30cbeb6d93c9cb2d79105bd9b1b481b","rawText":"・放課後児童クラブ（学童クラブ）を補完する事により、待機児童の解消に寄与する。\n・運営スタッフは地域の人材を活用し「地域のこどもは地域で育てる」を実践する場として、地域力の向上にも役立っている。\n・一人親世帯や多子世帯の児童を優先的に受け入れることで、経済的な負担の軽減になっている。","page":null,"sheet":null,"cell":"extracted-text:chars:294-436"},{"sourceUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9573.pdf","sourcePageUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9573.pdf","format":"pdf","fetchedAt":"2026-10-21T09:09:29.750Z","sha256":"d9d1de7f8177c6469b8280725f5eb5aac30cbeb6d93c9cb2d79105bd9b1b481b","rawText":"\nＰ\nＬ\nＡ\nＮ\n\nＤ\nＯ\n\n就労者世帯等の子育て支援として、保護者が就労等により昼間家庭にいない小学生に対し、小学校の余裕教室等を利用して、子\nどもたちの安全・安心な活動場所の確保を図る。","page":null,"sheet":null,"cell":"extracted-text:chars:193-288"}],"purpose":"・放課後児童クラブ（学童クラブ）を補完する事により、待機児童の解消に寄与する。\n・運営スタッフは地域の人材を活用し「地域のこどもは地域で育てる」を実践する場として、地域力の向上にも役立っている。\n・一人親世帯や多子世帯の児童を優先的に受け入れることで、経済的な負担の軽減になっている。","activities":"就労者世帯等の子育て支援として、保護者が就労等により昼間家庭にいない小学生に対し、小学校の余裕教室等を利用して、子どもたちの安全・安心な活動場所の確保を図る。"}}],"sources":[{"id":"enrichment-10205-c489ef822797a67f79ca7925","municipalityCode":"10205","municipalityName":"太田市","sourcePageUrl":"https://www.city.ota.gunma.jp/uploaded/attachment/9567.pdf","evaluationYear":null,"status":"partial","discoveredDocuments":1,"fetchedDocuments":1,"extractedProjects":0,"scope":"既存レコードの補強に使った評価シート。この資料からの新規レコードはない。","message":"公開済みレコードと同じ事業の評価シートから、金額・指標・評価・所管を追加。","lastAttemptAt":"2026-10-21T09:09:19.530Z","lastSuccessAt":"2026-10-21T09:09:19.530Z","documents":[{"url":"https://www.city.ota.gunma.jp/uploaded/attachment/9567.pdf","format":"pdf","status":"partial","sha256":"5172077623ebc76325bda05fe2d6dc1d026f6c21717a9dbbbd425fac1d8c93b0","fetchedAt":"2026-10-21T09:09:19.530Z","projectCount":0,"message":"既存レコードの補強の根拠"}]},{"id":"enrichment-