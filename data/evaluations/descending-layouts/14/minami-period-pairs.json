        "rawText": "令和２年 11 月",
        "page": null,
        "sheet": null,
        "cell": "extracted-text:chars:27-36"
      },
      {
        "sourceUrl": "https://www.city.minamiashigara.kanagawa.jp/global-image/units/211330/1-20201208153820.pdf",
