shinto.gunma.jp/education/000162/p000824.html","verification":{"basis":["national_government_directory_host_only"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"official_host_only"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T11:34:34.079Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"5caf053c7830563d12c7c4a1f89189c74f999e4caa085acf6746537c33aad4b0","state":"acquired"},"evaluationType":"policy_evaluation","format":"html","id":"278053045752ac2209f88f36","navigationReview":{"checkedAt":"2026-10-21T10:55:00Z","evidenceUrl":"https://www.vill.shinto.gunma.jp/administration/000366/000368/p000500.html","method":"official_body_review","notes":"総合計画と進捗状況調査票の掲載ページ。","originEvidenceUrl":null,"publisher":"榛東村","rawArchiveState":"collected","yearNotes":"未確認"},"role":"supporting_document","text":{"assetBytes":3001,"assetPath":"documents/278053045752ac2209f88f36.json","assetSha256":"728ca37c82a6fdc5973370993915eb9c3bc2e9d515fc1684fed6541ae8157bcb","characters":867,"exportedCharacters":867,"extractionMethod":"visible_html_from_verified_bytes","inputTextSha256":"5caf053c7830563d12c7c4a1f89189c74f999e4caa085acf6746537c33aad4b0","label":"unstructured_source_text","preview":"第6次榛東村総合計画 | 榛東村公式ホームページ\n印刷用ページ\n榛東村トップ\n>\n行政情報\n>\n村の計画・取組\n>\n総合計画\n> 第6次榛東村総合計画\n第6次榛東村総合計画\nページ番号：P-000500\n総合計画は、長期的な展望に基づいて、むらづくりの将来目標を示すとともに、村政を総合的、計画的に運営するために、各行政分野における計画や事業の指針を明らかにするものであり、村政運営の最も基本となる計画です。\n本村では、平成18年度～ 27年度を期間とする第5次榛東村総合計画を策定し、「豊かさを実感し夢と感動を創造する村・榛東」を将来像として各種施策を講じてきました。全国的な人口減少、高齢化、少子化といった状況の中で、本村は一貫して人口が増加傾向で推移してきましたが、少子化・高齢化は進行しており、特に高齢者人口は平成2年から平成22年の20年間で2倍以上の増加となっています。\n「第6次榛東村総合計画」では、これまで進めてきたむらづくりにおける問題点の把握に努め、将来に向け取り組むべき課題として位置付けるとともに、更なる村民の福祉の向上をめざし、10年後の将来像を「子どもに夢をみんなに福祉と安心を」と描きました。この将来像には、乳幼児からお年寄りまで生涯にわたって安心できる健康・医療・福祉を享受でき、子どもが夢を抱きその夢に向かって歩むことができる環境を全村一体となって作り出していくという意気込みを込めています。\n第6次榛東村総合計画 概要版(pdf 3.58 MB)\n第6次榛東村総合計画(pdf 7.03 MB)\n第6次榛東村総合計画後期基本計画(pdf 1.95 MB)\n計画期間\n基本構想（平成28年度～平成37（令和7）年度）\n後期基本計画（令和3年度～令和7年度）\n進捗状況\n第6次榛東村総合計画進捗状況調査票(pdf 755 KB)\n関連リンク\nPDFファイルをご覧いただくためには、Adobe Reader が必要です。（新しいウィンドウが開きます）\n掲載日 令和3年9月16日\n更新日 令和8年8月7日","status":"available","textSha256":"5dadfe15e7a2020e6a4417b93a0f5c857045796b26b07c9d893b9ede965d024f","truncated":false},"title":"第6次榛東村総合計画","titleBasis":"inventory_title","url":"https://www.vill.shinto.gunma.jp/administration/000366/000368/p000500.html","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T11:34:36.112Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"4e9cf9b7173f332e9d90f78013a2dad2c43799fbc3950bf8269086004a1f1a25","state":"acquired"},"evaluationType":"policy_evaluation","format":"pdf","id":"ff471ae08d9b2354a8c8fcb9","navigationReview":{"checkedAt":"2026-10-21T10:55:00Z","evidenceUrl":"https://www.vill.shinto.gunma.jp/administration/000366/000368/p000500.html","method":"official_body_review","notes":"掲載ページ本文でリンク確認。目標指標ごとの令和元〜6年度実績値と目標値の表。","originEvidenceUrl":null,"publisher":"榛東村","rawArchiveState":"collected","yearNotes":"令和元年度〜令和7年度の実績・目標欄（表に記載）"},"role":"supporting_document","text":{"assetBytes":11766,"assetPath":"documents/ff471ae08d9b2354a8c8fcb9.json","assetSha256":"1c3aaf08f61c10ab288a63342464e825e155ffed6ee919f901cb08c39b8a8ffc","characters":5542,"exportedCharacters":5542,"extractionMethod":"pdftotext_from_verified_bytes","inputTextSha256":"4e9cf9b7173f332e9d90f78013a2dad2c43799fbc3950bf8269086004a1f1a25","label":"unstructured_source_text","preview":"第６次榛東村総合計画進捗状況調査票（各個別計画の見直し等により、目標値が変更となっている場合があります。）\n実績値\n目標指標等\n\n目標値\n\n令和元年度\n\n令和２年度\n\n令和３年度\n\n令和４年度\n\n令和５年度\n\n令和６年度\n\n令和７年度\n\n1.49\n\n1.57\n\n1.38\n\n1.39\n\n1.41\n\n1.26\n\n未確定\n\n1.55\n\n人／年\n\n111.4\n\n97\n\n101\n\n89\