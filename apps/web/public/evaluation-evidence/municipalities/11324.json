務事業結果集計では、それぞれの事務事業の評価結果を用い、三芳町第４次総合振興計画の\n「","status":"available","textSha256":"f12be6b3a5fc3aba575dd0de1d3556e98a75a72465df1c7a6eab964e16b43f44","truncated":false},"title":"◇三芳町の行政評価 （91KB）","titleBasis":"official_link_label","url":"https://www.town.saitama-miyoshi.lg.jp/town/chosa/documents/hyouka-miyoshi.pdf","verification":{"basis":["directory_host_unique_to_municipality"],"evaluationRelevance":"verified","evidenceSha256":"a539124a8b269130e6656ea99ddf46949ebe3f23cabaed8d0a1cc271a09ba2f4","evidenceSourceId":"7277413306b5aaa54dde2ddc","status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":403,"inputStatus":"blocked","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"blocked"},"evaluationType":"unknown","format":"pdf","id":"a44a2a5fb0b88fe08ca6dece","role":"supporting_document","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":null,"label":"unstructured_source_text","preview":null,"status":"not_acquired","textSha256":null,"truncated":false},"title":"◇三芳町第4次総合振興計画における施策の体系（基本方針1〜5） （171KB）","titleBasis":"official_link_label","url":"https://www.town.saitama-miyoshi.lg.jp/town/chosa/documents/taikeizu.pdf","verification":{"basis":["literal_link_in_verified_official_page","same_municipality_official_host"],"evaluationRelevance":"not_established","evidenceSha256":"365c4b17ae4d313b7e078ae0b5c15f4eaa3a18f87e94075d765823871b7d3616","evidenceSourceId":"e95ddd8b1c7085b27d4613bb","status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":null,"inputStatus":"blocked","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"blocked"},"evaluationType":"unknown","format":"pdf","id":"cfc49f0c6d3db6bf5cc09502","role":"supporting_document","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractio