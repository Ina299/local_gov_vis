{"discovery":{"coverageCompleteness":"not_established","initialLook":true,"omittedRejectedSources":0,"searchAttemptsCount":1,"status":"fetched"},"evaluationPages":["6fa3f565ec5cddf32627bc0a"],"municipality":{"municipalityCode":"40604","municipalityName":"糸田町","prefectureCode":"40","prefectureName":"福岡県"},"officialDirectoryLinks":[],"officialFallback":null,"officialHomepage":null,"schemaVersion":1,"sources":[{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T08:45:54.022Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"549f11855c54fb64c2c644ee719b67786f418ab4edde596d64b7a9ec144153c1","state":"acquired"},"evaluationType":"grant_project_evaluation","format":"html","id":"6fa3f565ec5cddf32627bc0a","navigationReview":{"checkedAt":"2026-10-12T10:20:56.151Z","evidenceUrl":"https://www.town.itoda.lg.jp/administration/plan/page_00372.html","method":"official_body_review","notes":"平成27年度 地方創生先行型事業 検証結果 grant_effect_verification 自治体名・都道府県を自治体ドメイン及び公式参照情報と照合。","originEvidenceUrl":null,"publisher":"糸田町","rawArchiveState":"collected","yearNotes":"2015。H27事業、H28検証"},"role":"evaluation_landing_page","text":{"assetBytes":2159,"assetPath":"documents/6fa3f565ec5cddf32627bc0a.json","assetSha256":"1e7d0efbcea49656caf167c8ba886a7da5574498693d5838376a4bcc996b9bbd","characters":531,"exportedCharacters":531,"extractionMethod":"visible_html_from_verified_bytes","inputTextSha256":"549f11855c54fb64c2c644ee719b67786f418ab4edde596d64b7a9ec144153c1","label":"unstructured_source_text","preview":"人口ビジョン・総合戦略｜フリーページ- 糸田町\n人口ビジョン・総合戦略\n糸田町まち・ひと・しごと創生総合戦略事業【地方創生先行型交付金】の検証結果\n糸田町では、平成28年3月に「糸田町まち・ひと・しごと創生総合戦略」を策定しました。\n策定に先行し、地方創生のための6つの事業を地方創生先行型事業として平成27年度当初より実施しました。\nこの事業が終了し事業の検証が行われましたので、結果を公表します。\n●検証方法\n①担当課による検証\n②「糸田町地方創生・人口減少対策有識者委員会」による検証\n検証実施日：平成28年8月25日（木）、9月7日（水）\n平成27年度 地方創生先行型事業 検証結果(pdf)\n糸田町人口ビジョン・地方創生総合戦略を策定しました\n人口減少や少子高齢化に歯止めをかけ、糸田町を活性化させるための施策をまとめた「人口ビジョン」と「総合戦略」を策定しました。\n今後も、糸田町にある豊かな資源を活用し、町民の皆さんと協力し合いながら、町の発展に努めてまいります。\n糸田町まち・ひと・しごと創生人口ビジョン(pdf)\n糸田町まち・ひと・しごと創生総合戦略(pdf)\n◆問合せ\n糸田町役場 地域振興課\nメール\n前のページへ戻る\n[本文はここまでです]","status":"available","textSha256":"1e0cbd3a9227c58cbcbe04ebdd106ac07bc9a82a0bdf931353f2ee72c8e4ba5b","truncated":false},"title":"糸田町総合戦略事業 地方創生先行型交付金 検証結果","titleBasis":"inventory_title","url":"https://www.town.itoda.lg.jp/administration/plan/page_00372.html","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"verified","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]}]}
