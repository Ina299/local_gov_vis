inputStatus":"blocked","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"blocked"},"evaluationType":"unknown","format":"pdf","id":"c6673c6d60ed6a00fda97b4b","role":"supporting_document","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":null,"label":"unstructured_source_text","preview":null,"status":"not_acquired","textSha256":null,"truncated":false},"title":"第2章 人に寄り添うまちづくり","titleBasis":"official_link_label","url":"https://www.town.ami.lg.jp/cmsfiles/contents/0000008/8596/chap2.pdf","verification":{"basis":["literal_link_in_verified_official_page","same_municipality_official_host"],"evaluationRelevance":"not_established","evidenceSha256":"98c9cda0055b4aa6177f964c5095c378b6a46856b5779821fe203ef38b35b364","evidenceSourceId":"e35bc213c03c906eaf8f9d9f","status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-11T17:52:14.977672+00:00","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"98c9cda0055b4aa6177f964c5095c378b6a46856b5779821fe203ef38b35b364","state":"acquired"},"evaluationType":"mixed_evaluation","format":"html","id":"e35bc213c03c906eaf8f9d9f","role":"evaluation_landing_page","text":{"assetBytes":4845,"assetPath":"documents/e35bc213c03c906eaf8f9d9f.json","assetSha256":"09e83e0b186b82eb61e1efc14c0222584b610aff98c47184057fc8a7645f13c7","characters":1552,"exportedCharacters":1552,"extractionMethod":"visible_html_from_verified_bytes","inputTextSha256":"98c9cda0055b4aa6177f964c5095c378b6a46856b5779821fe203ef38b35b364","label":"unstructured_source_text","preview":"施策評価を実施しています | 茨城県阿見町ホームページ\n現在位置\nホーム\n町政情報\n施策・計画\n総合計画\nあしあと\n施策評価を実施しています\n[初版公開日:2022年01月20日]\n[更新日：2026年9月11日]\nID:8596\nソーシャルサイトへのリンクは別ウィンドウで開きます\n令和8年度施策評価(令和7年度結果)\n施策評価について\n阿見町第7次総合計画の特徴の1つである「PDCAサイクルに基づく総合的なマネジメント」に基づき、総合計画の実行性を担保するため、計画に定める施策の進行管理を適切に実施します。\n●評価の考え方\n（1）どのように施策等を展開すれば、より効果的な成果が得られるかについて、内部・外部の視点で評価を実施する。\n（2）庁内の主要課題調整や予算編成、日々の業務改善などさまざまな場面を通じて、進行管理・評価におけるPDCAサイクルを確立する。\n（3）業務の見直し等の結果や取組による成果など、客観的な情報を的確に評価シートに記録し、内部評価に加え、結果を広く一般に公表し、町民、関係者等の意見を評価に反映していくことで、町民、関係者等の納得と共感、満足度の向上を図る。\n●評価対象\n阿見町第7次総合計画前期基本計画に位置付けた42施策を評価対象とします。\n令和7年度の評価結果\n●結果の概要\n・全42施策中、81.0%の施策がAまたはB評価となった。A評価が増えたものの、B評価が減った。\n概ね良好の結果とは言えるが、一部遅れが見られる施策については、引き続き推進していく。\nA評価（順調に進捗している） ：5施策\nB評価（概ね順調に進捗している） ：29施策\nC評価（一","status":"available","textSha256":"224a1a599160aeea9b04043ff143280a32598c345c56f378aedadcc0ae11cb44","truncated":false},"title":"施策評価を実施しています | 茨城県阿見町ホームページ","titleBasis":"html_title","url":"https://www.town.ami.lg.jp/0000008596.html","verification":{"basis":["directory_host_unique_to_municipality"],"evaluationRelevance":"verified","evidenceSha256":"98c9cda0055b4aa6177f964c5095c378b6a46856b5779821fe203ef38b35b364","evidenceSourceId":"e35bc213c03c906eaf8f9d9f","status":"verified"},"years":[{"basis":"printed_text","calendarYear":2022,"label":"2022年","meaning":"calendar_year_mentioned","quote":"計画 あしあと 施策評価を実施しています [初版公開日:2022年01月20日] [更新日：2026年9月11日] ID:8596 ソーシャルサイトへのリンクは別ウィンドウで開"},{"basis":"printed_text","calendarYear":2026,"label":"2026年","meaning":"calendar_year_mentioned","quote":"ます [初版公開日:2022年01月20日] [更新日：2026年9月11日] ID:8596 ソーシャルサイトへのリンクは別ウィンドウで開きます 令和8年度施策評価(令和7年"},{"basis":"printed_text","calendarYear":2026,"label":"令和8年度","meaning":"evaluation_year","quote":"6 ソーシャルサイトへのリンクは別ウィンドウで開きます 令和8年度施策評価(令和7年度結果) 施策評価について 阿見町第7次総合計画の特徴の1つである「PDCAサイクルに基づく"},{"basis":"printed_text","calendarYear":2025,"label":"令和7年度","meaning":"fiscal_year_mentioned","quote":"へのリンクは別ウィンドウで開きます 令和8年度施策評価(令和7年度結果) 施策評価について 阿見町第7次総合計画の特徴の1つである「PDCAサイクルに基づく総合的なマネジメント"},{"basis":"printed_text","calendarYear":2025,"label":"令和7年度","meaning":"evaluation_year","quote":"画前期基本計画に位置付けた42施策を評価対象とします。 令和7年度の評価結果 ●結果の概要 ・全42施策中、81.0%の施策がAまたはB評価となった。A評価が増えたものの、B評"},{"basis":"printed_text","calendarYear":2024,"label":"令和6年度","meaning":"fiscal_year_mentioned","quote":"るようにし、効果的なPDCAサイクルの実現につなげる。 令和6年度の結果 令和6年度の施策評価 目標達成状況 施策数 割合 A（順調に進捗している） 4 9.5% B（概ね順調"},{"basis":"printed_text","calendarYear":2024,"label":"令和6年度","meaning":"evaluation_year","quote":"なPDCAサイクルの実現につなげる。 令和6年度の結果 令和6年度の施策評価 目標達成状況 施策数 割合 A（順調に進捗している） 4 9.5% B（概ね順調に進捗している）"}]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":null,"inputStatus":"blocked","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"blocked"},"evaluationType":"unknown","format":"pdf","id":"f150c07232c261dc73cb0fef","role":"supporting_document","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":null,"label":"unstructured_source_text","preview":null,"status":"not_acquired","textSha256":null,"truncated":false},"title":"第4章 人と自然を守るまちづくり","titleBasis":"official_link_label","url":"https://www.town.ami.lg.jp/cmsfiles/contents/0000008/8596/chap4.pdf","verification":{"basis":["literal_link_in_verified_official_page","same_municipality_official_host"],"evaluationRelevance":"not_established","evidenceSha256":"98c9cda0055b4aa6177f964c5095c378b6a46856b5779821fe203ef38b35b364","evidenceSourceId":"e35bc213c03c906eaf8f9d9f","status":"verified"},"years":[]}]}
