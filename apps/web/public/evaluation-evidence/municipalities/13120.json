ity.nerima.tokyo.jp/kusei/kaigi/kaigiroku/gyouseiunei/gyouseihyouka/gyouhyou25-3.files/25-3siryou2.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T11:34:59.922Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"3f24008a4ef0125b4c9cc3d9746877746eb48c69a73c214d864365485115228d","state":"acquired"},"evaluationType":"policy_evaluation","format":"pdf","id":"c8ff988c5f5da307c3b9bb2f","navigationReview":{"checkedAt":"2026-10-21T10:40:00Z","evidenceUrl":"https://www.city.nerima.tokyo.jp/kusei/kaigi/kaigiroku/gyouseiunei/gyouseihyouka/gyouhyou25-7.html","method":"official_body_review","notes":"第7回行政評価委員会（平成26年5月13日）ページでリンク確認。","originEvidenceUrl":null,"publisher":"練馬区","rawArchiveState":"collected","yearNotes":"平成25年度委員会の提言"},"role":"supporting_document","text":{"assetBytes":201209,"assetPath":"documents/c8ff988c5f5da307c3b9bb2f.json","assetSha256":"72764740101fd3f3af622e30230672791d1a898752f7e513faa4723bc2700a70","characters":72810,"exportedCharacters":72810,"extractionMethod":"pdftotext_from_verified_bytes","inputTextSha256":"3f24008a4ef0125b4c9cc3d9746877746eb48c69a73c214d864365485115228d","label":"unstructured_source_text","preview":"平成 25 年度\n\n（本\n\n編）\n\n平成 26 年（2014 年）５月\n練馬区行政評価委員会\n\n©練馬区\n\n\n空あ白\n\n\n改頁練馬区行政評価に関する提言（答申）\n平成 25 年５月 30 日付け 25 練企企第 10014 号により、貴職から、\n１\n２\n３\n\n区が行った事務事業評価の結果の妥当性について\n区が行った施策評価の結果の妥当性について\n区の行政評価制度のあり方について\n\nそれぞれ意見を求められました。\nこれまで、慎重に審議を重ね、このたび本書のとおり結論を得ましたの\nで、ここに提言として答申いたします。\n\n平成 26 年 5 月 13 日\n\n練馬区長\n\n前川\n\n燿男\n\n様\n\n練馬区行政評価委員会\n委 員 長\n副委員長\n副委員長\n委\n員\n委\n員\n委\n員\n委\n員\n委\n員\n委\n員\n委\n員\n委\n員\n\n廣\n谷\n石\n相\n市\n柴\n田\n萩\n馬\n廣\n吉\n\n野\n口\n田\n澤\n川\n田\n中\n野\n場\n田\n田\n\n良\n敏\n洋\n\n吉\n彦\n子\n愛\n庄 司\n信 之\n博\nうたみ\nさやか\n政 一\n美穂子\n\n\nはじめに\n練馬区では、平成 14 年度に行政評価制度を導入して以来、事務事業評価を毎\n年度、施策評価を原則２年毎に行ってきました。また、区が行った評価結果の\n客観性、信頼性および透明性を高めるために第三者機関による評価の仕組みを\n取り入れ、平成 16 年度から隔年で公募委員を含めた練馬区行政評価委員会を設\n置し、区民の視点から行政による内部評価の妥当性について評価してきました。\nこれまでの４次にわたる行政評価委員会では、内部評価結果の妥当性にとどま\nらず、施策体系、施策と事務事業との一貫性、評価基準の設定、評価結果の公\n表等、行政評価制度のあり方全般について提言を重ねてまいりました。これを\n受けた区側の真摯な努力により、練馬区の行政評価制度が高い水準となってき\nたことを喜ばしく思います。\n平成 25 年５月、第５次の行政評価委員会が設置され、志村豊志郎区長（当時）\nから、区が行った事務事業評価および施策評価の結果の妥当性、ならびに行政\n評価制度のあり方について諮問を受けました。\nこれらの諮問にこたえるために、私たち行政評価委員会では、二つの専門部\n会を設けて、対象とする 12 事務事業と 24 施策について、精力的かつ慎重に評\n価に当たりました。その結果、区が行った「総合評価の妥当性」について","status":"available","textSha256":"9d0c6255d6fc4829f3f52293d87f213d89e8285c960c6455e653ae3202c5cb22","truncated":false},"title":"資料1：行政評価に関する提言（本編）（PDF：721KB）","titleBasis":"inventory_title","url":"https://www.city.nerima.tokyo.jp/kusei/kaigi/kaigiroku/gyouseiunei/gyouseihyouka/gyouhyou25-7.files/25honpen.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T11:35:01.956Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"dfa215603212a31d1b7632f5b8d9aed015d526139cb0287d3e8de42d2082a3a7","state":"acquired"},"evaluationType":"policy_evaluation","format":"pdf","id":"fffdfed2413a7060be4554c7","navigationReview":{"checkedAt":"2026-10-21T10:40:00Z","evidenceUrl":"https://www.city.nerima.tokyo.jp/kusei/kaigi/kaigiroku/gyouseiunei/gyouseihyouka/gyouhyou25-7.html","method":"official_body_review","notes":"第7回行政評価委員会ページでリンク確認。","originEvidenceUrl":null,"publisher":"練馬区","rawArchiveState":"collected","yearNotes":"平成25年度委員会の提言"},"role":"supporting_document","text":{"assetBytes":315630,"assetPath":"documents/fffdfed2413a7060be4554c7.json","assetSha256":"fdd420df6418ccef12f718313dd4818f4cdba4f6b13397a7fc100882f08c176c","characters":136767,"continuations":[{"assetBytes":45239,"assetPath":"documents/fffdfed2413a7060be455