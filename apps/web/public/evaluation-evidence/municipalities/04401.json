.jp/page/1172.html","verification":{"basis":["national_government_directory_host_only"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"official_host_only"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":null,"inputStatus":"blocked","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"blocked"},"evaluationType":"unknown","format":"pdf","id":"a81cbd317cc7f1ece1c1075f","role":"candidate","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":null,"label":"unstructured_source_text","preview":null,"status":"not_acquired","textSha256":null,"truncated":false},"title":"平成２６年度（平成２５年度対象）松島町教育委員会教育行政点検評価報告書平成 26 年 9 月","titleBasis":"inventory_title","url":"https://www.town.miyagi-matsushima.lg.jp/index.cfm/6%2C187%2Cc%2Chtml/187/20140918-163044.pdf","verification":{"basis":["national_government_directory_host_only"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"official_host_only"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":null,"inputStatus":"blocked","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"blocked"},"evaluationType":"unknown","format":"pdf","id":"cb6a55f24ded897d92eefbdb","role":"candidate","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":null,"label":"unstructured_source_text","preview":null,"status":"not_acquired","textSha256":null,"truncated":false},"title":"第3章 令和2年度松島町教育行政点検評価","titleBasis":"inventory_title","url":"https://www.town.miyagi-matsushima.lg.jp/index.cfm/6%2C187%2Cc%2Chtml/41747/20211007-095901.pdf","verification":{"basis":["national_government_directory_host_only"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"official_host_only"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T09:08:08.979Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"fca88948703336d66887e23513dd47c84ba7d7800521fac5a93a1195763ed32b","state":"acquired"},"evaluationType":"education_inspection","format":"pdf","id":"1abef32a660185d4ebcfc4b5","navigationReview":{"checkedAt":"2026-10-21T08:45:41Z","evidenceUrl":"https://www.town.miyagi-matsushima.lg.jp/page/1172.html","method":"official_body_review","notes":"掲載ページのリンクを確認","originEvidenceUrl":null,"publisher":"松島町","rawArchiveState":"collected","yearNotes":"令和7年度（令和6年度対象）"},"role":"supporting_document","text":{"assetBytes":155871,"assetPath":"documents/1abef32a660185d4ebcfc4b5.json","assetSha256":"c79a7390c02fadb0447165dcea788e3d9ad6ba1d7cd7c2bfcd5b0d8e1f8cbed6","characters":54687,"exportedCharacters":54687,"extractionMethod":"pdftotext_from_verified_bytes","inputTextSha256":"fca88948703336d66887e23513dd47c84ba7d7800521fac5a93a1195763ed32b","label":"unstructured_source_text","preview":"令和７年度（令和６年度対象）\n\n松島町教育委員会教育行政点検評価報告書\n\n令和７年９月\n松島町教育委員会\n\n\n～はじめに～\n「地方教育行政の組織及び運営に関する法律」に基づき、教育委員会は、毎年、その権限に属する事務の管理及び\n執行の状況について点検及び評価を行い、その結果に関する報告書を作成し、町議会に提出するとともに、これを公\n表する義務があります。\n松島町教育委員会は、法の趣旨に則り、効果的な教育行政の推進に資するとともに、町民の皆さんへの説明責任を\n果たすため、学識経験者の知見を活用し、教育委員会事務の点検及び評価を実施し、報告書としてまとめました。\n本報告書は、課題や今後の改善方策を明らかにするとともに、効率的かつ効果的な教育行政の推進を図ることを目\n的に編纂されています。\n第１章には松島町教育委員会の会議について、第２章には松島町教育基本方針と基本施策について、第３章には教\n育行政点検評価について取りまとめました。これらを踏まえ、より良い松島町の教育の実現に向けてしっかりと\n取り組んでまいります。\n令和７年９月\n松島町教育委員会\n\n関係法令\n◎地方教育行政の組織及び運営に関する法律（抜粋）\n（教育に関する事務の管理及び執行の状況の点検及び評価等）\n第２６条 教育委員会は、毎年、その権限に属する事務（前条第１項の規定により教育長に委任された事務そ\nの他教育長の権限に属する事務（同条第４項の規定により事務局職員等に委任された事務を含む。）を含む。）\nの管理及び執行の状況について点検及び評価を行い、その結果に関する報告書を作成し、これを議会に提出\nするとともに、公表しなければならない。\n２ 教育委員会は、前項の点検及び評価を行うに当たっては、教育に関し学識経験を有する者の知見の活用を\n図るものとする。\n\n\n－\n\n目\n\n次\n\n－\n\n第１章 令和６年度教育委員会議・教育委員の研修\n１ 会議開催内容及び結果\n２ 教育施設訪問及び会議・研修等\n３ 教育委員会議・教育委員の研修\n\n- １ - ３ - ５ -\n\n第２章 松島町教育委員会基本方針・基本施策\n１ 本町教育のめざす姿\n２ 本町教育の基本方針\n３ 本町教育の基本施策\n\n- ７ - ７ - ８ -\n\n第３章 令和６年度松島町教育行政点検評価\n１ 基本施策１：学びの芽生えに寄り添う幼児教育\n（１）遊びや生活での体験を","status":"available","textSha256":"8a150c7c42abcfd56ecac776f6c0f2df571f4e37b9a05d3b1afd923c716658e0","truncated":false},"title":"令和7年度（令和6年度対象）松島町教育委員会教育行政点検評価報告書","titleBasis":"inventory_title","url":"https://www.town.miyagi-matsushima.lg.jp/uploaded/attachment/1619.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T09:08:10.741Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"c8b315ab121789d4e17aad8f192c3a0e103bcbe12a228125976e86b427a5d6ac","state":"acquired"},"evaluationType":"education_inspection","format":"pdf","id":"29b242f20611b3724c5c2817","navigationReview":{"checkedAt":"2026-10-21T08:45:41Z","evidenceUrl":"https://www.town.miyagi-matsushima.lg.jp/page/1172.html","method":"official_body_review","notes":"掲載ページのリンクを確認","originEvidenceUrl":null,"publisher":"松島町","rawArchiveState":"collected","yearNotes":"令和6年度（令和5年度対象）"},"role":"supporting_document","text":{"assetBytes":148098,"assetPath":"documents/29b242f20611b3724c5c2817.json","assetSha256":"70c4c00d19ae4a15eff64daa55a4857987561181ad5fe1f6f06f512c82e15dae","characters":51918,"exportedCharacters":51918,"extractionMethod":"pdftotext_from_verified_bytes","inputTextSha256":"c8b315ab121789d4e17aad8f192c3a0e103bcbe12a228125976e86b427a5d6ac","label":"unstructured_source_text","preview":"令和６年度（令和５年度対象）\n\n松島町教育委員会教育行政点検評価報告書\n\n令和６年９月\n松島町教育委員会\n\n\n～はじめに～\n「地方教育行政の組織及び運営に関する法律」に基づき、教育委員会は、毎年、その権限に属する事務の管理及び\n執行の状況について点検及び評価を行い、その結果に関する報告書を作成し、町議会に提出するとともに、これを公\n表する義務があります。\n松島町教育委員会は、法の趣旨に則り、効果的な教育行政の推進に資するとともに、町民の皆さんへの説明責任を\n果たすため、学識経験者の知見を活用し、教育委員会事務の点検及び評価を実施し、報告書としてまとめました。\n本報告書は、課題や今後の改善方策を明らかにするとともに、効率的かつ効果的な教育行政の推進を図ることを目\n的に編纂されています。\n第１章には松島町教育委員会の会議について、第２章には松島町教育基本方針と基本施策について、第３章には教\n育行政点検評価について取りまとめました。これらを踏まえ、より良い松島町の教育の実現に向けてしっかりと\n取り組んでまいります。\n令和６年９月\n松島町教育委員会\n\n関係法令\n◎地方教育行政の組織及び運営に関する法律（抜粋）\n（教育に関する事務の管理及び執行の状況の点検及び評価等）\n第２６条 教育委員会は、毎年、その権限に属する事務（前条第１項の規定により教育長に委任された事務そ\nの他教育長の権限に属する事務（同条第４項の規定により事務局職員等に委任された事務を含む。）を含む。）\nの管理及び執行の状況について点検及び評価を行い、その結果に関する報告書を作成し、これを議会に提出\nするとともに、公表しなければならない。\n２ 教育委員会は、前項の点検及び評価を行うに当たっては、教育に関し学識経験を有する者の知見の活用を\n図るものとする。\n\n\n－\n\n目\n\n次\n\n－\n\n第１章 令和５年度教育委員会議・教育委員の研修\n１ 会議開催内容及び結果\n２ 教育施設訪問及び会議・研修等\n３ 教育委員会議・教育委員の研修\n\n- １ - ３ - ５ -\n\n第２章 松島町教育委員会基本方針・基本施策\n１ 本町教育のめざす姿\n２ 本町教育の基本方針\n３ 本町教育の基本施策\n\n- ７ - ７ - ８ -\n\n第３章 令和５年度松島町教育行政点検評価\n１ 基本施策１：学びの芽生えに寄り添う幼児教育\n（１）遊びや生活での体験を","status":"available","textSha256":"f0ab437690eef578b3ed629ea5bdd6f5bcfb23abbdb2683d7696391e2b3ea771","truncated":false},"title":"令和6年度（令和5年度対象）松島町教育委員会教育行政点検評価報告書","titleBasis":"inventory_title","url":"https://www.town.miyagi-matsushima.lg.jp/uploaded/attachment/1620.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T09:08:12.457Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"e6f0484c6174bd3802336e7c252bd506b017948a10059787fc2d72d60b8a17db","state":"acquired"},"evaluationType":"education_inspection","format":"pdf","id":"90f296e2dd0c236787cb5f8c","navigationReview":{"checkedAt":"2026-10-21T08:45:41Z","evidenceUrl":"https://www.town.miyagi-matsushima.lg.jp/page/1172.html","method":"official_body_review","notes":"掲載ページのリンクを確認","originEvidenceUrl":null,"publisher":"松島町","rawArchiveState":"collected","yearNotes":"令和5年度（令和4年度対象）"},"role":"supporting_document","text":{"assetBytes":128966,"assetPath":"documents/90f296e2dd0c236787cb5f8c.json","assetSha256":"21c776344f12270dd0e0cbcb