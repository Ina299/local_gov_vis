c016176be5c9f2904c02.json","assetSha256":"0c152d6da0e5a7dd3b6726fdbe702235c62f32250a5c2b5793b21cf5e6e34a49","characters":225,"exportedCharacters":225,"extractionMethod":"visible_html_from_verified_bytes","inputTextSha256":"2b56bfb1505fd005ffc98179f4f360cb43c425865e17fd63fb24d0c16ee4cf27","label":"unstructured_source_text","preview":"行政評価：静岡市公式ホームページ\n本文へスキップします。\n緊急情報\n閉じる\n静岡市防災ナビ\n災害時の情報収集への備え\n緊急情報一覧\n緊急情報RSS\nページID：12664\nここから本文です。\n行政評価\n静岡市政策・施策外部評価委員会\n事務事業評価\n監査・行政評価・内部統制・行政不服審査\n監査\n行政評価\n内部統制\n行政不服審査\nこちらの記事も読まれています。\n静岡市トップページ\n>\n市政情報\n>\n監査・行政評価・内部統制・行政不服審査\n> 行政評価","status":"available","textSha256":"e49c7eec328b38244a1bb628eeed5783412adbbbfbb7dce60b64d1de45499918","truncated":false},"title":"行政評価：静岡市公式ホームページ","titleBasis":"html_title","url":"https://www.city.shizuoka.lg.jp/p000300.html","verification":{"basis":["official_host_pattern","exact_municipality_name_in_verified_source","prefecture_or_unique_name_disambiguated"],"evaluationRelevance":"verified","evidenceSha256":"2b56bfb1505fd005ffc98179f4f360cb43c425865e17fd63fb24d0c16ee4cf27","evidenceSourceId":"06b7c016176be5c9f2904c02","status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-11T17:40:00.217115+00:00","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"5869a65398fd2144ae5854e11ee8ca3cbc90df58513dbcad2054da39b4e6a17f","state":"acquired"},"evaluationType":"business_project_evaluation","format":"html","id":"821c01e21bf6c0639e6bb85c","role":"evaluation_landing_page","text":{"assetBytes":3541,"assetPath":"documents/821c01e21bf6c0639e6bb85c.json","assetSha256":"8776f663a0467e160a2e3101602622bc92f97e7bc9b20905da230ab8451773c7","characters":1071,"exportedCharacters":1071,"extractionMethod":"visible_html_from_verified_bytes","inputTextSha256":"5869a65398fd2144ae5854e11ee8ca3cbc90df58513dbcad2054da39b4e6a17f","label":"unstructured_source_text","preview":"事務事業評価：静岡市公式ホームページ\n印刷\nページID：8139\n更新日：2026年9月25日\nここから本文です。\n事務事業評価\n事務事業評価は、市が行う取組の成果を点検し、より良いサービスへとつなげる仕組みです。下の図のように「点検と改善」のサイクルを繰り返すことで、限られた財源を効果的に活用しながら、効率的で質の高い行財政運営を目指します。\n静岡市では、市が行っている様々な取組のうち、まちづくりの中心となる主要な取組について、担当する部署自らが「どんな成果を目指すか」という目標（指標）を定めて評価を行っています。\n評価の結果、見直しが必要とわかった取組についてはしっかりと改善を行い、市民サービスの向上につなげていきます。\n（令和6（2024）年度に実施した事務事業評価までは、予算を伴う市の全ての事務事業（一部義務的経費等を除く）を評価対象としていましたが、令和7（2025）年度からは、予算を伴わない取組を含めた全ての取組のうち主要な取組を評価対象としています。）\n事務事業評価の目的\n事務事業評価は、次の（1）～（3）を主な目的として実施します。\n（1）説明責任の確保\n市の仕事の内容、目的、実施状況、効果等を市民の皆さんに分かりやすく公表することで、行政の説明責任と透明性を確保していきます。\n（2）成果志向の行政運営\n「どれだけの仕事をしたか」ではなく、「市民にどれだけの効果をもたらしたか」という視点により、市民満足度の高い成果重視の行政運営を推進します。\n（3）効果的・効率的な行政運営\n限られた経営資源の効果的な活用と適正な配分を行うため、事業の充実や継続、見直しの根拠とし","status":"available","textSha256":"ff71fad90c598d6ce88c61cd68a7398ae1f43ea8391bed3045382551a2fd2fd9","truncated":false},"title":"事務事業評価：静岡市公式ホームページ","titleBasis":"html_title","url":"https://www.city.shizuoka.lg.jp/s2547/s008285.html","verification":{"basis":["official_host_pattern","exact_municipality_name_in_verified_source","prefecture_or_unique_name_disambiguated"],"evaluationRelevance":"verified","evidenceSha256":"5869a65398fd2144ae5854e11ee8ca3cbc90df58513dbcad2054da39b4e6a17f","evidenceSourceId":"821c01e21bf6c0639e6bb85c","status":"verified"},"years":[{"basis":"printed_text","calendarYear":2026,"label":"2026年","meaning":"calendar_year_mentioned","quote":"市公式ホームページ 印刷 ページID：8139 更新日：2026年9月25日 ここから本文です。 事務事業評価 事務事業評価は、市が行う取組の成果を点検し、より良いサービスへと"}]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-11T18:03:13.598419+00:00","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"9da9a5711fa1206e38f0c109208a812cfbc79e9e774ddc7207dcf1739c2b1c95","state":"acquired"},"evaluationType":"business_project_evaluation","format":"html","id":"86624feebe08af886456c698","role":"evaluation_landing_page","text":{"assetBytes":2129,"assetPath":"documents/86624feebe08af886456c698.json","assetSha256":"ff01a30d787f4d165a60193f4b96aa132119bd062620b718207fd31b8fc2391