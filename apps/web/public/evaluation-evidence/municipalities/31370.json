memberPath":null,"method":"network","sourceSha256":"8d9ddc341ad7ff15786a73bdf4bf29c1ab1cb5a84d983b508b705a7a77eef78b","state":"acquired"},"evaluationType":"unknown","format":"pdf","id":"ded88d1f08fcc411f6697785","navigationReview":{"checkedAt":"2026-10-23T18:47:04.492379+00:00","evidenceUrl":"https://www.yurihama.jp/soshiki/19/8400.html","method":"official_body_review","notes":"保存済み公式ページ（原本SHA-256 e4e3be7ab74af0afd8e61d6dba823438e3bfbd67ef73912eba669780042f1b38）の本文リンクから機械的に収集。リンク先の内容・資料区分は未確認。","originEvidenceUrl":null,"publisher":"湯梨浜町","rawArchiveState":"collected","yearNotes":"未確認（リンク文字列のみ）"},"role":"evaluation_document","text":{"assetBytes":84479,"assetPath":"documents/ded88d1f08fcc411f6697785.json","assetSha256":"cf2e75ea946658cf5e70487b2c2d16a78bc810987bb1768c3461cbc02bd5eb34","characters":31139,"exportedCharacters":31139,"extractionMethod":"pdftotext_from_verified_bytes","inputTextSha256":"8d9ddc341ad7ff15786a73bdf4bf29c1ab1cb5a84d983b508b705a7a77eef78b","label":"unstructured_source_text","preview":"平成２１年度\n\n湯梨浜町教育行政の点検及び評価\n\n平成２２年６月\n湯梨浜町教育委員会\n\n\n目\n\nは\n\nじ\n\nめ\n\n次\n\nに\n・・・・・・・・・\n\n２\n\n・・・・・・・・\n\n３\n\n・・・・・・・・・\n\n３６\n\n平成２１年度教育委員会の主要施策\n\n教育委員会議及び教育委員の活動\n\n-1-\n\n\nは じ め に\n教育委員会の事務の点検・評価制度の導入について\n湯梨浜町教育委員会は、\n『げんき・いきいき・かがやきのまち』づくりを\n目指して、人格の完成という普遍的な教育目標と「２１世紀、夢がふくら\nみ一人ひとりが輝くまちづくり」の実現に向けて、住民を主役とした生涯\n学習の推進と学校教育の充実の向上に努めているところです。\nさて、平成１９年６月に「地方教育行政の組織及び運営に関する法律」\nの一部が改正（平成２０年４月１日施行）され、各教育委員会は、毎年、\nその権限に属する事務の管理及び執行の状況について点検及び評価を行い、\nその結果に関する報告書を作成し、議会に提出するとともに、公表するこ\nとが規定されました。\nこの改正では、効果的な教育行政の推進に資するとともに、町民への説\n明責任を果たしていくために、教育委員会が所掌する事務の管理・執行状\n況について点検・評価を行い、その結果に関する報告書を議会に提出し、\n公表することが義務付けられました。\n湯梨浜町教育委員会は、法改正の趣旨に即し、昨年度に引き続き平成２\n１年度の事務事業について「教育委員会事務の自己点検・評価」を実施し、\n報告書にまとめました。\n\n（参考）地方教育行政の組織及び運営に関する法律\n（平成１９年６月２７日一部改正）\n第２７条\n\n教育委員会は、毎年、その権限に属する事務（前条第１項の規定により教育\n\n長に委任された事務その他教育長の権限に属する事務（同条第３項の規定により事務\n局職員等に委任された事務を含む。）を含む。）の管理及び執行の状況について点検及\nび評価を行い、その結果に関する報告書を作成し、これを議会に提出するとともに、\n公表しなければならない。\n２ 教育委員会は、前項の点検及び評価を行うに当たっては、教育に関し学識経験を有\nする者の知見の活用を図るものとする。\n\n-2-\n\n\n平成２１年度湯梨浜町教育委員会の主要施策\n湯梨浜町教育委員会では、別紙の組織に基づき多様な事業を展開しており\nますが、自己点検･","status":"available","textSha256":"e3cf7f869d822a234540e6992f22dd47f1a653678a7829750be11e3cf5646f51","truncated":false},"title":"平成21年度湯梨浜町教育行政の点検及び評価 （PDFファイル）","titleBasis":"inventory_title","url":"https://www.yurihama.jp/uploaded/attachment/6370.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"verified","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-23T19:20:09.427Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"4b76243584519cc05acf1d1c3c1d0da2ec1842eafe4f5ddb9c7ec4323f38c5af","state":"acquired"},"evaluationType":"unknown","format":"pdf","id":"c02d3310be6bae69ab4e1037","navigationReview":{"checkedAt":"2026-10-23T18:47:04.492379+00:00","evidenceUrl":"https://www.yurihama.jp/soshiki/19/8400.html","method":"official_body_review","notes":"保存済み公式ページ（原本SHA-256 e4e3be7ab74af0afd8e61d6dba823438e3bfbd67ef73912eba669780042f1b38）の本文リンクから機械的に収集。リンク先の内容・資料区分は未確認。","originEvidenceUrl":null,"publisher":"湯梨浜町","rawArchiveState":"collected","yearNotes":"未確認（リンク文字列のみ）"},"role":"evaluation_document","text":{"assetBytes":95376,"assetPath":"documents/c02d3310be6bae69ab4e1037.json","assetSha256":"0077af608fe32b56eafdeedb735b489bc2c5f816f04f039e8964888a04b04298","characters":34738,"exportedCharacters":34738,"extractionMethod":"pdftotext_from_verified_bytes","inputTextSha256":"4b76243584519cc05acf1d1c3c1d0da2ec1842eafe4f5ddb9c7ec4323f38c5af","label":"unstructured_source_text","preview":"平成２２年度\n\n湯梨浜町教育行政の点検及び評価\n\n平成２３年６月\n湯梨浜町教育委員会\n\n\n目\n\nは\n\nじ\n\nめ\n\n次\n\nに\n・・・・・・・・・\n\n２\n\n平成２２年度湯梨浜町教育委員会の主要施策\n・・・・・・・・\n\n３\n\n・・・・・・・・・\n\n３９\n\n教育委員会議及び教育委員の活動\n\n-1-\n\n\nは じ め に\n教育委員会の事務の点検・評価制度の導入について\n湯梨浜町教育委員会は、まちづくりのテーマである『げんき・いきいき・\nかがやきのまち』づくりを目指して、人格の完成という普遍的な教育目標\nと「２１世紀、夢がふくらみ一人ひとりが輝くまちづくり」の実現に向け\nて、住民を主役とした生涯学習の推進と学校教育の充実の向上に努めてい\nるところです。\nさて、平成１９年６月に「地方教育行政の組織及び運営に関する法律」\nの一部が改正（平成２０年４月１日施行）されました。\nこの改正では、効果的な教育行政の推進に資するとともに、町民への説\n明責任を果たしていくために、教育委員会が所掌する事務の管理・執行状\n況について点検・評価を行い、その結果に関する報告書を議会に提出し、\n公表することが義務付けられました。\n湯梨浜町教育委員会は改正の趣旨に即し、平成２２年度の事務事業につ\nいて「教育委員会事務の自己点検・評価」を実施し、報告書にまとめまし\nた。\n\n（参考）地方教育行政の組織及び運営に関する法律\n（平成１９年６月２７日一部改正）\n第２７条\n\n教育委員会は、毎年、その権限に属する事務（前条第１項の規定により教育\n\n長に委任された事務その他教育長の権限に属する事務（同条第３項の規定により事務\n局職員等に委任された事務を含む。）を含む。）の管理及び執行の状況について点検及\nび評価を行い、その結果に関する報告書を作成し、これを議会に提出するとともに、\n公表しなければならない。\n２ 教育委員会は、前項の点検及び評価を行うに当たっては、教育に関し学識経験を有\nする者の知見の活用を図るものとする。\n\n-2-\n\n\n平成２２年度湯梨浜町教育委員会の主要施策\n湯梨浜町教育委員会では、別紙の組織に基づき多様な事業を展開しており\nますが、自己点検･評価の対象事業は、平成２２年度の教育委員会の権限に属\nする事務のうち、主要な事業を抽出し、担当課(教育総務課、生涯学習・人権\n推進課)で、事業のねらい、概要、取組状況","status":"available","textSha256":"19dd6e64da9b491ae3dd6020519d16bbcfbfe94897c182b3059c752d54c90fcd","truncated":false},"title":"平成22年度湯梨浜町教育行政の点検及び評価 （PDFファイル）","titleBasis":"inventory_title","url":"https://www.yurihama.jp/uploaded/attachment/6371.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"verified","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-23T19:20:11.945Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"63e78ca7f3b095a8d274d36d809ef3817d843e42f48e64a5dc465d437fe67352","state":"acquired"},"evaluationType":"unknown","format":"pdf","id":"6a4b4734a01acd977a354523","navigationReview":{"checkedAt":"2026-10-23T18:47:04.492379+00:00","evidenceUrl":"https://www.yurihama.jp/soshiki/19/8400.html","method":"official_body_review","notes":"保存済み公式ページ（原本SHA-256 e4e3be7ab74af0afd8e61d6dba823438e3bfbd67ef73912eba669780042f1b38）の本文リンクから機械的に収集。リンク先の内容・資料区分は未確認。","originEvidenceUrl":null,"publisher":"湯梨浜町","rawArchiveState":"collected","yearNotes":"未確認（リンク文字列のみ）"},"role":"evaluation_document","text":{"assetBytes":62808,"assetPath":"document