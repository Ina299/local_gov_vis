87ca1ebcd21a47e5e491"},{"assetBytes":321137,"assetPath":"documents/27d39c3073b7ea5867896be9-6.json","assetSha256":"906d1ea303961fdfcc33061407d76e673b7ef7d5e3374a002649effd6ef8d6fd","exportedCharacters":120000,"part":6,"startCharacter":600000,"textSha256":"46d7e460860ac677a665abe6ae9da729590f24720e63d3477564b4839f360a76"},{"assetBytes":320134,"assetPath":"documents/27d39c3073b7ea5867896be9-7.json","assetSha256":"c254d389530daed2d31a49593b863d83b52ce98194ea41c2b6e6f196e1773927","exportedCharacters":120000,"part":7,"startCharacter":720000,"textSha256":"244d224e48455dec12262e2ac4e35e9595c51945ffae8a4b2b7e234b25f52a0e"},{"assetBytes":321884,"assetPath":"documents/27d39c3073b7ea5867896be9-8.json","assetSha256":"a6cbd026a3fa2be8bf1a2500ac7f861c763c7655a4f12d91f024605ab8c52cec","exportedCharacters":120000,"part":8,"startCharacter":840000,"textSha256":"1427ec9caca5008ed0652eb3df817d34daa21c0182c9ccbfb8607612ab370d95"},{"assetBytes":319353,"assetPath":"documents/27d39c3073b7ea5867896be9-9.json","assetSha256":"d894ee4e858f8d11305c2d467d8c55e5120bdfd8abb409b9ee4afb229b0b721b","exportedCharacters":120000,"part":9,"startCharacter":960000,"textSha256":"65b7f35aa1b3cc8a3eff5b5d9fb5b505a85b6392f37d3fb8653b014f84ed2151"},{"assetBytes":73565,"assetPath":"documents/27d39c3073b7ea5867896be9-10.json","assetSha256":"7a8b7eafdfa4a8a0a3fa8df815d82b2bde9a2ccde2f251438d9b70787928f521","exportedCharacters":28050,"part":10,"startCharacter":1080000,"textSha256":"73f47049b7b93c96648b6c112343b03935f40c79a1123e84871212eb1b659fc3"}],"exportedCharacters":120000,"extractionMethod":"pdftotext_from_verified_bytes","fullTextSha256":"dca8264a7789f4c27b9fa8df0f13bd9ffec2a79a6c9c313cbe5572344c4f835f","inputTextSha256":"2c9b20acbb60ffb43e9404862333b6c367f58423782f3d861e417d37eed71b3a","label":"unstructured_source_text","preview":"さいたま市総合振興計画\n基本計画の実施状況報告書\n\n令和６年９月\n\nさいたま市\n\n\n\n目\n\n次\n\n１\n\nはじめに\n\n１\n\n２\n\n評価の対象及び方法\n\n１\n\n３\n\n評価結果の概要\n\n３\n\n４\n\n「評価シート」の見方\n\n27\n\n５\n\n施策の進捗及び事業の達成状況\n\n（１）施策の進捗及び事業の達成状況一覧\n\n35\n\n（２）評価シート\n\n53\n\n６\n\n重点戦略（まち・ひと・しごと創生総合戦略）\nの進捗状況\n\n774\n\n\n\n１\n\nはじめに\n\n本市では、総合的・計画的な行政運営を図るため、基本計画（政策・\n施策をわかりやすく体系化した指針）、実施計画（政策及び施策を実現\nするための個別の事務事業のうち主なものを定める計画）の２層からな\nる総合振興計画を定めています。\n総合振興計画の各施策・事業については、社会経済情勢や市民ニーズ\nの変化に的確に対応するため、ＰＤＣＡサイクルに基づく進行管理を行\nい、各事業の継続的な改善・見直しを図りながら将来都市像の実現を目\n指し、推進しているところです。\nこの度、令和５年度の施策の進捗状況及び事業の取組内容の点検結果\nを取りまとめましたので、本報告書をもって報告するものです。\n総合振興計画の構造図\n\n２\n\n評価の対象及び方法\n\n令和５年度実績に基づく内部評価は、「さいたま市総合振興計画基本\n計画」第３部及び第５部に掲載している全６２施策、「さいたま市総合\n振興計画基本計画実施計画」第４編に掲載している全３６７事業（※）\nを対象とし、以下の手順及び方法により行いました。\n※\n\n同一の事業が複数の施策に該当する場合、重複して掲載している\nため、各施策の事業数を合計すると３６７事業となります。分野ご\nとのカウントに寄らず、重複を除外すると２９８事業です。\n\n1\n\n\n（１）事業の達成度評価\nまず、事業ごとに設定している「目標指標」別に計画目標に対する達\n成率を算出し、評価を実施しました。\n達成率に基づく目標指標別の評価で、１１０％以上を達成した場合\n「Ａ 目標を上回って達成」、９０％以上１１０％未満を達成した場合\n「Ｂ 目標をおおむね達成」、９０％未満しか達成できなかった場合「Ｃ\n目標を未達成」とする３区分としました。\n表１\n\n目標指標別の評価区分\n評価\n\n達成率\n\nＡ\n\n目標を上回って達成\n\n１１０％以上\n\nＢ\n\n目標をおおむね達成\n\n９０％以上１","status":"available","textSha256":"b1ff53ba0a7d2f62a4e6939d741cef791c1576b7e1a841dda9d916cf2b844e2a","truncated":true},"title":"令和5年度さいたま市総合振興計画基本計画の実施状況報告書","titleBasis":"inventory_title","url":"https://www.city.saitama.lg.jp/006/007/004/011/006/001/001/p116476_d/fil/R5_houkokusyo.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"verified","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T09:09:55.825Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"d044b570145acecd180e9d7d30d099e6b032045bc52d126839da35e534c6c285","state":"acquired"},"evaluationType":"policy_evaluation","format":"html","id":"0cc4c18ddb738708f3eeed13","navigationReview":{"checkedAt":"2026-10-21T06:00:00Z","evidenceUrl":"https://www.city.saitama.lg.jp/006/007/004/011/006/001/001/index.html","method":"official_body_review","notes":"施策・事業ごとの目標達成度の内部評価（事業単位の達成評価を含む）。","originEvidenceUrl":null,"publisher":"さいたま市","rawArchiveState":"collected","yearNotes":"令和4年度の実施状況"},"role":"evaluation_landing_page","text":{"assetBytes":5913,"assetPath":"documents/0cc4c18ddb738708f3eeed13.json","assetSha256":"92461673f3ad2b269e857032bf734e2c4221f77562b84acb141da4698311f02a","characters":1868,"exportedCharacters":1868,"extractionMethod":"visible_html_from_verified_bytes","inputTextSha256":"d044b570145acecd180e9d7d30d099e6b032045bc52d126839da35e534c6c285","label":"unstructured_source_text","preview":"さいたま市／さいたま市／総合振興計画基本計画の令和4年度の実施状況について\nページの本文です。\n一つ前に見ていたページに戻る\n更新日付：2023年12月18日 / ページ番号：C098925\nさいたま市／総合振興計画基本計画の令和4年度の実施状況について\nこのページを印刷する\n総合振興計画基本計画の令和4年度の実施状況について\n本市では、総合的・計画的な行政運営を図るため、基本計画（政策・施策をわかりやすく体系化した指針）、実施計画（政策及び施策を実現するための個別の事務事業のうち主なものを定める計画）の2層からなる総合振興計画を定めています。\n総合振興計画の各施策・事業については、社会経済情勢や市民ニーズの変化に的確に対応するため、ＰＤＣＡサイクルに基づく進行管理を行い、各事業の継続的な改善・見直しを図りながら将来都市像の実現を目指し、推進しているところです。\nこの度、令和4年度の施策の進捗状況及び事業の取組内容の点検結果を取りまとめましたので、お知らせします。\n評価の対象及び方法\n令和4年度実績に基づく内部評価は、「さいたま市総合振興計画基本計画」第3部及び第5部に掲載している全62施策、「さいたま市総合振興計画基本計画実施計画」第4編に掲載している全369事業を対象としました。\n事業評価の区分は、以下の3区分です。\n※ 新型コロナウイルス感染症（以下、「感染症」という。）の影響により、目標が未達成になった場合は、「C コロナ影響有」と表記し\nました。また、感染症の影響により、目標指標の実績値を捕捉できず、達成率の算出ができなかった場合は、「－ コロナ影響有」と表\n記としました。\n施策評価の区分は、以下の4区分です。\n令和4年度実施状況に対する評価\n（1）事業評価\n再掲事業を含む369事業のうち、質の高い都市経営の実現の54事業を除く、各分野の315事業について達成率を評価したところ、87事業が「目標を上回って達成」、189事業が「目標をおおむね達成」、37事業が「目標を未達成」となりました。\n「目標を上回って達成」と「目標をおおむね達成」を合わせた事業は276事業となり、割合としては88．2％となりました。なお、うち24事業が感染症の影響により「目標を未達成」となっています。\n令和4年度 事業の達成状況（分野別）\n質の高い都市経営の実現の54事業について達成率","status":"available","textSha256":"5e344f57fab6c870278d8726297aa8df6bb34610bfced50fbeca881e2be9c3bd","truncated":false},"title":"総合振興計画基本計画の令和4年度の実施状況について","titleBasis":"inventory_title","url":"https://www.city.saitama.lg.jp/006/007/004/011/006/001/001/p098925.html","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"verified","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetche