s":322418,"assetPath":"documents/5e4c2d909efceb5468981bc6-6.json","assetSha256":"6d05d995d280d2938058512d162686d9f4f5b1e7c0596b929c80c706feba8511","exportedCharacters":120000,"part":6,"startCharacter":600000,"textSha256":"ba4053f42c39dcf223d8f295d506ca2b622f40bed433e27bee5c67c540e727b1"},{"assetBytes":319619,"assetPath":"documents/5e4c2d909efceb5468981bc6-7.json","assetSha256":"aa62fa46a5dfa856e7b49bbd045329e3beca5d5922cb2185c157d30b93c4791d","exportedCharacters":120000,"part":7,"startCharacter":720000,"textSha256":"813bb67f9fb914e2bf892da7b261c3eafa212e02044665cb1247fa12e41d57ad"},{"assetBytes":320991,"assetPath":"documents/5e4c2d909efceb5468981bc6-8.json","assetSha256":"86d0e719c2c51e3b20e1641f5f0a42fecc430749b9695c0f5c7df1bca15108e0","exportedCharacters":120000,"part":8,"startCharacter":840000,"textSha256":"e5d46fa80805ebfaa9429bacee21a7d9c899199ebf9ad80ca8d4aca986c12fe9"},{"assetBytes":319656,"assetPath":"documents/5e4c2d909efceb5468981bc6-9.json","assetSha256":"32c44b3a35ee1fd16a83a879c7b78b84dd31f4a4c271bc8e17fec032e9f37333","exportedCharacters":120000,"part":9,"startCharacter":960000,"textSha256":"c53b0bcf52f85c2ca69bdb35035c8353109bf585fcd747cbf8c10f163255d30e"},{"assetBytes":163141,"assetPath":"documents/5e4c2d909efceb5468981bc6-10.json","assetSha256":"1394d52f150a8ea45006945c6d36e0288253702ddfbb8b63a8c1e6d9dedd8adc","exportedCharacters":61685,"part":10,"startCharacter":1080000,"textSha256":"6ad4e6397acb53138d8dc7b48f35501be5571c6ea219cb90e7f73b14ddaf6162"}],"exportedCharacters":120000,"extractionMethod":"pdftotext_from_verified_bytes","fullTextSha256":"c3cf511a8104814fe789501b2576620b2d695e811469d13ae6cec37189f7606d","inputTextSha256":"e17919c87db17ae7385718525e0f990750e07c34cf09e20622d419c06c8974ed","label":"unstructured_source_text","preview":"さいたま市総合振興計画\n基本計画の実施状況報告書\n\n令和７年９月\n\nさいたま市\n\n\n\n目\n\n次\n\n１\n\nはじめに\n\n１\n\n２\n\n評価の対象及び方法\n\n１\n\n３\n\n評価結果の概要\n\n２\n\n４\n\n「評価シート」の見方\n\n21\n\n５\n\n施策の進捗及び事業の達成状況\n\n（１）施策の進捗及び事業の達成状況一覧\n\n29\n\n（２）評価シート\n\n47\n\n６\n\n重点戦略（まち・ひと・しごと創生総合戦略）\nの進捗状況\n\n772\n\n\n\n１\n\nはじめに\n\n本市では、総合的・計画的な行政運営を図るため、「さいたま市総合\n振興計画基本計画」（政策及び施策全体を体系化した計画。以下「基本\n計画」という。）及び「さいたま市総合振興計画基本計画実施計画」\n（各\n政策及び施策を実現するために実施する個別の事業のうち主なものを\n定めた計画。以下「実施計画」という。）の２層からなる総合振興計画を\n定めています。\n総合振興計画については、社会経済情勢や市民ニーズの変化に的確に\n対応するため、年度ごとにＰＤＣＡサイクルの考え方に基づく進行管理\nを実施しており、その中で、個別の事業についても、各政策及び施策の\n趣旨・目的に照らし、必要な見直しを行いながら、将来都市像の実現に\n向けて取り組んでいるところです。\nこの度、令和６年度における施策の進捗状況及び事業の取組内容の評\n価結果を取りまとめましたので、本書のとおり報告します。\n総合振興計画の構造図\n\n政策及び施策をわかりやすく\n体系化した指針\n\n具体化\n\n基本計画\n\n政策及び施策を実現するための\n個別の事務事業のうち主なもの\n\n２\n\n実施計画\n\n評価の対象及び方法\n\n令和６年度実績に対する内部評価は、基本計画第３部及び第５部に掲\n載している全６３施策、実施計画第４編に掲載している全３７０事業\n（※）を対象とし、以下の手順及び方法により行いました。\n※\n\nある一つの事業について、複数の施策を実現するためのものと位\n置付けられている場合、該当する全ての施策に関連してそれぞれ掲\n載しており、これらの延べ事業数は３７０事業となります。なお、\n重複を排除した実事業数は２９９事業となります。\n\n1\n\n\n（１）事業の達成度評価\nまず、各事業に設定している個別の「目標指標」ごとに、令和６年度\nの目標値に対する実績値の割合（達成率）を算出し、その数値を表１の\n３区分に照らして評価","status":"available","textSha256":"a9db80f90a004228a534b06c8ac9c4260f7850ba62b77f6a547577d03dd3a570","truncated":true},"title":"さいたま市総合振興計画基本計画の実施状況報告書","titleBasis":"inventory_title","url":"https://www.city.saitama.lg.jp/006/007/004/011/006/001/001/p123882_d/fil/R6_houkokusyo.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"verified","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T09:09:51.493Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"4de27cfe75a4233a23ca6fcb7d74f35c6f5a9f2ff96589d689b35fa5e2dee0e3","state":"acquired"},"evaluationType":"policy_evaluation","format":"html","id":"b06117e85f46381ee80570f2","navigationReview":{"checkedAt":"2026-10-21T06:00:00Z","evidenceUrl":"https://www.city.saitama.lg.jp/006/007/004/011/006/001/001/index.html","method":"official_body_review","notes":"施策・事業ごとの目標達成度の内部評価（事業単位の達成評価を含む）。","originEvidenceUrl":null,"publisher":"さいたま市","rawArchiveState":"collected","yearNotes":"令和5年度の実施状況"},"role":"evaluation_landing_page","text":{"assetBytes":5262,"assetPath":"documents/b06117e85f46381ee80570f2.json","assetSha256":"3b1ff9eabada98fe169b95efb2e46fcd200e3bf3813cf463e21974b0cc818d52","characters":1646,"exportedCharacters":1646,"extractionMethod":"visible_html_from_verified_bytes","inputTextSha256":"4de27cfe75a4233a23ca6fcb7d74f35c6f5a9f2ff96589d689b35fa5e2dee0e3","label":"unstructured_source_text","preview":"さいたま市／さいたま市／総合振興計画基本計画の令和5年度の実施状況について\nページの本文です。\n一つ前に見ていたページに戻る\n更新日付：2024年8月29日 / ページ番号：C116476\nさいたま市／総合振興計画基本計画の令和5年度の実施状況について\nこのページを印刷する\n総合振興計画基本計画の令和5年度の実施状況について\n本市では、総合的・計画的な行政運営を図るため、基本計画（政策・施策をわかりやすく体系化した指針）、実施計画（政策及び施策を実現するための個別の事務事業のうち主なものを定める計画）の2層からなる総合振興計画を定めています。\n総合振興計画の各施策・事業については、社会経済情勢や市民ニーズの変化に的確に対応するため、ＰＤＣＡサイクルに基づく進行管理を行い、各事業の継続的な改善・見直しを図りながら将来都市像の実現を目指し、推進しているところです。\nこの度、令和5年度の施策の進捗状況及び事業の取組内容の点検結果を取りまとめましたので、お知らせします。\n評価の対象及び方法\n令和5年度実績に基づく内部評価は、「さいたま市総合振興計画基本計画」第3部及び第5部に掲載している全62施策、「さいたま市総合振興計画基本計画実施計画」第4編に掲載している全367事業を対象としました。\n事業評価の区分は、以下の3区分です。\n施策評価の区分は、以下の4区分です。\n令和5年度実施状況に対する評価\n（1）事業評価\n再掲事業を含む367事業のうち、質の高い都市経営の実現の54事業を除く、各分野の313事業について達成率を評価したところ、85事業が「目標を上回って達成」、182事業が「目標をおおむね達成」、46事業が「目標を未達成」となりました。\n「目標を上回って達成」と「目標をおおむね達成」を合わせた事業は267事業となり、割合としては85.3％となりました。\n令和5年度 事業の達成状況（分野別）\n質の高い都市経営の実現の54事業について達成率を評価したところ、20事業が「目標を上回って達成」、31事業が「目標をおおむね達成」、3事業が「目標を未達成」となりました。\n「目標を上回って達成」と「目標をおおむね達成」を合わせた事業は51事業となり、割合としては94.4％となりました。\n令和5年度 事業の達成状況（質の高い都市経営の実現）\n（2）施策評価\n全62施策のうち、質の高い都","status":"available","textSha256":"9028c587d86a15496e11327b5a046458aee7179ace8cefac421975a85209f15c","truncated":false},"title":"総合振興計画基本計画の令和5年度の実施状況について","titleBasis":"inventory_title","url":"https://www.city.saitama.lg.jp/006/007/004/011/006/001/001/p116476.html","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"verified","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T09:09:54.223Z","httpStatu