2d4689fe6a4ad07a0b6fd316-6.json","assetSha256":"90437d2bd1682542241df2256d7bdf5efb62608253573cb6e9ce388f66cb9f18","exportedCharacters":120000,"part":6,"startCharacter":600000,"textSha256":"107185a3187774db254bcd75310599ee478a2d4189eac0480657800ce2775395"},{"assetBytes":315266,"assetPath":"documents/2d4689fe6a4ad07a0b6fd316-7.json","assetSha256":"5f9814e54f511912eb1bf7656005f2167993ccc863ff0aa799e5dab57e48f1b1","exportedCharacters":120000,"part":7,"startCharacter":720000,"textSha256":"d0f7e5daa54079131d6b76cdd2ade25fbadf5aa73e47e19b44f4093d3fabb7d8"},{"assetBytes":316761,"assetPath":"documents/2d4689fe6a4ad07a0b6fd316-8.json","assetSha256":"82fd3e0c5f63212f43f1fada4ef8fbba0233506fc6155bc19195f2241fa1ec34","exportedCharacters":120000,"part":8,"startCharacter":840000,"textSha256":"63335949bd8cc6f61bd076a1c3517c6466061d8a46fc30536eb73e7b1f09dc64"},{"assetBytes":315647,"assetPath":"documents/2d4689fe6a4ad07a0b6fd316-9.json","assetSha256":"ba7e65890da50118a41f004394e5734d176256919c33baf8b577d428739b76be","exportedCharacters":120000,"part":9,"startCharacter":960000,"textSha256":"fc1fa3b2cdff70ec286bc2d84a20962e22541892650f788f5a278cba01825730"},{"assetBytes":153696,"assetPath":"documents/2d4689fe6a4ad07a0b6fd316-10.json","assetSha256":"e1dd6e3921b89a00a003f8ce99257a02749c5c0c4620a972c6ee696dd34dac33","exportedCharacters":58733,"part":10,"startCharacter":1080000,"textSha256":"d0c20cd5c589801b997ee5e8dc057ab807a88b1e26cfef3743423bf3c414036f"}],"exportedCharacters":120000,"extractionMethod":"pdftotext_from_verified_bytes","fullTextSha256":"98e4e71163362828cde12912219184dec7f2f6ebe094e91c20a54d467e550bb4","inputTextSha256":"8d6be3178e59a64c08251fca1920423bbb266da58c5e2b14d2189742fe6902a4","label":"unstructured_source_text","preview":"さいたま市総合振興計画\n基本計画の実施状況報告書\n\n令和８年９月\n\nさいたま市\n\n\n\n目\n\n次\n\n１\n\nはじめに\n\n１\n\n２\n\n評価の対象及び方法\n\n１\n\n３\n\n評価結果の概要\n\n３\n\n４\n\n「評価シート」の見方\n\n23\n\n５\n\n施策及び事業の達成状況\n\n（１）施策及び事業の達成状況一覧\n\n31\n\n（２）評価シート\n\n47\n\n６\n\n重点戦略（まち・ひと・しごと創生総合戦略）\nの達成状況\n\n774\n\n\n\n１\n\nはじめに\n\n本市では、総合的・計画的な行政運営を図るため、「さいたま市総合\n振興計画基本計画」（政策及び施策全体を体系化した計画。以下「基本\n計画」という。）及び「さいたま市総合振興計画基本計画実施計画」\n（各\n政策及び施策を実現するために実施する個別の事業のうち主なものを\n定めた計画。以下「実施計画」という。）の２層からなる総合振興計画を\n定めています。\n総合振興計画については、社会経済情勢や市民ニーズの変化に的確に\n対応するため、年度ごとにＰＤＣＡサイクルの考え方に基づく進行管理\nを実施しており、その中で、個別の事業についても、各政策及び施策の\n趣旨・目的に照らし、必要な見直しを行いながら、将来都市像の実現に\n向けて取り組んでいるところです。\nこの度、令和７年度における事業の取組内容の評価結果及び事業の計\n画期間５年間（令和３年度～令和７年度）の評価結果並びに施策の中間\n目標に対する達成状況を取りまとめましたので、本書のとおり報告しま\nす。\n総合振興計画の構造図\n\n政策及び施策をわかりやすく\n体系化した指針\n\n具体化\n\n基本計画\n\n政策及び施策を実現するための\n個別の事務事業のうち主なもの\n\n２\n\n実施計画\n\n評価の対象及び方法\n\n令和７年度実績及び計画期間５年間の実績に基づく内部評価は、基本\n計画第３部及び第５部に掲載している全６３施策、実施計画第４編に掲\n載している全３７２事業（※）を対象とし、以下の手順及び方法により\n行いました。\n※\n\nある一つの事業について、複数の施策を実現するためのものと位\n\n1\n\n\n置付けられている場合、該当する全ての施策に関連してそれぞれ掲\n載しており、これらの延べ事業数は３７２事業となります。なお、\n重複を排除した実事業数は３００事業となります。\n※ 令和７年度実績に基づく内部評価対象は全３７０事業（実事業数\nは２９９事業）","status":"available","textSha256":"8d91dd7bd38d583cc0b191a92d57a1265a16df67fb05d2b1707996e9adde789a","truncated":true},"title":"さいたま市総合振興計画基本計画の実施状況報告書","titleBasis":"inventory_title","url":"https://www.city.saitama.lg.jp/006/007/004/011/006/001/001/p133436_d/fil/R7_houkokusyo.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"verified","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T09:09:46.636Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"e9e7811fba50515ed77fd8ba32a6c5ac2228b1d905b5ecddfc102926df6bf72e","state":"acquired"},"evaluationType":"policy_evaluation","format":"html","id":"55ccd4cb1cdb44e5c5dbfb7c","navigationReview":{"checkedAt":"2026-10-21T06:00:00Z","evidenceUrl":"https://www.city.saitama.lg.jp/006/007/004/011/006/001/001/index.html","method":"official_body_review","notes":"施策・事業ごとの目標達成度の内部評価（事業単位の達成評価を含む）。","originEvidenceUrl":null,"publisher":"さいたま市","rawArchiveState":"collected","yearNotes":"令和6年度の実施状況"},"role":"evaluation_landing_page","text":{"assetBytes":5327,"assetPath":"documents/55ccd4cb1cdb44e5c5dbfb7c.json","assetSha256":"39bc7ad7ea67b59bcde2fb7f9d7e7724a1ee9379b42125fd1d576b2314706561","characters":1679,"exportedCharacters":1679,"extractionMethod":"visible_html_from_verified_bytes","inputTextSha256":"e9e7811fba50515ed77fd8ba32a6c5ac2228b1d905b5ecddfc102926df6bf72e","label":"unstructured_source_text","preview":"さいたま市／さいたま市／総合振興計画基本計画の令和6年度の実施状況について\nページの本文です。\n一つ前に見ていたページに戻る\n更新日付：2025年8月28日 / ページ番号：C123882\nさいたま市／総合振興計画基本計画の令和6年度の実施状況について\nこのページを印刷する\n総合振興計画基本計画の令和6年度の実施状況について\n本市では、総合的・計画的な行政運営を図るため、「さいたま市総合振興計画基本計画」（政策及び施策全体を体系化した計画。以下「基本計画」という。）及び「さいたま市総合振興計画基本計画実施計画」（各政策及び施策を実現するために実施する個別の事業のうち主なものを定めた計画。以下「実施計画」という。）の2層からなる総合振興計画を定めています。\n総合振興計画については、社会経済情勢や市民ニーズの変化に的確に対応するため、年度ごとにＰＤＣＡサイクルの考え方に基づく進行管理を実施しており、その中で、個別の事業についても、各政策及び施策の趣旨・目的に照らし、必要な見直しを行いながら、将来都市像の実現に向けて取り組んでいるところです。\nこの度、令和6年度における施策の進捗状況及び事業の取組内容の評価結果を取りまとめましたので、お知らせいたします。\n評価の対象及び方法\n令和6年度実績に対する内部評価は、基本計画第3部及び第5部に掲載している全63施策、実施計画第4編に掲載している全370事業を対象としました。\n事業評価の区分は、以下の3区分です。\n施策評価の区分は、以下の4区分です。\n令和6年度実施状況に対する評価\n（1）事業評価\n全370事業のうち、実施計画第4編Ⅱ「質の高い都市経営の実現」に掲載している54事業を除く316事業について達成度を評価したところ、82事業がA、185事業がB、49事業がCの評価となりました。Ａ又はＢの評価を得た事業数は計267事業となり、割合は84.5％となりました。\n令和6年度 事業の達成状況（分野別）\nまた、「質の高い都市経営の実現」に掲載している54事業について達成度を評価したところ、17事業がＡ、27事業がＢ、10事業がＣの評価となりました。Ａ又はＢの評価を得た事業数は計44事業となり、割合は81.5％となりました。\n令和6年度 事業の達成状況（質の高い都市経営の実現）\n（2）施策評価\n全63施策のうち、実施計画第4編Ⅱ「質の","status":"available","textSha256":"b1747f2aad105e37582c288c1c08a30548ba0b3f01cd266a0f3e7fae526a4494","truncated":false},"title":"総合振興計画基本計画の令和6年度の実施状況について","titleBasis":"inventory_title","url":"https://www.city.saitama.lg.jp/006/007/004/011/006/001/001/p123882.html","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"verified","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T09:09:49.485Z","httpStatus":200,"inputStatus":"fetched","me