ssetSha256":"207e77726dda7a2bffe7f530c79286749830b28f95b40090611a98facf828e74","characters":492,"exportedCharacters":492,"extractionMethod":"visible_html_from_verified_bytes","inputTextSha256":"7070d505afc782da45653390428eb73f0e79398d61905eb772cd06f6c8af9350","label":"unstructured_source_text","preview":"さいたま市／令和3年度～令和7年度\nページの本文です。\n一つ前に見ていたページに戻る\nページ番号：J005903\n令和3年度～令和7年度\nさいたま市／総合振興計画基本計画の令和7年度の実施状況及び計画期間5年間の実施状況について\n「さいたま市総合振興計画基本計画」の令和7年度の実施状況及び計画期間5年間の実施状況を取りまとめました。\nさいたま市／総合振興計画基本計画の令和6年度の実施状況について\n「さいたま市総合振興計画基本計画」の令和6年度の実施状況を取りまとめました。\nさいたま市／総合振興計画基本計画の令和5年度の実施状況について\n「さいたま市総合振興計画基本計画」の令和5年度の実施状況を取りまとめました。\nさいたま市／総合振興計画基本計画の令和4年度の実施状況について\n「さいたま市総合振興計画基本計画」の令和4年度の実施状況を取りまとめました。\nさいたま市／総合振興計画基本計画の令和3年度の実施状況について\n「さいたま市総合振興計画基本計画」の令和3年度の実施状況を取りまとめました。\n平成26年度～令和2年度\n平成21年度～平成25年度\n平成16年度～平成20年度","status":"available","textSha256":"3943a4ebecf513180651da82659d9489ef36a7fd6d46b815fd2a956a03e858b1","truncated":false},"title":"令和3年度～令和7年度","titleBasis":"inventory_title","url":"https://www.city.saitama.lg.jp/006/007/004/011/006/001/001/index.html","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"verified","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T09:09:42.017Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"42f52c0b2dc4a43384959b2ba7f0596ed1c3afe10df57e6d2b05fb5898626997","state":"acquired"},"evaluationType":"policy_evaluation","format":"html","id":"cf1838828d60749c43c236f9","navigationReview":{"checkedAt":"2026-10-21T06:00:00Z","evidenceUrl":"https://www.city.saitama.lg.jp/006/007/004/011/006/001/001/index.html","method":"official_body_review","notes":"施策・事業ごとの目標達成度の内部評価（事業単位の達成評価を含む）。","originEvidenceUrl":null,"publisher":"さいたま市","rawArchiveState":"collected","yearNotes":"令和7年度の実施状況及び計画期間5年間（370事業を評価と本文に記載）"},"role":"evaluation_landing_page","text":{"assetBytes":6726,"assetPath":"documents/cf1838828d60749c43c236f9.json","assetSha256":"ce6191214160f86a20d18c251893a31e996bf128aef753d9814f793698f82942","characters":2190,"exportedCharacters":2190,"extractionMethod":"visible_html_from_verified_bytes","inputTextSha256":"42f52c0b2dc4a43384959b2ba7f0596ed1c3afe10df57e6d2b05fb5898626997","label":"unstructured_source_text","preview":"さいたま市／さいたま市／総合振興計画基本計画の令和7年度の実施状況及び計画期間5年間の実施状況について\nページの本文です。\n一つ前に見ていたページに戻る\n更新日付：2026年8月27日 / ページ番号：C133436\nさいたま市／総合振興計画基本計画の令和7年度の実施状況及び計画期間5年間の実施状況について\nこのページを印刷する\n総合振興計画基本計画の令和7年度の実施状況及び計画期間5年間の実施状況について\n本市では、総合的・計画的な行政運営を図るため、「さいたま市総合振興計画基本計画」（政策及び施策全体を体系化した計画。以下「基本計画」という。）及び「さいたま市総合振興計画基本計画実施計画」（各政策及び施策を実現するために実施する個別の事業のうち主なものを定めた計画。以下「実施計画」という。）の2層からなる総合振興計画を定めています。\n総合振興計画については、社会経済情勢や市民ニーズの変化に的確に対応するため、年度ごとにＰＤＣＡサイクルの考え方に基づく進行管理を実施しており、その中で、個別の事業についても、各政策及び施策の趣旨・目的に照らし、必要な見直しを行いながら、将来都市像の実現に向けて取り組んでいるところです。\nこの度、令和7年度における事業の取組内容の評価結果及び事業の計画期間5年間（令和3年度～令和7年度）の評価結果並びに施策の中間目標に対する達成状況を取りまとめましたので、お知らせいたします。\n評価の対象及び方法\n令和7年度実績及び計画期間5年間の実績に基づく内部評価は、基本計画第3部及び第5部に掲載している全63施策、実施計画第4編に掲載している全372事業（※）を対象としました。\n※令和7年度実績に基づく評価対象は全370事業\n事業評価の区分は、以下の3区分です。\n施策評価の区分は、以下の3区分です。\n令和7年度実施状況に対する評価\n（1）令和7年度事業評価\n全370事業のうち、実施計画第4編Ⅱ「質の高い都市経営の実現」に掲載している54事業を除く316事業について達成度を評価したところ、92事業がA、170事業がB、54事業がCの評価となりました。Ａ又はＢの評価を得た事業数は計262事業となり、割合は82.9％となりました。\n令和7年度 事業の達成状況（分野別）\nまた、「質の高い都市経営の実現」に掲載している54事業について達成度を評価したところ","status":"available","textSha256":"310238bfae4646ea332bd03eae357a70999b5333dcfcb58028b8143fdc475d31","truncated":false},"title":"総合振興計画基本計画の令和7年度の実施状況について","titleBasis":"inventory_title","url":"https://www.city.saitama.lg.jp/006/007/004/011/006/001/001/p133436.html","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"verified","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T09:09:44.898Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sour