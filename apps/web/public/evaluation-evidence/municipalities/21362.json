6%99%82%E4%BA%A4%E4%BB%98%E9%87%91%EF%BC%88%E5%AE%9F%E6%96%BD%E7%8A%B6%E6%B3%81%E5%8F%8A%E3%81%B3%E5%8A%B9%E6%9E%9C%E6%A4%9C%E8%A8%BC%EF%BC%89.pdf","method":"official_body_review","notes":"子育て世帯応援給付金は決算16,467,457円、821人へ16,420,000円給付し事務費47,457円。所管課評価と対象者意見を掲載。 not_established_beyond_title_and_brief_evidence 確認範囲：Supported Web extracted text sampled; no locally archived full text.","originEvidenceUrl":"https://www.town.sekigahara.gifu.jp/4691.htm","publisher":"関ケ原町","rawArchiveState":"collected","yearNotes":"2020。FY2020 settled expenditures and implementation outcomes."},"role":"evaluation_document","text":{"assetBytes":61074,"assetPath":"documents/43fd1f660411525aee46b521.json","assetSha256":"c5a6c5d6f14aeb8cc9889bac5e49a7a310d5b9882682740dca1eb057ee9de4d2","characters":23785,"exportedCharacters":23785,"extractionMethod":"pdftotext_from_verified_bytes","inputTextSha256":"b96b86417c0e8e3010f92bff4cba4ba09f6c3801557d232d7c2761afaa22705e","label":"unstructured_source_text","preview":"令和2年度 新型コロナウイルス感染症対応地方創生臨時交付金（実施状況及び効果検証）\n補\n\n事業の概要\n\n助\nNo\n\n事業名\n\n･\n\n（所管課）\n\n単\n\n単\n\n②交付金を充当する経費内容\n③積算根拠（対象数、単価等）\n\n事業\n\n事業\n\n始期\n\n終期\n\nR2.8\n\nR3.3\n\n令和2年度\n\n交付金\n\n決算額\n\n充当額\n\n（円）\n\n（円）\n\n単\n\n【所管課評価】\n【対象者等からの評価】\n\n水道事業会計補助事業\n\n①在宅勤務・外出自粛に伴う在宅時間の長期化による水\n\n【水道環境課】\n\n道使用量の増加、事業所の休業等により生じる経済的負\n\n33,815,970\n\n8月分\n\n4,217,660円（2,938件）\n\n新型コロナウイルス感染症による町民\n\n担を軽減するため\n\n9月分\n\n4,230,750円（2,935件）\n\nの経済的な影響の経済的負担の軽減につ\n\n②水道事業会計に補助し、水道料金（基本料金）の免除\n\n10月分 4,214,850円（2,933件）\n\nに要する経費（水道料金の基本料金の免除に伴う減収補\n\n11月分 4,215,730円（2,934件）\n\n填）に充当\n\n12月分 4,217,490円（2,935件）\n\n【対象者等からの評価】\n\n③4,222,000円／月×5ヶ月分\n\n1月分\n\n4,233,390円（2,937件）\n\n・基本料金の免除により、家計の負担軽\n\n4,250,000円／月×3ヶ月分\n\n2月分\n\n4,241,730円（2,942件）\n\n減につながりよかった。\n\n3月分\n\n4,244,370円（2,944件）\n\n④関ケ原町水道事業会計\n2\n\n効果検証\n実施状況\n\n④事業の対象（交付対象者、対象施設等）\n\n独\n1\n\n①目的・効果\n\n新型コロナウイルス感染症拡大防止協力 ①新型コロナウイルス感染症拡大防止のため\n\nR2.6\n\nR3.3\n\n7,683,304\n\n27,717,000 ・水道事業会計補助金\n\n【所管課評価】\n\nながった。\n\n7,365,000 ・新型コロナウイルス感染症拡大防止協 【所管課評価】\n\n金事業\n\n②県の要請や協力依頼に応じて、施設の使用停止や営業\n\n力金（第1弾）\n\n【地域振興課】\n\n時間の短縮に全面的に協力した事業者に対する岐阜県新\n\n45件分 7,383,304円\n\n新型コロナウィルス感染症拡大におい\nて県の要請により営業停止","status":"available","textSha256":"cb1879c318731dcc73ea640f1b73e13ebdd5ffca041b5ade9b915b52d130a64a","truncated":false},"title":"令和2年度新型コロナウイルス感染症対応地方創生臨時交付金 実施状況及び効果検証","titleBasis":"inventory_title","url":"https://www.town.sekigahara.gifu.jp/secure/6551/%E4%BB%A4%E5%92%8C2%E5%B9%B4%E5%BA%A6%E6%96%B0%E5%9E%8B%E3%82%B3%E3%83%AD%E3%83%8A%E3%82%A6%E3%82%A4%E3%83%AB%E3%82%B9%E6%84%9F%E6%9F%93%E7%97%87%E5%AF%BE%E5%BF%9C%E5%9C%B0%E6%96%B9%E5%89%B5%E7%94%9F%E8%87%A8%E6%99%82%E4%BA%A4%E4%BB%98%E9%87%91%EF%BC%88%E5%AE%9F%E6%96%BD%E7%8A%B6%E6%B3%81%E5%8F%8A%E3%81%B3%E5%8A%B9%E6%9E%9C%E6%A4%9C%E8%A8%BC%EF%BC%89.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"verified","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]}]}
