1247a0fbddb1efbce500c298fb01b4ca33","truncated":false},"title":"行政評価｜富士見市","titleBasis":"html_title","url":"https://www.city.fujimi.saitama.jp/shisei/04gyouseizaisei/seisaku.html","verification":{"basis":["directory_host_unique_to_municipality"],"evaluationRelevance":"verified","evidenceSha256":"840e81f80256c408ff1a62be6c0d23ac67e9749df78e5f799526b9bcee0d4052","evidenceSourceId":"270dbe253c7e91fe7ba14cb7","status":"verified"},"years":[{"basis":"printed_text","calendarYear":2026,"label":"2026年","meaning":"calendar_year_mentioned","quote":"行政評価｜富士見市 行政評価 最終更新日：2026年5月18日 行政評価について 行政評価とは 行政評価とは、第6次基本構想・第1期基本計画、第2期キラリと輝く創"},{"basis":"printed_text","calendarYear":2025,"label":"令和7年度","meaning":"fiscal_year_mentioned","quote":"証の方法 基本施策に紐づく各取組を3段階で評価します。（令和7年度は最終年度評価であることから、目標値の達成に関する結果も踏まえて評価します。） 取組の評価区分 評価区分 定義"},{"basis":"printed_text","calendarYear":2025,"label":"令和7年度","meaning":"evaluation_year","quote":"会 3月中旬 所管課へのフィードバック 4月 評価結果 令和7年度行政評価結果 計画名 評価結果 合計 1 2 3 4 5 第6次基本構想・第1期基本計画 2 5 59 36"}]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":403,"inputStatus":"blocked","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"blocked"},"evaluationType":"unknown","format":"pdf","id":"ad66fb722e972c2918f63125","role":"supporting_document","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":null,"label":"unstructured_source_text","preview":null,"status":"not_acquired","textSha256":null,"truncated":false},"title":"令和7年度行政評価の総括について（PDF：760KB）","titleBasis":"official_link_label","url":"https://www.city.fujimi.saitama.jp/shisei/04gyouseizaisei/seisaku.files/R7_gyoseihyoukasoukatu.pdf","verification":{"basis":["literal_link_in_verified_official_page","same_municipality_official_host"],"evaluationRelevance":"verified","evidenceSha256":"840e81f80256c408ff1a62be6c0d23ac67e9749df78e5f799526b9bcee0d4052","evidenceSourceId":"270dbe253c7e91fe7ba14