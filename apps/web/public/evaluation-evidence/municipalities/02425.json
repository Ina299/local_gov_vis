みたい\nと思います。","status":"available","textSha256":"d659b4c34f5ab55c8c79e4cca2a890d6175fb43ea52e61ea0117ae931e8c9e63","truncated":false},"title":"令和６年度に本事業で重点的に取り組む課題に対する事業評価","titleBasis":"inventory_title","url":"https://www.kazamaura.jp/cms/wp-content/uploads/2025/03/c7696efb01f8a406298cd92b48ebe69d-1.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"verified","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]}]}
