status":"available","textSha256":"bb29e28991a7bf7ae1c2ac86a673ff1dc4cab6d9169aa6edf4b606b1fa67bb4c","truncated":false},"title":"令和7年度部局別事務事業評価結果一覧（継続事業・補正新規事業）","titleBasis":"inventory_title","url":"https://www.city.omura.nagasaki.jp/kanri/shise/gyosekaikaku/gyosehyoka/kekka/r7/documents/c_r7zigyouitirann.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"verified","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T09:12:30.034Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"3c6b9366b1a54b604320e02dc01553d4cff26e18e577026c2f459cd158cb4686","state":"acquired"},"evaluationType":"business_project_evaluation","format":"pdf","id":"17ddb8cc000e56ec78aa66eb","navigationReview":{"checkedAt":"2026-10-21T08:52:34Z","evidenceUrl":"https://www.city.omura.nagasaki.jp/kanri/shise/gyosekaikaku/gyosehyoka/kekka/r7/hyokagaiyo.html","method":"official_body_review","notes":"概要","originEvidenceUrl":null,"publisher":"大村市","rawArchiveState":"collected","yearNotes":"令和7年度"},"role":"evaluation_document","text":{"assetBytes":7060,"assetPath":"documents/17ddb8cc000e56ec78aa66eb.json","assetSha256":"85949c70538863a7042d2c241fcdcbd9b1f69b15a61db2fbff09e4201fff212b","characters":2264,"exportedCharacters":2264,"extractionMethod":"pdftotext_from_verified_bytes","inputTextSha256":"3c6b9366b1a54b604320e02dc01553d4cff26e18e577026c2f459cd158cb4686","label":"unstructured_source_text","preview":"令和７年度\n\n行政評価結果の概要\n\n本市では実施する事業について、「妥当性」「有効性」「効率性」の視点を中心とした評価\nにより、今後の事業の方向性を検討し、新たな事業の実施や既存の事業の改善・改革を\n推進しています。\n令和７年度に実施した行政評価結果の概要は、以下のとおりです。\n【評価対象事業】\n・\n\n継続事業及び補正新規事業\n令和７年度当初予算として予算化した事業及び令和７年度補正予算として予算化\nした事業\n・ 新規事業\n令和８年度当初予算として新たに予算化し実施する予定の事業\n\n【令和７年度の評価事業数】\n\n※括弧内は、令和６年度の評価事業数\n\n569 事業（560 事業）\n・ 継続事業及び補正新規事業\n・ 新規事業\n【令和７年度の最終評価別事業数】\n\n565 事業（550 事業）\n4 事業（10 事業）\n\n※括弧内は、令和６年度の評価事業数\n\n・\n\n２次評価\n\n531 事業（525 事業）\n\n・\n\n評価調整委員会\n\n34 事業（25 事業）\n\n・\n\n都市経営戦略会議\n\n6 事業（5 事業）\n\n※\n\n２次評価は、各事業担当部長が行いました。\n\n※\n\n評価調整委員会では、次年度における事業の方向性が「新規」又は「拡充」の事業について、企画政策部長をはじ\nめとする委員により、事業内容を審査し、採択・不採択の評価を行いました。\n（参考）評価調整委員会委員…（会長）企画政策部長、（副会長）総務部長、財政部長、都市整備部長、\n総務課長、財政課長、人事課長\n\n※\n\n都市経営戦略会議では、市長へのプレゼン実施により提案され、令和８年度当初予算にて予算化しようとする\n\n事業の方向性が、「新規」又は「拡充」の事業について、市長をはじめとする委員により、事業内容を審査し、採択・\n不採択の評価を行いました。\n（参考）都市経営戦略会議委員…市長、副市長、大村市技監、企画政策部長、総務部長、財政部長、\n都市整備部長\n※\n\n市長へのプレゼン実施により提案された事業のみ、都市経営戦略会議において最終評価を行いました。\n\n\n令和７年度評価結果速報\n◇継続、見直し、終了事業等\n方向性\n\n事業数\n\n現状維持\n\n496\n\n拡充\n\n21\n\n縮小\n\n7\n\n終了\n\n8\n\n廃止\n\n3\n\n終期の設定\n\n2\n\nその他の見直し\n\n24\n\n他事業に統合\n\n4\n\n合計\n\n1.4%\n\n終了\n\n0.5% 廃止\n\n1.2%","status":"available","textSha256":"d2542cff9270382a483bf3138c262c4c1f758a25391a047b145bb70a2911a35d","truncated":false},"title":"令和7年度行政評価結果の概要","titleBasis":"inventory_title","url":"https://www.city.omura.nagasaki.jp/kanri/shise/gyosekaikaku/gyosehyoka/kekka/r7/documents/ab_r7hyoukanogaiyou.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"verified","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T09:12:31.739Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"9b8b211cc984934c48764b4661ca905ca4843b3a1f9f88adbab2d8e11f4c2062","state":"acquired"},"evaluationType":"business_project_evaluation","format":"pdf","id":"eb7c4963f89c3b5aab6c1089","navigationReview":{"checkedAt":"2026-10-21T08:52:34Z","evidenceUrl":"https://www.city.omura.nagasaki.jp/kanri/shise/gyosekaikaku/gyosehyoka/kekka/r7/jimujigyohyoka.html","method":"official_body_review","notes":"施策別事務事業評価一覧の例","originEvidenceUrl":null,"publisher":"大村市","rawArchiveState":"collected","yearNotes":"令和7年度"},"role":"evaluation_document","text":{"assetBytes":4613,"assetPath":"documents/eb7c4963f89c3b5aab6c1089.json","assetSha256":"4d17acb1ba199453a5a9cfbe7734a6afb5eba5c7b11ee978b7a20ec54d920ef6","characters":1501,"exportedCharacters":1501,"extractionMethod":"pdftotext_from_verified_bytes","inputTextSha256":"9b8b211cc984934c48764b4661ca905ca4843b3a1f9f88adbab2d8e11f4c2062","label":"unstructured_source_text","preview":"事務事業評価表\n施策名\n\n0101\n\n出会いと結婚の支援\n\n【事業類型】\n\n【事業概要シート作成有無】\n\n負担金のみの事業（イベント等の実行委員会への負担金を除く）\n\n4\n\n組織や職員を管理するための内部事務管理事務（財務事務、人事管理事務、企画事務、議会事務など）\n\n5\n\n施設の維持管理費のみの事業（光熱水費や法定の保守点検委託料など。施設の修繕料）\n\n6\n\n施設を維持管理するための運営業務（施設やそれに付随する車両等の運転業務委託、公園などの管理業務、清掃委託）\n\n7\n\n課内事務を行う上で必要となる事務的経費のみで構成される事業（条例委員の報酬、旅費、需要費、役務費のみで構成）\n\n8\n\n団体等への負担金及び補助金が予算の大半を占めるもの・・・補助金は、補助金要綱及び補助金等のあり方に関するガイドラインにおいて精査されている。\n\n9\n\nハード事業で、中長期の年度計画（事業費含む）を策定し認められた事業\n\n10\n\nハード事業1,000万円未満、ソフト事業100万未満（事業類型1～9以外）\n\n11\n\nハード事業1,000万円以上、ソフト事業100万円以上（事業類型1～9以外）\n\n＜総合評価＞\n\nａ…市が実施することが妥当である\n\nＡ…計画通りに事業を進めることが適当\n\nｂ…見直す余地がある\n\nＢ…事業の進め方の改善検討\n\nｃ…市が実施する緊急性が認められない\n\nＣ…事業規模・内容又は実施主体の見直しの検討\n\n有効性（施策貢献度）\n\nＹＥＳ\n\nＤ…事業の抜本的見直し、休・廃止の検討\n\nａ…施策への貢献度が高い\n\n【必 要 】\n\n3\n\nＮＯ\n\n事 業 概 要 シ ート\n\n国の法令に基づいて実施する事務（生活保護、賦課徴収事務、年金事務、戸籍・住基台帳事務、選挙事務、広域組合の負担金などの市の裁量が及ばない事務）\n\n妥当性（市の関与）\n\n【不 要 】\n\n2\n\n【事務事業評価の視点】\n事 業 概 要 シ ート\n\n職員人件費のみの事業\n\n新規・拡充・その他の見直し\n\n1\n\nｂ…施策への貢献度が著しく高いとはいえない\nｃ…成果の向上が見込まれない\n効率性（コスト）\nａ…コストを見直す余地がない\nｂ…検討する余地がある\n\n事業費は当初・繰越・補正予算の合計額\n担当課\nNO\n\n事業名\n\n課長\n\n事業内容\n\n事業期間\n\n事業費（千円）\n根拠法令\n要綱等\n\n事業\n類型\n\nＲ８\n\nＲ６\n\n","status":"available","textSha256":"58f749319a48831d2eecd029471231d689169edf6d49780b3a386952cd39fa8c","truncated":false},"title":"0101出会いと結婚の支援","titleBasis":"inventory_title","url":"https://www.city.omura.nagasaki.jp/kanri/shise/gyosekaikaku/gyosehyoka/kekka/r7/documents/0101r7zimuzigyouhyouka.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"verified","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T09:12:33.376Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"20d50ca980320f706a0b873afcf9fd3ff1a5090b6de7b81bd36b3d31bf973682","state":"acquired"},"evaluationType":"business_project_evaluation","format":"pdf","id":"f24d5a155386897bfca59990","navigationReview":{"checkedAt":"2026-10-21T08:52:34Z","evidenceUrl":"https://www.city.omura.nagasaki.jp/kanri/shise/gyosekaikaku/gyosehyoka/kekka/r7/jimujigyohyoka.html","method":"official_body_review","notes":"事業別シートの例","originEvidenceUrl":null,"publisher":"大村市","rawArchiveState":"collected","yearNotes":"令和7年度"},"role":"evaluation_document","text":{"assetBytes":5829,"assetPath":"documents/f24d5a155386897bfca59990.json","assetSha256":"7d15ee1ae5d6faecfe54df9afb16f849dd21d6fb58ccb4f27c3e723a876e948a","characters":2053,"exportedCharacters":2053,"extractionMethod":"pdftotext_from_verified_bytes","inputTextSha256":"20d50ca980320f706a0b873afcf9fd3ff1a5090b6de7b81bd36b3d31bf973682","label":"unstructured_source_text","preview":"事業概要シート\n≪≫の金額\n\n施策\n\n0101\n\n事業名\n\n根拠法令\n要綱等\n\n結婚応援事業\n平成30年\n\n～\n\n地域少子化対策重点推進交付金\n\n予算額\n\n現状維持\n\n財源内訳\n\n事業期間\n\n現年度当初・補正予算、前年度繰越額の合計\n※補正予算要求時は今回の補正予算額を除く\n※次年度予算要求時は次年度繰越額を除く\n\n出会いと結婚の支援\n\n≪\n\n国庫支出金\n県支出金\n地方債\nその他\n一般財源\n\n6,171 千円\n7,597 ≫千円\n千円\n4,208 千円\n千円\n千円\n1,963 千円\n\n【事業の目的・概要・対象】\n＜目的＞\n婚活サポートセンターにおいて、結婚を望む独身男女に婚活相談を行うほか、お見合いシステムや縁結び隊の活動、婚\n活イベントの開催等により、出会いの場を提供し結婚をサポートする。\n＜事業概要＞\n１ 県婚活サポートセンターが実施する相談員研修を受講した専任の職員を配置し、結婚に関する相談に対応する。\n２ お見合いシステムに登録した会員同士によるデータマッチング及び縁結び隊により会員同士を引き合わせる。\n３ 県が実施するサポーター養成講座の誘致に努めるとともに、出張養成講座を開催する。\n４ 民間の事業者ノウハウを活用した婚活支援事業を実施する。\n※サポーター\n・お見合いシステムサポーター：お見合いシステム登録者の引き合わせから成婚までをサポートする方。\n・縁結び隊サポーター：縁結び隊登録者の引き合わせから成婚までをサポートする方。\n\n大村市婚活サポートセンターの取り組みの全体像\n\n【背景】\n本市は、県内で唯一人口が増加している市であるが、大村市まち・ひと・しごと創生総合戦略に掲げた合計\n特殊出生率1.90を目指す取組の一つとして、大村市婚活サポートセンターにおいて、お見合いシステム及び縁\n結び隊の活動を中心に、独身男女の出会いから結婚までの支援を行っている。\n令和３年度10月から開始された、お見合いシステムの自宅閲覧機能により、引き合わせ申し込みが自宅で出\n来るようになったため、引き合わせ数及びカップル成立数等が増加している。更なる機運醸成のため、長崎県\n婚活サポートセンターが行うキャンペーン等のお見合いシステムの魅力的な箇所や取組を周知し、登録を推進\n及び会員の登録内容の改善を促し、マッチング率の向上を図り、上記目標の達成を目指す。\n担当課\n\nこども政策課","status":"available","textSha256":"5b91605b93652ae4ea6a00c4fa3a800637dbdee89ee9a38d50f89b1179924972","truncated":false},"title":"＜こども政策課＞結婚応援事業","titleBasis":"inventory_title","url":"https://www.city.omura.nagasaki.jp/kanri/shise/gyosekaikaku/gyosehyoka/kekka/r7/documents/0101-1r7gaiyousito.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"verified","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T09:12:34.978Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"82fc4ad540f6c114d117ac08fccb1b2966a378d149c4c891353b7c59db8c15fc","state":"acquired"},"evaluationType":"policy_evaluation","format":"html","id":"eddc02ade6e534add40056ec","navigationReview":{"checkedAt":"2026-10-21T08:52:34Z","evidenceUrl":"https://www.city.omura.nagasaki.jp/kanri/shise/gyosekaikaku/gyosehyoka/kekka/r7/gyoseihyokaichiran.html","method":"official_body_review","notes":"施策評価","originEvidenceUrl":null,"publisher":"大村市","rawArchiveState":"collected","yearNotes":"令和7年度"},"role":"supporting_document","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":"82fc4ad540f6c114d117ac08fccb1b2966a378d149c4c891353b7c59db8c15fc","label":"unstructured_source_text","preview":null,"status":"no_readable_text","textSha256":null,"truncated":false},"title":"施策評価表","titleBasis":"inventory_title","url":"https://www.city.omura.nagasaki.jp/kanri/shise/gyosekaikaku/gyosehyoka/kekka/r7/sesakuhyoka.html","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T09:12:36.637Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"mem