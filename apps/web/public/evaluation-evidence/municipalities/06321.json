,"url":"https://www.town.kahoku.yamagata.jp/material/files/group/14/20220916091805.pdf","verification":{"basis":["national_government_directory_host_only"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"official_host_only"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":403,"inputStatus":"blocked","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"blocked"},"evaluationType":"unknown","format":"html","id":"be4d9c10f451444906ee1274","role":"candidate","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":null,"label":"unstructured_source_text","preview":null,"status":"not_acquired","textSha256":null,"truncated":false},"title":"教育委員会事務事業点検・評価報告書／雛とべに花の里・河北町","titleBasis":"inventory_title","url":"https://www.town.kahoku.yamagata.jp/kosodate_kyouiku/kyouikuiinkai/2449.html","verification":{"basis":["national_government_directory_host_only"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"official_host_only"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T09:08:28.171Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"907462a4565e7a8eed1b329718dcd0bb8d56b8ecc6ccd8f10bbaac29a740b659","state":"acquired"},"evaluationType":"education_inspection","format":"pdf","id":"34dfa0190bce640f351fd12c","navigationReview":{"checkedAt":"2026-10-21T08:46:51Z","evidenceUrl":"https://www.town.kahoku.yamagata.jp/kosodate_kyouiku/kyouikuiinkai/2449.html","method":"official_body_review","notes":"掲載ページ本文で資料へのリンクを確認。","originEvidenceUrl":null,"publisher":"河北町","rawArchiveState":"collected","yearNotes":"令和5年度報告（令和4年度分）"},"role":"supporting_document","text":{"assetBytes":111647,"assetPath":"documents/34dfa0190bce640f351fd12c.json","assetSha256":"088743f4564ef6cdbc0dfc648d6b4763aec2fbe32d0ddbc78f17d97b15d89a7e","characters":39825,"exportedCharacters":39825,"extractionMethod":"pdftotext_from_verified_bytes","inputTextSha256":"907462a4565e7a8eed1b329718dcd0bb8d56b8ecc6ccd8f10bbaac29a740b659","label":"unstructured_source_text","preview":"令和５年度\n\n河北町教育委員会事務事業点検及び評価報告書\n（令和４年度分）\n\n河北町教育委員会\n（令和５年９月）\n\n\n目\n\nⅠ\n\n次\n\n教育委員会事務事業の点検及び評価について\n\n・・・・・・・・１\n・・・・・・・・・・・・・・・・１\n\n２ 点検及び評価の対象事業\n\n・・・・・・・・・・・・・・・・１\n\n３ 点検及び評価の方法\n\n・・・・・・・・・・・・・・・・１\n\n４ 学識経験者の知見の活用\n\n・・・・・・・・・・・・・・・・２\n\nⅡ\n\n１ 制度の概要及び目的\n\n教育委員会の活動状況\n\n・・・・・・・・・・・・・・・・２\n\n１ 総合教育会議の開催\n\n・・・・・・・・・・・・・・・・２\n\n２ 教育委員会会議の開催\n\n・・・・・・・・・・・・・・・・２\n\n３ 教育委員会会議以外の活動\n\n・・・・・・・・・・・・・・・・３\n\n４ 教育委員の報酬\n\n・・・・・・・・・・・・・・・・３\n\nⅢ\n\n施策の体系\n\n・・・・・・・・・・・・・・・・４\n\nⅣ\n\n教育事務評価委員の意見\n\n・・・・・・・・・・・・・・・・５\n\nⅤ\n\n点検及び評価対象事業一覧\n\n・・・・・・・・・・・・・・・・13\n\n【点検及び評価の結果（事務事業点検及び評価調書）】\n\n・・・・・・・・15\n\n\nⅠ\n\n教育委員会事務事業の点検及び評価について\n\n１\n\n制度の概要及び目的\n\n教育委員会の点検及び評価は、地方教育行政の組織及び運営に関する法律（昭和３１\n年法律第１６２号）第２６条の規定により毎年、その権限に属する事務の管理及び執行\n状況について自ら点検及び評価を行い、その結果に関する報告書を議会に提出するとと\nもに、公表しなければならないことになっています。\nまた、この点検及び評価を行うに当たっては、教育に関し学識経験を有する者の知見\nの活用を図るものとされています。\nこの法律を受け、河北町教育委員会では、効果的な教育行政の推進に資するとともに\n町民に対する説明責任を果たすため、前年度に行った事務事業について、３名の教育事\n務評価委員の方々の意見をいただきながら点検及び評価を実施し、その結果を報告書と\nしてまとめました。\n【参考】\n地方教育行政の組織及び運営に関する法律\n（教育に関する事務の管理及び執行の状況の点検及び評価等）\n第26条\n\n教育委員会は、毎年、その権限に属する事務（前条第１項の規定により教育長","status":"available","textSha256":"774329924f79430de3163baef612025aaea17eda9b1b652097c760ea2069270e","truncated":false},"title":"令和5年度 河北町教育委員会事務事業点検・評価報告書（令和4年度分） (PDFファイル: 1.2MB)","titleBasis":"inventory_title","url":"https://www.town.kahoku.yamagata.jp/material/files/group/14/R5jimujigyouhyouka.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]}]}
