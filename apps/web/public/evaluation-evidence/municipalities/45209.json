{"discovery":{"coverageCompleteness":"not_established","initialLook":true,"omittedRejectedSources":0,"searchAttemptsCount":0,"status":"fetched"},"evaluationPages":["3c1ba51df34303818b76a355"],"municipality":{"municipalityCode":"45209","municipalityName":"えびの市","prefectureCode":"45","prefectureName":"宮崎県"},"officialDirectoryLinks":[{"evidenceSha256":"928307667dde46f5f7943058c93515865a69e72c14eb4fc804c7acf73bc45887","evidenceUrl":"https://www.digital.go.jp/assets/contents/node/basic_page/field_ref_resources/2b1128e2-c699-4aa0-9206-37169a6697c8/3d2142af/20260630_resources_opendata_lg_list_02.csv","kind":"official_directory_page","title":"えびの市 公式オープンデータページ","url":"https://www.city.ebino.lg.jp/soshiki/kikaku/12/2/1566.html","verificationBasis":"national_government_directory_municipality_mapping"}],"officialFallback":{"evidenceSha256":"928307667dde46f5f7943058c93515865a69e72c14eb4fc804c7acf73bc45887","evidenceUrl":"https://www.digital.go.jp/assets/contents/node/basic_page/field_ref_resources/2b1128e2-c699-4aa0-9206-37169a6697c8/3d2142af/20260630_resources_opendata_lg_list_02.csv","kind":"official_directory_page","title":"えびの市 公式オープンデータページ","url":"https://www.city.ebino.lg.jp/soshiki/kikaku/12/2/1566.html","verificationBasis":"national_government_directory_municipality_mapping"},"officialHomepage":null,"schemaVersion":1,"sources":[{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-11T17:35:47.212025+00:00","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"2af16ccf7873d0775a5652d01d64c8308fe1474d6218b96b0042bdc405094c4b","state":"acquired"},"evaluationType":"mixed_evaluation","format":"html","id":"3c1ba51df34303818b76a355","role":"evaluation_landing_page","text":{"assetBytes":4082,"assetPath":"documents/3c1ba51df34303818b76a355.json","assetSha256":"6dca675e73fe0f57f0631821fe6e8a1a845c6da310c659c6ea793ff7678e574c","characters":1254,"exportedCharacters":1254,"extractionMethod":"visible_html_from_verified_bytes","inputTextSha256":"2af16ccf7873d0775a5652d01d64c8308fe1474d6218b96b0042bdc405094c4b","label":"unstructured_source_text","preview":"平成28年度事務事業の外部評価について／えびの市\n平成28年度事務事業の外部評価について\nTweet\n更新日：2022年02月28日\nページID :\n1966\n市では、行政組織内部における評価に学識経験者などの専門的な視点や、市民からの視点を加えた評価をすることで、\n効率的かつ効果的な市民サービスの推進\n市民へ説明する責任（アカウンタビリティ）の確保\n職員の政策形成能力の向上と意識改革\nを図り、さらなる市民の満足度の向上につなげるため、「行政評価の外部評価」を実施しました。\n実施体制\n6人で実施しました。\n評価対象\n2施策\n昨年まで「事業」単位で評価していましたが、今年は複数の「事業」で構成される「施策」単位で評価しました。\n評価対象施策は、以下の2施策です。\n1.市民協働によるまちづくり【評価シート】 (Excelファイル: 45.5KB)\n2.資源循環型社会の推進【評価シート】 (Excelファイル: 44.5KB)\n評価作業の流れ\n施策ごとに次の流れで実施しました。（110分程度）\n施策・事業説明（40分程度）【職員】\n説明者（施策・事業の担当職員）は、「施策評価シート」に基づき、施策・事業の概要、現状や補足事項について説明。\n質疑応答・議論（40分程度）【外部評価員⇔職員】\n評価員からの施策・事業についての質疑について、職員が回答。\n評価シートの作成（10分程度） 【外部評価員】\n施策・事業の説明、質疑応答を参考に各評価員が評価シートの作成。\n評価（20分程度） 【外部評価員】\n説明、質疑応答を参考に、評価員が作成した評価シートを集計し、その施策の評価と意見等について整","status":"available","textSha256":"d2f19e490c4a05aa0f870d4c16d687725bf0f25ffc4002bc0a38c9bf781acfe3","truncated":false},"title":"平成28年度事務事業の外部評価について／えびの市","titleBasis":"html_title","url":"https://www.city.ebino.lg.jp/gyosei_shisei/gyosei/1966.html","verification":{"basis":["directory_host_unique_to_municipality"],"evaluationRelevance":"verified","evidenceSha256":"2af16ccf7873d0775a5652d01d64c8308fe1474d6218b96b0042bdc405094c4b","evidenceSourceId":"3c1ba51df34303818b76a355","status":"verified"},"years":[{"basis":"source_title","calendarYear":2016,"label":"平成28年度","meaning":"fiscal_year_mentioned","quote":"平成28年度事務事業の外部評価について／えびの市"},{"basis":"printed_text","calendarYear":2016,"label":"平成28年度","meaning":"fiscal_year_mentioned","quote":"平成28年度事務事業の外部評価について／えびの市 平成28年度事務事業の外部評価について Tweet 更新日：2022年0"},{"basis":"printed_text","calendarYear":2022,"label":"2022年","meaning":"calendar_year_mentioned","quote":"28年度事務事業の外部評価について Tweet 更新日：2022年02月28日 ページID : 1966 市では、行政組織内部における評価に学識経験者などの専門的な視点や、市民"}]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T03:22:39.887Z","httpStatus":200,"inputStatus":"fetched","memberI