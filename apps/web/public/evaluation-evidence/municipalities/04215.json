:"documents/fc2f1fb72834f2ea98a925a3.json","assetSha256":"cd4a9e92b7ae62b88023d4965532734131fac624816b6c3743660b79cfd7e837","characters":513328,"exportedCharacters":120000,"extractionMethod":"pdftotext_from_verified_bytes","inputTextSha256":"f2184d82b081f36649f69345a500f1be6da40383fa76aa96c782cdc97c12f13c","label":"unstructured_source_text","preview":"9‐\n２\n令和３年度\n\n主要施策の成果（Ⅱ）\n（事務事業評価）\n\n大\n\n崎\n\n市\n\n\n\n地方自治法第２３３条第５項の規定により，令和３年度\nにおける主要な施策の成果を報告します。\n\n令和４年９月\n\n大崎市長\n\n伊藤\n\n康志\n\n\n目\n主要施策の成果\n\n次\n\n（Ⅱ）\n\n第５章 地域で支え合い 健康で元気なまちづくり【保健・医療・福祉】\n第１節 生涯を通じた健康づくりの推進\n510101 健康づくり普及事業 ････････････････････････････････････････････････････\n421\n510102 母子保健事業 ････････････････････････････････････････････････････････････\n423\n510103 健康相談事業 ････････････････････････････････････････････････････････････\n425\n510104 健康教育事業 ････････････････････････････････････････････････････････････\n427\n510105 訪問指導事業 ････････････････････････････････････････････････････････････\n429\n510106 精神保健相談事業 ･････････････････････････････････････････････････････\n431\n510107 子育て世代包括支援センター事業 ･･･････････････････････････････････････････\n433\n510108 幼児歯科相談事業 ･･･････････････････････････････････････････････････････････\n435\n510109 成人歯科保健事業 ･･･････････････････････････････････････････････････････････\n437\n510201 被保険者等健康保持増進事業① ･･･････････････････････････････････････････････････\n439\n510202 被保険者等健康保持増進事業② ･･･････････････････","status":"available","textSha256":"ace3de766559125a86d4e30d2ed18878bc84d32c004a8d6e90b0fe9da3fe3df0","truncated":true},"title":"令和3年度主要施策の成果（第5章～第6章）","titleBasis":"inventory_title","url":"https://www.city.osaki.miyagi.jp/material/files/group/10/seika_5-6.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"verified","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T09:09:03.960Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"me