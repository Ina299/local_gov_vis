d3a4e52427caf0b9b81128cb822f38bda6bba54b0d80","state":"acquired"},"evaluationType":"business_project_evaluation","format":"pdf","id":"82ae96e11ec1bdfc5bdbfc7a","role":"evaluation_document","text":{"assetBytes":6908,"assetPath":"documents/82ae96e11ec1bdfc5bdbfc7a.json","assetSha256":"911ccb781ad99c504270063cbb3b55df2696158c705eaf27a252c1c61f51d7fb","characters":2327,"exportedCharacters":2327,"extractionMethod":"cached_extracted_text_hash_verified","inputTextSha256":"ceabcef20e4b1487a7adc3e608e349a34542502602947fbe8e70388de43af749","label":"unstructured_source_text","preview":"令和6年度\n事務事業評価シート 【事後評価】\n会計 款 項 目 事業コード 事業名 成果指標の達成度の要因分析（成果指標を設定しない場合は、その理由を記載）\n01 02 01 02 124040 広報活動事業費 各種イベント等に関するお知らせや市政に関する情報について、複数の広報媒体（広報はなまき、ホームページ\n、SNS、コミュニティFM、ケーブルテレビ等）を活用して積極的に発信し、その内容についてもできる限り分かり\n総合 分野 06 行政経営 政策 01 効率的で質の高い行政運営 やすい内容となるよう努めた。また、より多くの方に市の情報を届けるため、ホームページ内にAI技術を活用し\n計画 た24時間365日利用者の質問に回答するAIチャットボットを導入したほか、花巻市公式LINEを活用した情報発信も\n施策 02 わかりやすい市政情報の提供 開始した。\n市民に市政の状況を理解してもらうため、各種広報媒体を効果的に活用して情報を発信する。 一方で、成果指標に掲げる「広報など市から提供される情報がタイムリーでわかりやすいと思う市民の割合」は\n目的 、前年度より1.9ポイント上昇するなど近年は上昇傾向にあるが、目標値である70％には依然として達していない\nことから、情報発信の手法や内容等について、市民ニーズを踏まえた見直しや更新を図っていく必要がある。\n市民\n対象\n目 公共関与の妥当性 市と市民が情報を共有するためには市からの情報発信が不可欠である。\n市政情報が適時・適切に届いている 的 ○ 妥当である\n妥\n意図 当 見直し余地がある\n性 妥当でない\n○広報紙等の発行 45,414千","status":"available","textSha256":"2fb2a31576575dafd4ceafb3f986a8cbd8fcaa0299214453d9f19f8ac4bdce46","truncated":false},"title":"r7-6-1-2hyouka.pdf","titleBasis":"source_filename","url":"https://www.city.hanamaki.iwate.jp/_res/projects/default_project/_page_/001/024/594/06r7gyouseikeiei/06_gyouseikeiei_hyouka/r7-6-1-2hyouka.pdf","verification":{"basis":["official_host_pattern","exact_municipality_name_in_verified_source","prefecture_or_unique_name_disambiguated"],"evaluationRelevance":"verified","evidenceSha256":"f65f016fba8178fba58dd3a4e52427caf0b9b81128cb822f38bda6bba54b0d80","evidenceSourceId":"82ae96e11ec1bdfc5bdbfc7a","status":"verified"},"years":[{"basis":"printed_text","calendarYear":2024,"label":"令和6年度","meaning":"evaluation_year","quote":"令和6年度 事務事業評価シート 【事後評価】 会計 款 項 目 事業コード 事業名 成果指標の達成度の要因分析（成果指標"}]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":403,"inputStatus":"blocked","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"blocked"},"evaluationType":"unknown","format":"html","id":"ab1c6309163e1d1b7217ea3b","role":"official_page","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":null,"label":"unstructured_source_text","preview":null,"status":"not_acquired","textSha256":null,"truncated":false},"title":"令和7年度花巻市行政評価委員会による評価結果","titleBasis":"official_link_label","url":"https://www.city.hanamaki.iwate.jp/shisei/shisei/gyoseihyoka/1024588/1024595.html","verification":{"basis":["literal_link_in_verified_official_page","same_municipality_official_host"],"evaluationRelevance":"verified","evidenceSha256":"567fbe3ac36414a67a8b164d19dc7e8ab9bd48f485bf9509d9c9f21854aad5f7","evidenceSourceId":"ab37504a013a9ed715346b74","status":"verified"},"years":[{"basis":"official_link_label","calendarYear":2025,"label":"令和7年度","meaning":"fiscal_year_mentioned","quote":"令和7年度花巻市行政評価委員会による評価結果"}]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-11T17:47:59.077759+00:00","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"567fbe3ac36414a67a8b164d19dc7e8ab9bd48f485bf9509d9c9f21854aad5f7","state":"acquired"},"evaluationType":"mixed_evaluation","format":"html","id":"ab37504a013a9ed715346b74","role":"evaluation_landing_page","text":{"assetBytes":4138,"assetPath":"documents/ab37504a013a9ed715346b74.json","assetSha256":"3f24dee063bbea3acecb28fe4d4bb4e3f30b8a56b975460e8dacafd918189159","characters":1211,"exportedCharacters":1211,"extractionMethod":"visible_html_from_verified_bytes","inputTextSha256":"567fbe3ac36414a67a8b164d19dc7e8ab9bd48f485bf9509d9c9f21854aad5f7","label":"unstructured_source_text","preview":"行政評価｜花巻市\n行政評価\n印刷\n大きな文字で印刷\nページ番号1000675\n更新日\n令和7年12月23日\n市では、効果的・効率的でわかりやすく透明性の高い行政運営の実現と職員の意識改革の推進を図ることを目的として行政評価を導入しています。また、総合計画の進行管理として、評価を通じて施策の向上を図っていきます。\n令和7年度の行政評価結果及び行政評価委員会による評価結果の公表\n令和7年度行政評価の結果\n第2次花巻市まちづくり総合計画に掲げる施策及び施策の目的を達成するための事務事業を対象に、令和7年度に市が実施した施策評価及び事務事業評価について、内容を公表します。\n令和7年度行政評価の結果\n令和7年度花巻市行政評価委員会による評価結果\n花巻市行政評価委員会では、令和7年度に市が実施した内部での行政評価の結果について、外部の視点で評価いただき、行政評価の改善について提言いただきました。その内容について公表します。\n令和7年度は第2次花巻市まちづくり総合計画に掲げる68施策のうち、花巻市行政評価委員会内の「しごと」、「暮らし・健康・いのち」、「子育て・人づくり・地域づくり」の3部会において、6施策を評価対象施策として選択し、その評価結果について検証いただきました。\n令和7年度花巻市行政評価委員会による評価結果\n行政評価の結果\n令和6年度行政評価の結果\n令和5年度行政評価の結果\n令和4年度行政評価の結果\n令和3年度行政評価の結果\n令和2年度行政評価の結果\n令和元年度行政評価の結果\n平成30年度行政評価の結果\n平成29年度行政評価の結果\n平成28年度行政評価の結果\n平成27年度行政評価","status":"available","textSha256":"34b0b98758a59322ceef8be1f23e0b9a00d57b6a1a861354804c321bb91dedc5","truncated":false},"title":"行政評価｜花巻市","titleBasis":"html_title","url":"https://www.city.hanamaki.iwate.jp/shisei/shisei/gyoseihyoka/index.html","verification":{"basis":["official_host_pattern","exact_municipality_name_in_verified_source","prefecture_or_unique_name_disambiguated"],"evaluationRelevance":"verified","evidenceSha256":"567fbe3ac36414a67a8b164d19dc7e8ab9bd48f485bf9509d9c9f21854aad5f7","evidenceSourceId":"ab37504a013a9ed715346b74","status":"verified"},"years":[{"basis":"printed_text","calendarYear":2025,"label":"令和7年","meaning":"calendar_year_mentioned","quote":"刷 大きな文字で印刷 ページ番号1000675 更新日 令和7年12月23日 市では、効果的・効率的でわかりやすく透明性の高い行政運営の実現と職員の意識改革の推進を図ることを"},{"basis":"printed_text","calendarYear":2025,"label":"令和7年度","meaning":"evaluation_year","quote":"行管理として、評価を通じて施策の向上を図っていきます。 令和7年度の行政評価結果及び行政評価委員会による評価結果の公表 令和7年度行政評価の結果 第2次花巻市まちづくり総合計画"},{"basis":"printed_text","calendarYear":2025,"label":"令和7年度","meaning":"fiscal_year_mentioned","quote":"げる施策及び施策の目的を達成するための事務事業を対象に、令和7年度に市が実施した施策評価及び事務事業評価について、内容を公表します。 令和7年度行政評価の結果 令和7年度花巻市"},{"basis":"printed_text","calendarYear":2024,"label":"令和6年度","meaning":