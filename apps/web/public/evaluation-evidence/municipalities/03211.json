ication":{"basis":["national_government_directory_host_only"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"official_host_only"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T09:07:34.999Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"f02a7b863a87aabe1ef6239e4e69a9bc6bd1dccac72b34739739ff4b8a024709","state":"acquired"},"evaluationType":"education_inspection","format":"pdf","id":"190b843fb7858d45f21365a9","navigationReview":{"checkedAt":"2026-10-21T06:00:00Z","evidenceUrl":"https://www.city.kamaishi.iwate.jp/docs/2025082700066/","method":"official_body_review","notes":"教育委員会の点検・評価報告書ページでPDFリンクを確認（相対リンクfile_contents/6.pdf、検索結果でも同URL）。市の事務事業評価は見つからず。","originEvidenceUrl":null,"publisher":"釜石市","rawArchiveState":"collected","yearNotes":"令和6年度（リンク文字列）"},"role":"supporting_document","text":{"assetBytes":128982,"assetPath":"documents/190b843fb7858d45f21365a9.json","assetSha256":"7b753122d63dba6917528cf674dc262a92590e4e7838e6c26717532304a035ae","characters":47769,"exportedCharacters":47769,"extractionMethod":"pdftotext_from_verified_bytes","inputTextSha256":"f02a7b863a87aabe1ef6239e4e69a9bc6bd1dccac72b34739739ff4b8a024709","label":"unstructured_source_text","preview":"令和６年度\n教育委員会の事務の管理及び\n執行状況に係る点検・評価報告書\n\n釜石市教育委員会\n\n\n\n目\n\n次\n\nⅠ\n\nはじめに ------------------------------------------------------------------ 1\n(参考)第六次釜石市総合計画※抜粋 ------------------------------------------ 2\n\nⅡ\n\n教育委員会の活動 ---------------------------------------------------------- 3\n１ 教育委員会議\n２\n\n総合教育会議\n\n３\n\n会議以外の主な活動\n\nⅢ\n１\n\n教育委員会の事務の管理及び執行状況に係る点検・評価の結果 ------------------ 4\n点検・評価の基準\n\n２\n\n点検・評価の体系\n\n３\n\n点検・評価の結果\n基本施策１ 未来を担う子どもたちの育成\n実施施策\n(1)生きる力を育む学校教育の充実\n\n--------------------------- 5\n\n基本施策２ 子どもを育む環境づくり\n実施施策\n(1)地域づくりに寄与する特色ある教育活動の推進 -------------16\n(2)教育環境の充実とさらなる向上 ---------------------------23\n基本施策３ 生涯学習・スポーツの振興\n実施施策\n(1)学びと実践が循環しつながりを創出する生涯学習社会の形成 -39\n(2)豊かな生活と新たな価値を生み出すスポーツの推進 ---------47\n基本施策４ 歴史・文化・芸術文化の振興\n実施施策\n(1)歴史・文化の継承と文化財の普及・啓発の推進 -------------48\n(2)橋野鉄鉱山の保存・整備・活用と鉄の歴史・文化の発信 -----56\n\n「令和６年度教育委員会の事務の管理及び執行状況に係る点検・評価調書」学識経験者\nからの意見聴取会意見（要点）----------------------------------------------------62\n\n\n\nⅠ\n\nはじめに\n\n□\n\nこの報告書は、地方教育行政の組織及び運営に関する法律(昭和 31 年法律第 162 号)第 26 条\nに基づき、令和 6 年度の教育委員会の事務の管理及び執行状況に係る点検並びに評価結果を","status":"available","textSha256":"6469a36792d044fb8d07f61d03e5d358ee967f29b9cf3d6828249584f2de846e","truncated":false},"title":"令和6年度教育委員会の事務の管理及び執行状況に係る点検・評価報告書","titleBasis":"inventory_title","url":"https://www.city.kamaishi.iwate.jp/docs/2025082700066/file_contents/6.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]}]}
