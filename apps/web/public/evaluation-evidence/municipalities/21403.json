6":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":"7b8689c72e2d983fe555113b46e823102a2b6f89087063ff63fd1a42b1166a7a","label":"unstructured_source_text","preview":null,"status":"no_readable_text","textSha256":null,"truncated":false},"title":"大野町教育委員会点検評価報告書","titleBasis":"inventory_title","url":"https://www.town-ono.jp/0000000024.html","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T11:35:36.126Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"5b76a5f942de2a99b3a3fc90c83f493fb745e566f0409402a7731155a4c88f52","state":"acquired"},"evaluationType":"education_inspection","format":"pdf","id":"d62b6010b82344ab75b2ddae","navigationReview":{"checkedAt":"2026-10-21T06:00:00Z","evidenceUrl":"https://www.town-ono.jp/0000000024.html","method":"official_body_review","notes":"教育委員会点検評価報告書。","originEvidenceUrl":null,"publisher":"大野町","rawArchiveState":"collected","yearNotes":"令和6年度対象・令和7年度実施（リンク文字列）"},"role":"supporting_document","text":{"assetBytes":74107,"assetPath":"documents/d62b6010b82344ab75b2ddae.json","assetSha256":"96d5ad68bb7d9507c8907a6768b12ad70b753a9707a1665e3e56499f06ced6b6","characters":25397,"exportedCharacters":25397,"extractionMethod":"pdftotext_from_verified_bytes","inputTextSha256":"5b76a5f942de2a99b3a3fc90c83f493fb745e566f0409402a7731155a4c88f52","label":"unstructured_source_text","preview":"令和６年度\n\n大野町教育委員会点検評価報告書\n\n大野町教育委員会\n\n\n\n令和６年度\n\n大野町教育委員会点検評価シート\n\n○教育委員会の活動状況について\n点 検 項 目\n\n実\n\n施\n\n成 果○ と 課 題●\n\n評価\nＡ\n\n教育委員会会\n\n開催回数： 定例会議１２回\n\n○いじめ・不登校など、学校の様子につい\n\n議の実施状況\n\n臨時会議 ０回\n\nて報告し、自分自身で問題解決をできる\n\n審議件数： 議案\n\n５４件\n\n力を育てていってほしいなど、委員会で\n\n内可決 ５４件\n\n出された意見を校長会や教頭会を通して\n\n総合教育会議 ３回\n\n学校に伝えて学校運営に生かした。\n○教育委員会の事業後援について、営利目的\nの団体であるかなど、主催団体の状況を把\n握し、後援の可否を慎重に審議した。\n○総合教育会議では、教育振興基本計画の検\n討を行い、５ヶ年計画の１年目として、大\n野町の教育の見直しを図ることができた。\n\n調査活動の状 ・町教委訪問（全小中学校）\n況等\n\n１月２７日、２８日、２９日\n\n【昨年度課題】学校規模が縮小する中で、\n\nＡ\n\n今後も２校発表が適切なのか検討。\n\n（３日間） →○児童生徒の数は減少してきているが、\n・町研報告会\n\nそれぞれの実態に合わせて、目指す教\n\n大野小・中小１１月２１日\n\n育を具現しようと努力している。互い\nに学び会う機会として、令和１３年度\nの学校統合まで、２校の発表は維持し\nていきたい。\n○１月末の町教委訪問となり、１年間の指\n導の成果を評価することができた。\n●町教委訪問での指導を学校経営に活かす\nには、１月実施では十分な期間があると\nはいえなかった。\n○１１月の発表に向けて継続した取組を行\nい、その成果を町研で示すことができ\nた。発表校のよさから学び合うことがで\nきた。\n\n学校規模適正 ・町小中学校のあり方内部検討 【昨年度課題】小中学生の親世代や現在の\n化について\n\n委員会（２回実施）\n・町小中学校のあり方外部検討\n委員会（１１月１３日、２\n\n学生世代など、若年層に対してのアプ\nローチ方法の検討。\n→○検討内容の説明動画をオンデマンド配\n\n月２１日、３月２４日）\n\n信し、オンラインで意見聴取を実施し\n-1-\n\nＡ\n\n\nた。回答フォームは、動画の配信画面\nをはじめ、町ＨＰ、「広報おおの」等\nの各種媒体に掲載し、回答を呼びかけ\nた。その結果、1","status":"available","textSha256":"6db3b69c9f70ae8b4a19f7c58f95a93186dfc9a5788490ec1ca559702462bd7c","truncated":false},"title":"令和6年度（令和7年度実施）(PDF形式、887.78KB)","titleBasis":"inventory_title","url":"https://www.town-ono.jp/cmsfiles/contents/0000000/24/R7onotenkenhyoka.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]}]}
