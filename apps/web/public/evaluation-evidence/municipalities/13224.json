{"discovery":{"coverageCompleteness":"not_established","initialLook":true,"omittedRejectedSources":0,"searchAttemptsCount":0,"status":"fetched"},"evaluationPages":["7c3d31c3aee3031306a1e9df"],"municipality":{"municipalityCode":"13224","municipalityName":"多摩市","prefectureCode":"13","prefectureName":"東京都"},"officialDirectoryLinks":[{"evidenceSha256":"928307667dde46f5f7943058c93515865a69e72c14eb4fc804c7acf73bc45887","evidenceUrl":"https://www.digital.go.jp/assets/contents/node/basic_page/field_ref_resources/2b1128e2-c699-4aa0-9206-37169a6697c8/3d2142af/20260630_resources_opendata_lg_list_02.csv","kind":"official_directory_page","title":"多摩市 公式オープンデータページ","url":"http://www.city.tama.lg.jp/opendata.html","verificationBasis":"national_government_directory_municipality_mapping"}],"officialFallback":{"evidenceSha256":"928307667dde46f5f7943058c93515865a69e72c14eb4fc804c7acf73bc45887","evidenceUrl":"https://www.digital.go.jp/assets/contents/node/basic_page/field_ref_resources/2b1128e2-c699-4aa0-9206-37169a6697c8/3d2142af/20260630_resources_opendata_lg_list_02.csv","kind":"official_directory_page","title":"多摩市 公式オープンデータページ","url":"http://www.city.tama.lg.jp/opendata.html","verificationBasis":"national_government_directory_municipality_mapping"},"officialHomepage":null,"schemaVersion":1,"sources":[{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T03:20:27.037Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"7dc59dc7c42404bf267ef72565fdb813348cc843d23c34d7a19ea357c965d94f","state":"acquired"},"evaluationType":"unknown","format":"pdf","id":"13e8942a2b111cbd548a85e9","role":"supporting_document","text":{"assetBytes":338167,"assetPath":"documents/13e8942a2b111cbd548a85e9.json","assetSha256":"8c88f1a138b4fed7ff082d578028e779cb59e0611f9fa9aff6e8dc159df36696","characters":120999,"continuations":[{"assetBytes":2835,"assetPath":"documents/13e8942a2b111cbd548a85e9-2.json","assetSha256":"d4f35cbed90ee9eb5de6deb6ccd5e8591466311162e8467fecf550e1a37a213c","exportedCharacters":999,"part":2,"startCharacter":120000,"textSha256":"3678a19ddf8168382cdb6a94153d4494b8cc25f97c273134380fe47948951439"}],"exportedCharacters":120000,"extractionMethod":"pdftotext_from_verified_bytes","fullTextSha256":"f5a17d67200d7b1d3c2aa9dcc519288715b4ed6352ddb7bcf8f5c6c09b2b2eec","inputTextSha256":"7dc59dc7c42404bf267ef72565fdb813348cc843d23c34d7a19ea357c965d94f","label":"unstructured_source_text","preview":"多摩市行政評価レポート\n～令和６(2024)年度における行政評価の取組～\n\n令和７(2025)年２月発行\n\n\n\n市長より\n\n「多摩市行政評価レポート」の発行にあたって\n\n令和５(2023)年11月から、「つながり 支え 認め合い いきいきと かがやけるまち 多摩」を将来都市像とする第六次\n総合計画がスタートしました。この計画では、地球規模の環境問題、少子化・高齢化の進行、今後の人口減少等の課題\nを乗り越えるため、６つの「分野別の目指すまちの姿」とともに、３つの「分野横断的に取り組むべき重点テーマ」\n（①環境との共生、②健幸まちづくりの推進、③活力・にぎわいの創出）を設定して、取組を進めるものとしています。\n総合計画の進行管理にあたっては、これまでも「行政評価」の手法を用いてきましたが、新たな総合計画のスタート\nを機に、社会情勢の急激な変化にも柔軟に対応しながら、限られた経営資源の中でより効率的・効果的な財源配分と事\n業選択につなげていくことを意識し、新たな行政評価のしくみづくりに取り組むこととしました。\nこの「多摩市行政評価レポート」 は、令和６(2024)年度に試行で実施した新たな行政評価\nのしくみの全体像や、取組状況等を市民の皆さんと共有し、これからのまちづくりを共に進め\nていくため、従来の「多摩市行政経営報告書」をリニューアルし、発行するものです。\n令和６(2024)年度においては、評価結果と予算との連動強化、評価事務の効率化、各種デー\nタを踏まえた未来志向の議論の場づくり等に取り組むとともに、幅広い方からご意見をいただ\nくため、無作為抽出で選ばれた市民の皆さんを対象に、新たに「多摩市のまちづくりに関する\nアンケート」「オンライン座談会」を実施し、忌憚のないご意見をいただきました。ご協力を\nいただいた皆さんに、この場を借りて感謝申し上げます。\n総合計画で掲げた将来都市像の実現に向けて、令和６(2024)年度の試みにより得られた課題\nを、行政評価のしくみの改善へと活かし、今後のまちづくりを推進していきます。引き続きの\nご協力をよろしくお願いします。\n\n令和７(2025)年 ２月\n\n多摩市長 阿部\n\n裕行\n\n\n目 次\nはじめに ―――――――――――――――――――――――――――――――――――――――――――― １\n１\n\n行政評価とは\n\n～総合計画の着実な進行","status":"available","textSha256":"245fe49ea66e741980812ae91daeee449c166ab139bae29d5653fe3c6c56d67a","truncated":true},"title":"多摩市行政評価レポート ～令和6（2024）年度における行政評価の取組～ （PDF 10.9 MB）","titleBasis":"official_link_label","url":"https://www.city.tama.lg.jp/_res/projects/default_project/_page_/001/017/054/R6.pdf","verification":{"basis":["literal_link_in_verified_official_page","same_municipality_official_host"],"evaluationRelevance":"verified","evidenceSha256":"9c1177e52c859a9809a