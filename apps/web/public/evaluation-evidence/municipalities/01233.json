city.date.hokkaido.jp/hotnews/files/00000400/00000431/20240417153344.pdf","verification":{"basis":["literal_link_in_verified_official_page","same_municipality_official_host"],"evaluationRelevance":"not_established","evidenceSha256":"e1eea461e597e21438d4393ab70a4da4b8eade798dbbec291e01996d1d4c7f2a","evidenceSourceId":"4a8e0fc63bd3e34a89f02820","status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-11T17:49:34.013451+00:00","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"e1eea461e597e21438d4393ab70a4da4b8eade798dbbec291e01996d1d4c7f2a","state":"acquired"},"evaluationType":"business_project_evaluation","format":"html","id":"4a8e0fc63bd3e34a89f02820","role":"evaluation_landing_page","text":{"assetBytes":3623,"assetPath":"documents/4a8e0fc63bd3e34a89f02820.json","assetSha256":"4c40322b28893e23224b56a08e56cd18a3dafc021a9763d7c7760f9d1e66a5ca","characters":1155,"exportedCharacters":1155,"extractionMethod":"visible_html_from_verified_bytes","inputTextSha256":"e1eea461e597e21438d4393ab70a4da4b8eade798dbbec291e01996d1d4c7f2a","label":"unstructured_source_text","preview":"第7次伊達市総合計画における事務事業評価について | 北海道伊達市\nここから本文です。\n市政情報\n第7次伊達市総合計画における事務事業評価について\n「第7次伊達市総合計画」では、そこに描く理想の都市像の実現のため、計画に位置付けられた事務事業をPDCA（Plan（プラン・計画）、Do（ドゥ・実施）、Check（チェック・評価）、Action（アクション・改善））サイクルに基づき円滑に推進することにしています。\n伊達市ではこの中のCheckに対応するものとして、第7次伊達市総合計画に位置付けたすべての事務事業の中から、特に評価が必要とされた事務事業に対し、有効性などの「観点別評価」と、今後の事務事業のあり方を示した「方向性評価」から評価する「事務事業評価」を行っています。\nただし、事務事業の中には、結論を出すには時期尚早な新規の事務事業や、成果が表れるまで一定の期間が必要なもの、休廃止の前に市民生活への影響などを慎重に検討しなければならないものなどがあることから、「事務事業評価」の結果は、単に事務事業の休止や廃止などを判断するためだけではなく、事務事業の進行管理や課題の把握、次年度の予算編成や次期計画策定などの資料としても活用しています。\nこれまでの事務事業評価の結果は次のとおりです。\nPDF\n令和5年度伊達市事務事業評価における評価結果\n(1.1MB)\n令和5年度伊達市事務事業評価シート\n事務事業ごとの評価シートは次のとおりです。\nPDF\nふるさと納税推進経費\n(798.8KB)\n担当：企画財政課\nPDF\n自治会活動推進事業\n(793.5KB)\n担当：総務課\nPDF\n地域子育て","status":"available","textSha256":"e2a8dedd523eaa28b65db93222f85e1142b542d365034ec27c05253ec6330968","truncated":false},"title":"第7次伊達市総合計画における事務事業評価について | 北海道伊達市","titleBasis":"html_title","url":"https://www.city.date.hokkaido.jp/hotnews/detail/00000431.html","verification":{"basis":["directory_host_unique_to_municipality"],"evaluationRelevance":"verified","evidenceSha256":"e1eea461e597e21438d4393ab70a4da4b8eade798dbbec291e01996d1d4c7f2a","evidenceSourceId":"4a8e0fc63bd3e34a89f02820","status":"verified"},"years":[{"basis":"printed_text","calendarYear":2023,"label":"令和5年度","meaning":"fiscal_year_mentioned","quote":"これまでの事務事業評価の結果は次のとおりです。 PDF 令和5年度伊達市事務事業評価における評価結果 (1.1MB) 令和5年度伊達市事務事業評価シート 事務事業ごとの評価シー"}]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":null,"inputStatus":"blocked","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"blocked"},"evaluationType":"unknown","format":"pdf","id":"7b05104f1d2fe76e2c3399df","role":"supporting_document","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":null,"label":"unstructured_source_text","preview":null,"status":"not_acquired","textSha256":null,"truncated":false},"title":"自治会活動推進事業","titleBasis":"official_link_label","url":"https://www.city.date.hokkaido.jp/hotnews/files/00000400/00000431/20240417153252.pdf","verification":{"basis":["literal_link_in_verified_official_page","same_municipality_official_host"],"evaluationRelevance":"not_established","evidenceSha256":"e1eea461e597e21438d4393ab70a4da4b8eade798dbbec291e01996d1d4c7f2a","evidenceSourceId":"4a8e0fc63bd3e34a89f02820","status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":403,"inputStatus":"blocked","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"blocked"},"evaluationType":"unknown","format":"pdf","id":"8a359a966e4db5e38416fc2f","role":"supporting_document","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"export