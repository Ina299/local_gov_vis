/attachment/9387.pdf","verification":{"basis":["literal_link_in_verified_official_page","same_municipality_official_host"],"evaluationRelevance":"not_established","evidenceSha256":"58ba5d2c14d9b7ecd73d959d576ae67bded3cfdff7f84f8a5bd0474caf8e2a11","evidenceSourceId":"1e5a744da2b0926d266f3d3f","status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":null,"inputStatus":"blocked","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"blocked"},"evaluationType":"unknown","format":"pdf","id":"16c670be5cb5c814b91df29f","role":"supporting_document","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":null,"label":"unstructured_source_text","preview":null,"status":"not_acquired","textSha256":null,"truncated":false},"title":"R6年度2次評価調書 [PDFファイル／1.01MB]","titleBasis":"official_link_label","url":"https://www.town.bihoro.hokkaido.jp/uploaded/attachment/9388.pdf","verification":{"basis":["literal_link_in_verified_official_page","same_municipality_official_host"],"evaluationRelevance":"not_established","evidenceSha256":"58ba5d2c14d9b7ecd73d959d576ae67bded3cfdff7f84f8a5bd0474caf8e2a11","evidenceSourceId":"1e5a744da2b0926d266f3d3f","status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-11T17:53:53.967560+00:00","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"58ba5d2c14d9b7ecd73d959d576ae67bded3cfdff7f84f8a5bd0474caf8e2a11","state":"acquired"},"evaluationType":"business_project_evaluation","format":"html","id":"1e5a744da2b0926d266f3d3f","role":"evaluation_landing_page","text":{"assetBytes":3153,"assetPath":"documents/1e5a744da2b0926d266f3d3f.json","assetSha256":"0b0aa04325b2f77419c6a4794b7e63dfadfb0779547c0a86a8982927f4f327ee","characters":1020,"exportedCharacters":1020,"extractionMethod":"visible_html_from_verified_bytes","inputTextSha256":"58ba5d2c14d9b7ecd73d959d576ae67bded3cfdff7f84f8a5bd0474caf8e2a11","label":"unstructured_source_text","preview":"行政評価制度 - 美幌町公式ホームページ（政策推進課）\n本文\n行政評価制度とは\n「行政評価制度」は、美幌町自治基本条例に基づき、美幌町行政評価実施要綱に定めて行っています。\n行政評価の目的\n町が行っている仕事を、効果的かつ効率的に進めるため、実施結果の検証を行うとともに、行政評価結果を公表することで、行政活動の成果や目標を皆さんに説明し、わかりやすく透明性の高い行政運営を目指します。\n行政評価の概要\n施策を実現するための個々の具体的な手段である「事務事業」のうち、政策的に真に評価が必要な91事業を行政評価の対象事業として絞り込み評価を行いました。\n行政評価の方法\n1次評価\n事務事業を所管する担当課長が実施する評価。（評価責任者は各部局長）\n事務事業ごとに「妥当性」「有効性」「効率性」の視点から今後の方向性を判定するもの。\n2次評価\n副町長が実施する評価。\n1次評価の結果を踏まえ、基本事業を単位として今後の方向性を判定するもの。\n行政評価結果\n令和  6年度\nR6年度1次評価調書 [PDFファイル／1.5MB]\nR6年度2次評価調書 [PDFファイル／1.01MB]\n過去の行政評価結果\n平成27年度\n評価結果一覧【2次評価調書】 [PDFファイル／127KB]\n事後評価シート(主要な施策の成果報告書) [PDFファイル／41.57MB]\n平成28年度\n評価結果一覧【2次評価調書】 [PDFファイル／144KB]\n事後評価シート(主要な施策の成果報告書） [PDFファイル／20.54MB]\n平成29年度\nH29評価結果一覧 [PDFファイル／309KB]\n平成30年度\nH30評価結","status":"available","textSha256":"b7572c44cf5618a5a501c890854cfa3bcf2311d8d65586472b6707943046aa7a","truncated":false},"title":"行政評価制度 - 美幌町公式ホームページ（政策推進課）","titleBasis":"html_title","url":"https://www.town.bihoro.hokkaido.jp/page/2264.html","verification":{"basis":["directory_host_unique_to_municipality"],"evaluationRelevance":"verified","evidenceSha256":"58ba5d2c14d9b7ecd73d959d576ae67bded3cfdff7f84f8a5bd0474caf8e2a11","evidenceSourceId":"1e5a744da2b0926d266f3d3f","status":"verified"},"years":[{"basis":"printed_text","calendarYear":2024,"label":"令和  6年度","meaning":"fiscal_year_mentioned","quote":"を単位として今後の方向性を判定するもの。 行政評価結果 令和 6年度 R6年度1次評価調書 [PDFファイル／1.5MB] R6年度2次評価調書 [PDFファイル／1.01MB]"},{"basis":"printed_text","calendarYear":2015,"label":"平成27年度","meaning":"evaluation_year","quote":"[PDFファイル／1.01MB] 過去の行政評価結果 平成27年度 評価結果一覧【2次評価調書】 [PDFファイル／127KB] 事後評価シート(主要な施策の成果報告書) [P"},{"basis":"printed_text","calendarYear":2016,"label":"平成28年度","meaning":"evaluation_year","quote":"施策の成果報告書) [PDFファイル／41.57MB] 平成28年度 評価結果一覧【2次評価調書】 [PDFファイル／144KB] 事後評価シート(主要な施策の成果報告書） [P"},{"basis":"printed_text","calendarYear":2017,"label":"平成29年度",