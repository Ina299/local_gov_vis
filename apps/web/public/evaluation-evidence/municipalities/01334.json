ン\n等におけるワン\n目標値\n回\n3\nタッチテントの活 タッチテントの活\n用回数3回\n用回数\n達成度\n％\n100.0%\n評価年度の設定理由\n交付金事業の成果目標 事業完了後、早期に評価を実施するため\n交付金事業の定性的な成果及び評価等\n及び成果実績\n\n\n交付金事業の成果目標\n及び成果実績\nワンタッチテントを購入したことで、作業員が高齢化していてもテントを組み立てることが可能となり、イベントの準\n備から運営まで円滑に進めることができました。そのためこれまで通りにイベントを開催でき、町内外から多くの観光\n客が訪れ、地域の観光振興及び産業活性化を図ることができました。引き続き本事業で導入","status":"available","textSha256":"dcafe3296049b023ad3ab3614e1ee7a0e3104c5b0115ed6c0bb731ca44abd1e8","truncated":true},"title":"令和6年度 電源立地地域対策交付金 事業評価総括表・個表（木古内町分）","titleBasis":"inventory_title","url":"https://www.town.kikonai.hokkaido.jp/files/00000600/00000617/cmtdis2_2024_002.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"verified","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":null,"inputStatus":"discovered","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"discovered"},"evaluationType":"grant_project_evaluation","format":"html","id":"fcede09d75990f79c40e2c12","navigationReview":{"checkedAt":"2026-10-12T09:45:00Z","evidenceUrl":"https://www.town.kikonai.hokkaido.jp/gyosei/","method":"search_candidate","notes":"電源立地地域対策交付金を活用した事業評価報告書の案内文あり。個別リンク未確認。","originEvidenceUrl":null,"publisher":"木古内町","rawArchiveState":"not_downloaded","yearNotes":"年度不明。"},"role":"candidate","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":null,"label":"unstructured_source_text","preview":null,"status":"not_acquired","textSha256":null,"truncated":false},"title":"行政情報","titleBasis":"inventory_title","url":"https://www.town.kikonai.hokkaido.jp/gyosei/","verification":{"basis":["検索候補・本文または公式発信元の確認待ち"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"unverified"},"years":[]}]}
