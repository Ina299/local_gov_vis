ており、基調として緩やかな回復が続いてい\nます。しかしながら、名目賃金の伸びが物価上昇に未だ追いついていないことか\nら、個人消費は力強さを欠いた状態が続き、景気の回復力は弱い状態が続いてい\nます。こうした中、春季労使交渉において３３年ぶりの賃上げ水準が実現するな\nど、物価と賃金の好循環の実現が近づきつつある中で、持続的な賃上げと活発な\n投資がけん引する民需主導の","status":"available","textSha256":"ae2be12fb11d258259cb1670392e6dc8033b447b22bcda1c4196236a00e734df","truncated":false},"title":"令和６年度主要な施策の成果を説明する書類","titleBasis":"inventory_title","url":"https://www.city.noshiro.lg.jp/up/files/www/city/yosan-kessan/kessan/shisaku-seika/shuyounasesakuR6.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":null,"inputStatus":"discovered","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"discovered"},"evaluationType":"project_activity_report","format":"pdf","id":"f0f921de181bba55e3c651b6","navigationReview":{"checkedAt":"2026-10-21T07:30:00Z","evidenceUrl":"https://www.city.noshiro.lg.jp/city/yosan-kessan/kessan/shisaku-seika/24518","method":"search_candidate","notes":"決算の主要な施策の成果説明書（評価シートではない）。掲載ページはcurlでリンク確認のみ。","originEvidenceUrl":null,"publisher":"能代市","rawArchiveState":"not_downloaded","yearNotes":"令和５年度（決算年度、タイトルによる）"},"role":"candidate","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":null,"label":"unstructured_source_text","preview":null,"status":"not_acquired","textSha256":null,"truncated":false},"title":"令和５年度主要な施策の成果を説明する書類","titleBasis":"inventory_title","url":"https://www.city.noshiro.lg.jp/up/files/www/city/yosan-kessan/kessan/shisaku-seika/shuyounasesakuR5.pdf","verification":{"basis":["検索候補・本文または公式発信元の確認待ち"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"unverified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":null,"inputStatus":"di