: 8.5MB)","titleBasis":"official_link_label","url":"https://www.city.nagai.yamagata.jp/material/files/group/2/R6_jimujigyou2.pdf","verification":{"basis":["literal_link_in_verified_official_page","same_municipality_official_host"],"evaluationRelevance":"verified","evidenceSha256":"7246b2f8a81507846cf4f039ec2e1068572876f77a8269ac02f5cb2f0ee96c62","evidenceSourceId":"6440ba0c75efd9e020722471","status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-11T17:46:33.021794+00:00","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"7246b2f8a81507846cf4f039ec2e1068572876f77a8269ac02f5cb2f0ee96c62","state":"acquired"},"evaluationType":"business_project_evaluation","format":"html","id":"6440ba0c75efd9e020722471","role":"evaluation_landing_page","text":{"assetBytes":2697,"assetPath":"documents/6440ba0c75efd9e020722471.json","assetSha256":"8e96da9077044ba2ea29cf9a6a1402fa0d1cdedcb0898e44ca3c79087108ed96","characters":758,"exportedCharacters":758,"extractionMethod":"visible_html_from_verified_bytes","inputTextSha256":"7246b2f8a81507846cf4f039ec2e1068572876f77a8269ac02f5cb2f0ee96c62","label":"unstructured_source_text","preview":"令和6年度事業の行政評価の結果を公表します／長井市ホームページ\n令和6年度事業の行政評価の結果を公表します\n更新日：2025年11月14日\nページID：\n15546\n行政評価の目的\n行政評価は、行政活動の目的を明確にしながら、事業の内容や進捗状況を評価し、その結果を事業の改善や予算編成等の行財政運営に反映させていくために実施するものです。\n行政評価の対象\n令和6年度に実施した、 第六次総合計画に基づく「主要施策」及び実施計画に計上している「事務事業（主要施策を構成する事務事業）」を対象として実施しました。\n行政評価の方法\n(1)1次評価\n主要施策については、「令和6年度における主要施策の取り組み」、「成果指標の分析」、「今後の課題」等の視点から、担当課長が評価シートを作成し、その内容を踏まえて担当参事が評価しています。\n事務事業については担当する課が、「活動指標の実績」、「定性評価」等から評価しています。\n(2)2次評価\n行政評価調整会議が実施する評価です。\n1次評価の内容を踏まえて、施策全体の視点から主要施策の今後の方向性を評価しています。\n行政評価の結果\n結果の詳細は、各評価シートをご覧ください。\n主要施策別評価シート （基本目標1～3（1～43ページ）） (PDFファイル: 16.3MB)\n主要施策別評価シート （基本目標4～5（44～74ページ）） (PDFファイル: 11.6MB)\n事務事業別評価シート （基本目標1～3（1～60ページ）） (PDFファイル: 13.0MB)\n事務事業別評価シート （基本目標4～5（61～92ページ）） (PDFファイル: 8.5MB","status":"available","textSha256":"857003cc11a40ca0c799812d765d18aaed969a23cb8a1c8f3bcefcbd8f46de2c","truncated":false},"title":"令和6年度事業の行政評価の結果を公表します／長井市ホームページ","titleBasis":"html_title","url":"https://www.city.nagai.yamagata.jp/event_shisei/shisaku_keikaku/2/1/15546.html","verification":{"basis":["directory_host_unique_to_municipality"],"evaluationRelevance":"verified","evidenceSha256":"7246b2f8a81507846cf4f039ec2e1068572876f77a8269ac02f5cb2f0ee96c62","evidenceSourceId":"6440ba0c75efd9e020722471","status":"verified"},"years":[{"basis":"source_title","calendarYear":2024,"label":"令和6年度","meaning":"fiscal_year_mentioned","quote":"令和6年度事業の行政評価の結果を公表します／長井市ホームページ"},{"basis":"printed_text","calendarYear":2024,"label":"令和6年度","meaning":"fiscal_year_mentioned","quote":"令和6年度事業の行政評価の結果を公表します／長井市ホームページ 令和6年度事業の行政評価の結果を公表します 更新日：20"},{"basis":"printed_text","calendarYear":2025,"label":"2025年","meaning":"calendar_year_mentioned","quote":"ジ 令和6年度事業の行政評価の結果を公表します 更新日：2025年11月14日 ページID： 15546 行政評価の目的 行政評価は、行政活動の目的を明確にしながら、事業の内容"}]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-11T17:56:32.779392+00:00","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"a36c3a0289e8dc4429c93c5b7fa841ad2996abcecce9986127cac770c857e3a0","state":"acquired"},"evaluationType":"unknown","format":"pdf","id":"6667ef4bf863b9b292eea5d1","role":"evaluation_document","text":{"assetBytes":243658,"assetPath":"documents/6667ef4bf863b9b292eea5d1.json","assetSha256":"ee8b89a45cf5164ad08a8ff12e5bea84e032207e613e92a0da7513faa40a0aa7","characters":94027,"exportedCharacters":94027,"extractionMethod":"cached_extracted_text_hash_verified","inputTextSha256":"c681ca74f3ec66274f70bc85f082559551c65c38239f13d72e95bdc49d2e5093","label":"unstructured_source_text","preview":"令和７年度 行政評価\n主要施策別評価 （令和６年度実施分）\n令和６年度行政評価シート（主要施策）\n担当課： 防災危機管理課\n１．第六次総合計画に基づく施策体系 ４－１．主要施策の担当課長評価（１次評価）\n基本目標 1 安心して健やかに暮らせるまちづくり\n・令和６年度までに５件の協定を締結した。\n分野 ① 防災・危機管理 主要施策 ⑴ 危機管理体制の充実 成果指標の分析 ・さきの能登半島地震で顕在化した課題である、ライフラインの確保や災害ボランティアの円滑な運\n営に関する協定等を締結することで本市防災機能の強化を図ることができた。\n・本市では長井盆地西縁断層帯を震源とする地震災害や豪雨等による災害が想定されます。また、近年は、自然災害の\nほか新たな感染症や周辺事態有事など様々な危機への対応が求められています。これらの危機に対応するべく、市民を\n目指す姿\nはじめ、様々な機関・団体・企業等との連携の構築により危機管理体制を整えることで、多様化する脅威から市民の生\n命と財産を守ります。 ・９月８日に県との合同総合防災訓練を実施し、災害時における防災関係機関との連携体制を確認す\nるとともに地域住民の防災に対する理解と防災意識の高揚を図った。\n２．主要施策の取り組み ・７月２５日の大雨の際等、緊急速報メールや防災ラジオ、コミュニティＦＭ屋外拡声装置等を活用\nし災害情報を迅速かつ確実に伝達した。\n主要施策の成果 ・住宅地へのクマやイノシシの出没、山岳遭難など、人命に関わる事案の発生防止への啓発を実施し\n（定性評価） た。また、事案が発生した際は警察や消防本部と連携し適切に対応した。\n・避難所","status":"available","textSha256":"fcdf3974413bb089b3e26f0eb51c274ecb48631093792b9fcf3e5b2961c8a419","truncated":false},"title":"主要施策別評価シート （基本目標1～3（1～43ページ）） (PDFファイル: 16.3MB)","titleBasis":"official_link_label","url":"https://www.city.nagai.yamagata.jp/material/files/group/2/R6_syuyousisaku1.pdf","verification":{"basis":["directory_host_unique_to_municipality"],"evaluationRelevance":"verified","evidenceSha256":"a36c3a0289e8dc4429c93c5b7fa841ad2996abcecce9986127cac770c857e3a0","evidenceSourceId":"6667ef4bf863b9b292eea5d1","status":"verified"},"years":[{"basis":"printed_text","calendarYear":2025,"label":"令和７年度","meaning":"evaluation_year","quote":"令和７年度 行政評価 主要施策別評価 （令和６年度実施分） 令和６年度行政評価シート（主要施策） 担当課： 防災危機管理"},{"basis":"printed_text","calendarYear":2024,"label":"令和６年度","meaning":"fiscal_year_mentioned","quote":"令和７年度 行政評価 主要施策別評価 （令和６年度実施分） 令和６年度行政評価シート（主要施策） 担当課： 防災危機管理課 １．第六次総合計画に基づく施策体系"},{"basis":"printed_text","calendarYear":2024,"label":"令和６年度","meaning":"evaluation_year","quote":"７年度 行政評価 主要施策別評価 （令和６年度実施分） 令和６年度行政評価シート（主要施策） 担当課： 防災危機管理課 １．第六次総合計画に基づく施策体系 ４－１．主要施策の担"},{"basis":"printed_text","calendarYear":2022,"label":"令和4年度","meaning":"fiscal_year_mentioned","quote":"年ほど遅れて公表される。 よって、現時点での最新データは令和4年度値である。 ・2050年カーボンニュートラルの実現に向けて、地域活性化につながる省エネルギーの推進、再生可能エ"},{"basis":"printed_text","calendarYear":2050,"label":"2050年","meaning":"calendar_year_mentioned","quote":"よって、現時点での最新データは令和4年度値である。 ・2050年カーボンニュートラルの実現に向けて、地域活性化につながる省エネルギーの推進、再生可能エネルギーの導 目指す姿"},{"basis":"printed_text","calendarYear":2027,"label":"令和9年度","meaning":"fiscal_year_mentioned","quote":"新たな形であるバイオガス発電設備が完成し、運用を開始する令和9年度以降、参加世帯 数の拡大を見込んでいる。 ・平成9年に立ち上がったレインボープランによる循環型地域づくり事業は"},{"basis":"printed_text","calendarYear":1997,"label":"平成9年","meaning":"calendar_year_mentioned","quote":"る令和9年度以降、参加世帯 数の拡大を見込んでいる。 ・平成9年に立ち上がったレインボープランによる循環型地域づくり事業は、安全で安心な地場産農産物の普及や環境負 荷の低減、"}]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":null,"inputStatus":"blocked","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"blocked"},"evaluationType":"business_project_evaluation","format":"pdf","id":"95c1f523e1469e935509e029","role":"supporting_document","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":null,"label":"unstructured_source_text","preview":null,"status":"not_acquired","textSha256":null,"truncated":false},"title":"事務事業別評価シート （基本目標1～3（1～60ページ）） (PDFファイル: 13.0MB)","titleBasis":"official_link_label","url":"https://www.city.nagai.yamagata.jp/material/files/group/2/R6_jimujigyou1.pdf","verification":{"basis":["literal_link_in_verified_official_page","same_municipality_official_host"],"evaluationRelevance":"verified","evidenceSha256":"7246b2f8a81507846cf4f039ec2e1068572876f77a8269ac02f5cb2f0ee96c62","evidenceSourceId":"6440ba0c75efd9e020722471","status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":403,"inputStatus":"blocked","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"blocked"},"evaluationType":"unknown","format":"pdf","id":"f5f2b0647181744caa49b84a","role":"supporting_document","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":null,"label":"unstructured_source_text","preview":null,"status":"not_acquired","textSha256":null,"truncated":false},"title":"主要施策別評価シート （基本目標4～5（44～74ページ）） (P