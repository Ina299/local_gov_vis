{"discovery":{"coverageCompleteness":"not_established","initialLook":true,"omittedRejectedSources":0,"searchAttemptsCount":0,"status":"fetched"},"evaluationPages":["09dbdd748d4a0caede5f6f1d","4fab6c638ba8600bbdc43ec3","a9aeb7e393e00cf267564eb9","6023d3af78445d94848d2134","0d3a4a6f03f94a698662080d"],"municipality":{"municipalityCode":"28204","municipalityName":"西宮市","prefectureCode":"28","prefectureName":"兵庫県"},"officialDirectoryLinks":[{"evidenceSha256":"928307667dde46f5f7943058c93515865a69e72c14eb4fc804c7acf73bc45887","evidenceUrl":"https://www.digital.go.jp/assets/contents/node/basic_page/field_ref_resources/2b1128e2-c699-4aa0-9206-37169a6697c8/3d2142af/20260630_resources_opendata_lg_list_02.csv","kind":"official_directory_page","title":"西宮市 公式オープンデータページ","url":"http://opendata.nishi.or.jp/opendata/Menu.aspx","verificationBasis":"national_government_directory_municipality_mapping"}],"officialFallback":{"evidenceSha256":"928307667dde46f5f7943058c93515865a69e72c14eb4fc804c7acf73bc45887","evidenceUrl":"https://www.digital.go.jp/assets/contents/node/basic_page/field_ref_resources/2b1128e2-c699-4aa0-9206-37169a6697c8/3d2142af/20260630_resources_opendata_lg_list_02.csv","kind":"official_directory_page","title":"西宮市 公式オープンデータページ","url":"http://opendata.nishi.or.jp/opendata/Menu.aspx","verificationBasis":"national_government_directory_municipality_mapping"},"officialHomepage":null,"schemaVersion":1,"sources":[{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-11T17:44:40.937051+00:00","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"ae5d9e11a1445308d80b6d8401cfcf7a46720e5df30936be36a52d45f482a545","state":"acquired"},"evaluationType":"business_project_evaluation","format":"html","id":"09dbdd748d4a0caede5f6f1d","role":"evaluation_landing_page","text":{"assetBytes":5751,"assetPath":"documents/09dbdd748d4a0caede5f6f1d.json","assetSha256":"cb57579b52721e4c5de4412d728d732f21c5971ac7d7a4e50379a920a47f4172","characters":1938,"exportedCharacters":1938,"extractionMethod":"visible_html_utf8_from_verified_bytes","inputTextSha256":"ae5d9e11a1445308d80b6d8401cfcf7a46720e5df30936be36a52d45f482a545","label":"unstructured_source_text","preview":"事務事業評価｜西宮市ホームページ\n事務事業評価\n更新日：2026年10月6日\nページ番号：99090677\n事務事業評価について\n西宮市では平成15年度より「事務事業評価」を実施しています。令和8年度には、より持続可能な行財政運営を目指して手法を見直しました。従来の事務事業単位から、第5次西宮市総合計画の「施策における取組内容」単位へ評価の視点を引き上げ、事業改善や次年度予算編成につながる実効性のある仕組みづくりを進めています。\n事務事業評価の目的\n（1）市民満足度の高い行政サービスの提供\n市の事務事業を予算の執行率や事業の進捗度という観点からだけでなく、目的に対する成果や達成度の観点からも評価・改善し、効率的なサービスを提供します。\n（2）行政の透明性と説明責任\n客観的な指標による評価結果を公表し、行政の透明性の向上を図るとともに市民への説明責任を果たします。\n（3）職員の意識改革\n評価を通じて、職員が事業の目的やコスト意識を高めます。\n事務事業評価の活用\n(1)事業の見直し\n実績や成果等を客観的な基準（活動指標・成果指標）を用いて評価するほか、成果との費用対効果（人件費を含む）を年次検証し、今後の事業方針を決定するための根拠として用います。\n(2)予算への反映\n予算編成から決算までの過程に評価結果を反映させ、PLAN（計画）－DO（実行）－CHECK（評価）－ACTION（改善）というマネジメントサイクル（PDCAサイクル）を回すことで、施策の推進と持続可能な市政運営の両立を図ります。\n令和8年度の評価結果\n事務事業評価結果報告書（表紙ー令和8年度取組内容別評価シート・事務","status":"available","textSha256":"32fef7e5f6b605e0ac45a0159f8b965b1ffa14001976c6cd4485c880fcfe7171","truncated":false},"title":"事務事業評価｜西宮市ホームページ","titleBasis":"html_title","url":"https://www.nishi.or.jp/shisei/gyoseikeiei/gyoseihyoka/hyokakekka.html","verification":{"basis":["保存済み原本のハッシュ・自治体名を再確認","公式機関の参照先と発信元を照合","文字コードを確認して本文を再抽出"],"evaluationRelevance":"verified","evidenceSha256":"ae5d9e11a1445308d80b6d8401cfcf7a46720e5df30936be36a52d45f482a545","evidenceSourceId":"09dbdd748d4a0caede5f6f1d","status":"verified"},"years":[{"basis":"printed_text","calendarYear":2026,"label":"2026年","meaning":"calendar_year_mentioned","quote":"事務事業評価｜西宮市ホームページ 事務事業評価 更新日：2026年10月6日 ページ番号：99090677 事務事業評価について 西宮市では平成15年度より「事務事業評価」を実"},{"basis":"printed_text","calendarYear":2003,"label":"平成15年度","meaning":"fiscal_year_mentioned","quote":"番号：99090677 事務事業評価について 西宮市では平成15年度より「事務事業評価」を実施しています。令和8年度には、より持続可能な行財政運営を目指して手法を見直しました。従"},{"basis":"printed_text","calendarYear":2026,"label":"令和8年度","meaning":"fiscal_year_mentioned","quote":"市では平成15年度より「事務事業評価」を実施しています。令和8年度には、より持続可能な行財政運営を目指して手法を見直しました。従来の事務事業単位から、第5次西宮市総合計画の「施"},{"basis":"printed_text","calendarYear":2026,"label":"令和8年度","meaning":"evaluation_year","quote":"とで、施策の推進と持続可能な市政運営の両立を図ります。 令和8年度の評価結果 事務事業評価結果報告書（表紙ー令和8年度取組内容別評価シート・事務事業シート一覧） 事務事業評価結"},{"basis":"printed_text","calendarYear":2025,"label":"令和7年度","meaning":"evaluation_year","quote":"（V、VI、VII、資料）（PDF：48,458KB） 令和7年度の評価結果 事務事業評価結果報告書（I）：政策局、総務局、財務局、会計室、消防局、議会事務局、監査事務局、選挙"},{"basis":"printed_text","calendarYear":2024,"label":"令和6年度","meaning":"evaluation_year","quote":"る8年度当初予算措置状況等調（PDF：1,367KB） 令和6年度の評価結果 事務事業評価結果報告書（I）：政策局、総務局、財務局、会計室、消防局、議会事務局、監査事務局、選挙"}]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":null,"inputStatus":"discovered","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"discovered"},"evaluationType":"business_project_evaluation","format":"html","id":"4fab6c638ba8600bbdc43ec3","role":"evaluation_landing_page","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":null,"label":"unstructured_source_text","preview":null,"status":"not_acquired","textSha256":null,"truncated":false},"title":"行政評価","titleBasis":"official_link_label","url":"https://www.nishi.or.jp/shisei/gyoseikeiei/gyoseihyoka/index.html","verification":{"basis":["保存済み公式ページにあるリンクを確認（リンク先原本は未取得）"],"evaluationRelevance":"verified","evidenceSha256":"ae5d9e11a1445308d80b6d8401cfcf7a46720e5df30936be36a52d45f482a545","evidenceSourceId":"09dbdd748d4a0caede5f6f1d","status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":null,"inputStatus":"discovered","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"discovered"},"evaluationType":"business_project_evaluation","format":"pdf","id":"a0599010c5edbef49dfed022","role":"evaluation_document","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exp