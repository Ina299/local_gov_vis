ontent=241","verification":{"basis":["national_government_directory_host_only"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"official_host_only"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T11:34:34.778Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"4834aba6322d843f115109d3ddb6e648ed58eb449d808f14943bf8a34bbd4f82","state":"acquired"},"evaluationType":"education_inspection","format":"pdf","id":"c11a3d09c8c9173294b363d5","navigationReview":{"checkedAt":"2026-10-21T06:00:00Z","evidenceUrl":"https://www.town.naganohara.gunma.jp/education/?content=241","method":"official_body_review","notes":"教育委員会点検・評価報告書。","originEvidenceUrl":null,"publisher":"長野原町","rawArchiveState":"collected","yearNotes":"令和7年度（タイトル）"},"role":"supporting_document","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":"4834aba6322d843f115109d3ddb6e648ed58eb449d808f14943bf8a34bbd4f82","label":"unstructured_source_text","preview":null,"status":"no_readable_text","textSha256":null,"truncated":false},"title":"教育委員会の点検・評価に関する報告書（令和7年度）","titleBasis":"inventory_title","url":"https://www.town.naganohara.gunma.jp/assets/images/content/content_20260307_190001.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T11:34:36.908Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"90154ecc002dbeaa43de5a63579ec5a77d9705c5d90f36a162577851d1928648","state":"acquired"},"evaluationType":"education_inspection","format":"pdf","id":"6f316be17db61089bac371e2","navigationReview":{"checkedAt":"2026-10-21T06:00:00Z","evidenceUrl":"https://www.town.naganohara.gunma.jp/education/?content=241","method":"official_body_review","notes":"教育委員会点検・評価報告書。","originEvidenceUrl":null,"publisher":"長野原町","rawArchiveState":"collected","yearNotes":"令和6年度（タイトル）"},"role":"supporting_document","text":{"assetBytes":25682,"assetPath":"documents/6f316be17db61089bac371e2.json","assetSha256":"28b1fc88bff7c97a1bb0fa6de5b073dafb9d4a12fdb513e62a63d226e71b845d","characters":9072,"exportedCharacters":9072,"extractionMethod":"pdftotext_from_verified_bytes","inputTextSha256":"90154ecc002dbeaa43de5a63579ec5a77d9705c5d90f36a162577851d1928648","label":"unstructured_source_text","preview":"（令和６年度）\n教育委員会の点検・評価に関する報告書\n\n令和6年12月\n長野原町教育委員会\n\n\n目\n\n次\n\n令和６年度教育委員会の概要\n\n１\n\n１，「点検・評価」の趣旨\n\n２\n\n２，「点検・評価」の内容等（令和５年度）\n\n３\n\n３，「点検・評価」事項（令和５年度）\n\n４\n\n区分（１）教育委員会の活動\n\n５\n\n区分（２）教育委員会が管理・執行する事務\n\n７\n\n区分（３）教育委員会が管理・執行を教育長に委任する事務\n①学校教育事業\n９\n②こども園事業\n\n１０\n\n③学校給食事業\n\n１１\n\n④社会教育事業\n\n１１\n\n⑤文化財事業\n\n１３\n\n\n令和６年度教育委員会の概要\n（１）教育委員会の趣旨\n教育委員会は、地方自治の理念のもとに教育の政治的中立性と安定性を確保す\nるために、地方公共団体の長から独立して設置される機関です。教育長及び4人の\n委員で構成され、この5人の合議により、教育行政の運営に関する基本方針や重要\n施策の決定を行います。\n（２）教育委員会制度の仕組み\n１） 教育委員会は、学校教育に関わること、社会教育に関わること、文化・\nスポーツ等に関わること等の事務を担当する機関として設置されています。\n２） 首長から独立した行政委員会としての位置づけです。\n３） 教育委員会は、教育行政における重要事項や基本方針を決定し、それに\n基づいて教育長が具体的に事務を執行します。\n４） 教育長は、地方公共団体の長が議会の同意を得て任命します。任期は3年\nで、再任は可能です。\n５） 教育委員は、地方公共団体の長が議会の同意を得て任命します。任期は4\n年で、再任は可能です。\n６） 教育長の職務は、教育委員会の会議を主宰すること並びに教育委員会の\n意思決定に基づき教育委員会の権限に属するすべての事務をつかさどり、\n事務局の事務を統括し、所属の職員を指揮監督します。\n７） 平成27年度の法律改正により、総合教育会議が設置され、首長と教育委員\n会の連携が強化されました。首長と教育委員会が協議･調整をし、教育大綱\nの策定を行うなど、教育政策の方向性を共有し、一致して執行にあたるこ\nととなっています。\n（３）町教育委員会の教育長及び委員の定数\n令和6年12月1日現在、教育長1名、委員定数は4人で以下の通りです。\n教育長・委員\n\n氏\n\n名\n\n教育長\n\n小林\n\n敦子\n\n教育長職務代理者（委員）\n\n吉","status":"available","textSha256":"dbb102282b774a9a032cc5748cdc8f1cbe7b8813658b3d7eb4f002695be8331c","truncated":false},"title":"教育委員会の点検・評価に関する報告書（令和6年度）","titleBasis":"inventory_title","url":"https://www.town.naganohara.gunma.jp/assets/images/content/content_20260307_185959.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T11:34:42.230Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"1d078d05fa998a5f02f94b5ddc8ec77db23d38d3b76a6cb2a0be7fc2e8a64a95","state":"acquired"},"evaluationType":"education_inspection","format":"pdf","id":"e637f13a76bd5f9f842c82c7","navigationReview":{"checkedAt":"2026-10-21T06:00:00Z","evidenceUrl":"https://www.town.naganohara.gunma.jp/education/?content=241","method":"official_body_review","notes":"教育委員会点検・評価報告書。","originEvidenceUrl":null,"publisher":"長野原町","rawArchiveState":"collected","yearNotes":"令和5年度（タイトル）"},"role":"supporting_document","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":"1d078d05fa998a5f02f94b5ddc8ec77db23d38d3b76a6cb2a0be7fc2e8a64a95","label":"unstructured_source_text","preview":null,"status":"no_readable_text","textSha256":null,"truncated":false},"title":"教育委員会の点検・評価に関する報告書（令和5年度）","titleBasis":"inventory_title","url":"https://www.town.naganohara.gunma.jp/assets/images/content/content_20260307_185957.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T11:34:44.885Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"11c14ebfcc44d88bd7f54cab2fc1246c56932619f015bd18a1cdff61474bf203","state":"acquired"},"evaluationType":"education_inspection","format":"pdf","id":"8c6b178e86f5a90a98732cdd","navigationReview":{"checkedAt":"2026-10-21T06:00:00Z","evidenceUrl":"https://www.town.naganohara.gunma.jp/education/?conten