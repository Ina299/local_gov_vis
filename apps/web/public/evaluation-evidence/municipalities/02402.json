town.shichinohe.lg.jp/gyosei/591ae49ae4fda3028b7a287c824eef0f.pdf","verification":{"basis":["literal_link_in_verified_official_page","same_municipality_official_host"],"evaluationRelevance":"not_established","evidenceSha256":"db22b152f59ea79fc0d6c667690a2f9eee1d6d338b23c5b03dcbeeb213ec50f8","evidenceSourceId":"1ab4751b3a16d00ff82a6fb5","status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-11T17:45:01.848542+00:00","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"db22b152f59ea79fc0d6c667690a2f9eee1d6d338b23c5b03dcbeeb213ec50f8","state":"acquired"},"evaluationType":"business_project_evaluation","format":"html","id":"1ab4751b3a16d00ff82a6fb5","role":"official_page","text":{"assetBytes":11254,"assetPath":"documents/1ab4751b3a16d00ff82a6fb5.json","assetSha256":"9ed7526aaa1acea350f060168ec4cda6667e402a15517aff91d6bfd3ca550cad","characters":3755,"exportedCharacters":3755,"extractionMethod":"visible_html_from_verified_bytes","inputTextSha256":"db22b152f59ea79fc0d6c667690a2f9eee1d6d338b23c5b03dcbeeb213ec50f8","label":"unstructured_source_text","preview":"、\nその方法について意見・アイデアの抽出を\n行いました。\n・報告書：\n第3回 七高生WS報告書.pdf\n以上で全３回の高校生ワークショップは終了しました。\n４\n事務事業評価\n第２次七戸町長期総合計画に基づく事務事業の進捗状況を評価・検証するため第三者による事業評価を実施しました。\n・報告書：\n事務事業評価.pdf\n５ 七戸町総合開発審議会\n本審議会は、町の総合開発計画の策定に関する重要事項について調査審議する町の諮問機関です。\n１ 第１回七戸町総合開発審議会\n令和７年６月１７日、第１回七戸町総合開発審議会を開催しました。\n当日は、①委嘱状の交付、②会長及び副会長の選任、③町から委員会への諮問、④七戸町長期総合計画策定\nにかかる概要等の\n説明を行いました。\n選任された会長及び副会長は次のとおりです。\n・会 長 田中 清一 氏（七戸町商工会 会長）\n・副会長 天間 優彦 氏（七戸町文化協会 会長）\n会議資料及び会議録につきましては、下記ダウンロードファイルをご覧ください。\n【写真は、田中会長（右）へ諮問書を読み上げる田嶋町長（左）】\n〇ダウンロードファイル\n・\n第1回七戸町総合開発審議会資料（R7.6.17開催）.pdf\n・\n第1回七戸町総合開発審議会会議録（R7.6.17開催）.pdf\n２ 第２回七戸町総合開発審議会\n令和７年９月３日、第２回七戸町総合開発審議会を開催しました。\n当日は、第３次七戸町長期総合計画のうち『基本構想』部分の審議\nを行いました。\n会議資料及び会議録につきましては、下記ダウンロードファイルをご覧ください。\n〇ダウンロードファイル\n・\n第2回七戸町総合開発審","status":"available","textSha256":"1ad8ddbcd3a8582b2f3dc43cf7d213c410e78aa6ef6a34656db3d14dd874f6f7","truncated":false},"title":"第３次七戸町長期総合計画の策定について ｜ 町政情報 ｜ 青森県七戸町～ともに育み 未来へつなぐ 田園文化都市しちのへ","titleBasis":"html_title","url":"https://www.town.shichinohe.lg.jp/gyosei/keikaku/post-327.html","verification":{"basis":["official_host_pattern","exact_municipality_name_in_verified_source","prefecture_or_unique_name_disambiguated"],"evaluationRelevance":"verified","evidenceSha256":"db22b152f59ea79fc0d6c667690a2f9eee1d6d338b23c5b03dcbeeb213ec50f8","evidenceSourceId":"1ab4751b3a16d00ff82a6fb5","status":"verified"},"years":[{"basis":"printed_text","calendarYear":2026,"label":"2026年","meaning":"calendar_year_mentioned","quote":"ちのへ 第３次七戸町長期総合計画の策定について 公開日 2026年02月10日 更新日 2026年02月10日 ポストする 共有する このページを印刷する 七戸町では、令和６年"},{"basis":"printed_text","calendarYear":2024,"label":"令和６年度","meaning":"fiscal_year_mentioned","quote":"ポストする 共有する このページを印刷する 七戸町では、令和６年度と令和７年度の２か年で、令和８年度から令和１７年度までの１０年間の町の未来や方向を描く「第３次七戸町長期総合計"},{"basis":"printed_text","calendarYear":2025,"label":"令和７年度","meaning":"fiscal_year_mentioned","quote":"共有する このページを印刷する 七戸町では、令和６年度と令和７年度の２か年で、令和８年度から令和１７年度までの１０年間の町の未来や方向を描く「第３次七戸町長期総合計画」の策定に"},{"basis":"printed_text","calendarYear":2026,"label":"令和８年度","meaning":"fiscal_year_mentioned","quote":"印刷する 七戸町では、令和６年度と令和７年度の２か年で、令和８年度から令和１７年度までの１０年間の町の未来や方向を描く「第３次七戸町長期総合計画」の策定に取り組んでいます。 策"},{"basis":"printed_text","calendarYear":2035,"label":"令和１７年度","meaning":"fiscal_year_mentioned","quote":"町では、令和６年度と令和７年度の２か年で、令和８年度から令和１７年度までの１０年間の町の未来や方向を描く「第３次七戸町長期総合計画」の策定に取り組んでいます。 策定に当たって、よ"},{"basis":"printed_text","calendarYear":2024,"label":"令和６年","meaning":"calendar_year_mentioned","quote":"として反映させることを目的としています。 （１）参加者 令和６年８月に町広報紙や町ウェブサイトで参加者を募った結果、１人の応募がありました。 また、町関係機関等から推薦いただ"},{"basis":"printed_text","calendarYear":2025,"label":"令和７年","meaning":"calendar_year_mentioned","quote":"S 報告書.pdf 第４回町民ワークショップ ・日 時：令和７年１月２４日（金） ・場 所：七戸町役場本庁舎 第１・２会議室 ・内 容：第３回目までに話し合われた成果を参加者"},{"basis":"printed_text","calendarYear":2026,"label":"令和８年","meaning":"calendar_year_mentioned","quote":"1.19開催）.pdf ４ 第４回七戸町総合開発審議会 令和８年２月２日、第４回七戸町総合開発審議会を開催しました。 当日は、①パブリックコメントの結果報告、②第３次七戸町長"},{"basis":"printed_text","calendarYear":2016,"label":"平成２８年度","meaning":"fiscal_year_mentioned","quote":"ました。 参考資料（第２次七戸町長期総合計画（計画期間：平成２８年度～令和７年度）） ・ 第２次七戸町長期総合計画（本編）.pdf ・ 第２次七戸町長期総合計画（概要版）.pdf"}]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":null,"inputStatus":"blocked","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"blocked"},"evaluationType":"unknown","format":"pdf","id":"1f7a03b205767ac27a9bd3a5","role":"supporting_document","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":null,"label":"unstructured_source_text","preview":null,"status":"not_acquired","textSha256":null,"truncated":false},"title":"第3回 七高生WS報告書.pdf","titleBasis":"official_link_label","url":"https://www.town.shichinohe.lg.jp/gyosei/9c912bf9ae1828f3b7d1acb273975cd2_1.pdf","verification":{"basis":["literal_link_in_verified_official_page","same_municipality_official_host"],"evaluationRelevance":"not_established","evidenceSha256":"db22b152f59ea79fc0d6c667690a2f9eee1d6d338b23c5b03dcbeeb213ec50f8","evidenceSourceId":"1ab4751b3a16d00ff82a6fb5","status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":null,"inputStatus":"blocked","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"blocked"},"evaluationType":"unknown","format":"pdf","id":"29fbd30dc66f3a4e7a730d4d","role":"supporting_document","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":null,"label":"unstructured_source_text","preview":null,"status":"not_acquired","textSha256":null,"truncated":false},"title":"第３次七戸町長期総合計画（基本構想編）案.pdf","titleBasis":"official_link_label","url":"https://www.town.shichinohe.lg.jp/gyosei/aa43d4808eace4a997739ed12964afda_2.pdf","verification