fficial_link_label","url":"https://www.town.shichinohe.lg.jp/gyosei/a704d3415e5ee3c3a5f7905fda49d907.pdf","verification":{"basis":["literal_link_in_verified_official_page","same_municipality_official_host"],"evaluationRelevance":"not_established","evidenceSha256":"db22b152f59ea79fc0d6c667690a2f9eee1d6d338b23c5b03dcbeeb213ec50f8","evidenceSourceId":"1ab4751b3a16d00ff82a6fb5","status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-11T17:55:09.079435+00:00","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"c934b4eea7ae748ff2afeaf7bb587370c660ed2f465468b9513eba32d188a3c1","state":"acquired"},"evaluationType":"unknown","format":"pdf","id":"c50edb3bbdb20f841c42e714","role":"supporting_document","text":{"assetBytes":2965,"assetPath":"documents/c50edb3bbdb20f841c42e714.json","assetSha256":"9cab98335025d945320cf0dd06a2cd04480f9df8b1ac7c1a319db0be8e3b49f5","characters":811,"exportedCharacters":811,"extractionMethod":"cached_extracted_text_hash_verified","inputTextSha256":"88be28efef1a297caa62f87dd2cd51d5104abce22b91f6ebd61fe7f226a6cf91","label":"unstructured_source_text","preview":"第3次七戸町長期総合計画策定のための\n町民ワークショップ報告書\n 町民ワークショップの目的と趣旨\n第3次七戸町長期総合計画の策定に向けて、七戸町民やこれからの行政を担う若い行\n政職員の、まちづくりに対する想いをきくための機会として開催しました。\nワークショップを通じて七戸町の現状に共通の認識を持ち、より良い七戸町として\nいくための方法について参加者間の理解を深めます。そして、七戸町の将来像につい\nて意見やアイデアを抽出し、計画策定のための基礎資料として反映させることを目的\nとします。\n 各回の開催概要と実施の様子\n第１回 オリエンテーション\n（1）日 時 令和6年10月22日(火) 18：00～18：45\n（2）場 所 七戸町役場本庁舎 第1・2会議室\n（3）参加者 16名 （七戸町民8名、七戸町役場職員8名）\n（4）次 第\n① あいさつ\n② 参加者自己紹介\n③ オリエンテーション\n・ワークショップ開催目的の説明\n・ワークショップ開催時期及び各回の会議概要の説明\n・ワークショップ注意事項の説明\n④ 質疑応答\n⑤ その他\n（5）実施内容\n① あいさつ\n・七戸町役場企画調整課 田中課長による挨拶。\n② 参加者自己紹介\n・参加者16名、七戸町役場企画調整課３名、アール・エー・ビー開発株式会社３名が、\n一人ずつ自己紹介を行いました。\n・欠席者４名については、事務局より紹介されました。\n③ オリエンテーション\n・ワークショップ開催の目的について説明を行いました。\n・全４回のワークショップがどのような流れで進むのか、各回の開催時期と会議概要に\nついて説明を行いました。\n・グループワーク","status":"available","textSha256":"ba15e56339620ee819cb10fed75249a93692085ade2c3ae1c04fcbb9a7f57d28","truncated":false},"title":"第1回町民WS 報告書.pdf","titleBasis":"official_link_label","url":"https://www.town.shichinohe.lg.jp/gyosei/8c8f9ecd758b8a276166167347fd3b11.pdf","verification":{"basis":["official_host_pattern","exact_municipality_name_in_verified_source","prefecture_or_unique_name_disambiguated"],"evaluationRelevance":"not_established","evidenceSha256":"c934b4eea7ae748ff2afeaf7bb587370c660ed2f465468b9513eba32d188a3c1","evidenceSourceId":"c50edb3bbdb20f841c42e714","status":"verified"},"years":[{"basis":"printed_text","calendarYear":2024,"label":"令和6年","meaning":"calendar_year_mentioned","quote":"と実施の様子 第１回 オリエンテーション （1）日 時 令和6年10月22日(火) 18：00～18：45 （2）場 所 七戸町役場本庁舎 第1・2会議室 （3）参加者 16"}]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":null,"inputStatus":"blocked","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"blocked"},"evaluationType":"business_project_evaluation","format":"pdf","id":"ca1af34404519b878e74dadd","role":"supporting_document","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":null,"label":"unstructured_source_text","preview":null,"status":"not_acquired","textSha256":null,"truncated":false},"title":"事務事業評価.pdf","titleBasis":"official_link_label","url":"https://www.town.shichinohe.lg.jp/gyosei/5d120d93c5219d098ab28a9ff12f4728.pdf","verification":{"basis":["literal_link_in_verified_official_page","same_municipality_official_host"],"evaluationRelevance":"verified","evidenceSha256":"db22b152f59ea79fc0d6c667690a2f9eee1d6d338b23c5b03dcbeeb213ec50f8","evidenceSourceId":"1ab4751b3a16d00ff82a6fb5","status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":null,"inputStatus":"blocked","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"blocked"},"evaluationType":"unknown","format":"pdf","id":"ee7b6f2a907e6f89d2dc71b0