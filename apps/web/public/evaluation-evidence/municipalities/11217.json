{"discovery":{"coverageCompleteness":"not_established","initialLook":true,"omittedRejectedSources":0,"searchAttemptsCount":0,"status":"fetched"},"evaluationPages":["0109a8d6bf89a73211873864"],"municipality":{"municipalityCode":"11217","municipalityName":"鴻巣市","prefectureCode":"11","prefectureName":"埼玉県"},"officialDirectoryLinks":[{"evidenceSha256":"928307667dde46f5f7943058c93515865a69e72c14eb4fc804c7acf73bc45887","evidenceUrl":"https://www.digital.go.jp/assets/contents/node/basic_page/field_ref_resources/2b1128e2-c699-4aa0-9206-37169a6697c8/3d2142af/20260630_resources_opendata_lg_list_02.csv","kind":"official_directory_page","title":"鴻巣市 公式オープンデータページ","url":"http://www.city.kounosu.saitama.jp/opendata/","verificationBasis":"national_government_directory_municipality_mapping"}],"officialFallback":{"evidenceSha256":"928307667dde46f5f7943058c93515865a69e72c14eb4fc804c7acf73bc45887","evidenceUrl":"https://www.digital.go.jp/assets/contents/node/basic_page/field_ref_resources/2b1128e2-c699-4aa0-9206-37169a6697c8/3d2142af/20260630_resources_opendata_lg_list_02.csv","kind":"official_directory_page","title":"鴻巣市 公式オープンデータページ","url":"http://www.city.kounosu.saitama.jp/opendata/","verificationBasis":"national_government_directory_municipality_mapping"},"officialHomepage":null,"schemaVersion":1,"sources":[{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-11T17:48:15.732857+00:00","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"a120436bff4a605ba99444bdb243deefe3fec92296aa748a9873394211a60bba","state":"acquired"},"evaluationType":"business_project_evaluation","format":"html","id":"0109a8d6bf89a73211873864","role":"evaluation_landing_page","text":{"assetBytes":4235,"assetPath":"documents/0109a8d6bf89a73211873864.json","assetSha256":"c2ac8497b2f2d71753d03e1db77d7cc90c129e0a0a92ba9690d97e01329567e4","characters":1444,"exportedCharacters":1444,"extractionMethod":"visible_html_from_verified_bytes","inputTextSha256":"a120436bff4a605ba99444bdb243deefe3fec92296aa748a9873394211a60bba","label":"unstructured_source_text","preview":"施策・基本事業評価（まちづくり報告書）《令和6年度版》 - 鴻巣市公式ホームページ（総合政策課）\n本文\n市では、行財政運営の最上位計画として「総合振興計画」を定め、この中で「何を」「いつまでに」「どこまで」進めていくのか、また、進んでいるのかを明らかにするため、成果指標を設定しています。\nこの「まちづくり報告書」は、設定した各指標の数値の推移から、まちづくりの達成度を報告するものです。\n今回、報告する内容は、第6次鴻巣市総合振興計画後期基本計画の3年目である令和6年度の実績について、基準値と比較して評価しています。\n令和6年度まちづくり報告書（前文） （PDF：2.07MB）\n以下に、第6次鴻巣市総合振興計画の体系（各施策ごと）の順で、施策・基本事業別評価表が閲覧できます。\nご覧になりたい施策の名称をクリックしてください。\n政策・施策一覧\n将来都市像 「花かおり 緑あふれ 人輝くまち こうのす」\n政策番号1 子育て・教育・文化に関する政策\n～未来をひらく人材を育て、確かな学びと文化が根付くまちづくり～\n出産・子育て支援の充実 （PDF：5.13MB）\n学校教育の充実 （PDF：5.15MB）\n青少年の健全育成 （PDF：5.12MB）\n市民文化・生涯学習の充実 （PDF：5.13MB）\nスポーツの振興 （PDF：5.12MB）\n政策番号2 保健・福祉・医療に関する政策\n～いきいきと健康で充実した生活を過ごせるまちづくり～\n健康づくりの推進 （PDF：5.14MB）\n地域福祉の推進 （PDF：5.12MB）\n高齢者福祉の推進 （PDF：5.14MB）\n障がい者（児）福祉の充実 （","status":"available","textSha256":"a480486fa41331fd4b8923096e32abf0c797d4a07cc820374aab637e8b0bf573","truncated":false},"title":"施策・基本事業評価（まちづくり報告書）《令和6年度版》 - 鴻巣市公式ホームページ（総合政策課）","titleBasis":"html_title","url":"https://www.city.kounosu.saitama.jp/page/37045.html","verification":{"basis":["directory_host_unique_to_municipality"],"evaluationRelevance":"verified","evidenceSha256":"a120436bff4a605ba99444bdb243deefe3fec92296aa748a9873394211a60bba","evidenceSourceId":"0109a8d6bf89a73211873864","status":"verified"},"years":[{"basis":"source_title","calendarYear":2024,"label":"令和6年度","meaning":"fiscal_year_mentioned","quote":"施策・基本事業評価（まちづくり報告書）《令和6年度版》 - 鴻巣市公式ホームページ（総合政策課）"},{"basis":"printed_text","calendarYear":2024,"label":"令和6年度","meaning":"fiscal_year_mentioned","quote":"施策・基本事業評価（まちづくり報告書）《令和6年度版》 - 鴻巣市公式ホームページ（総合政策課） 本文 市では、行財政運営の最上位計画として「総合振興計画」を定"}]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":null,"inputStatus":"blocked","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"blocked"},"evaluationType":"unknown","format":"pdf","id":"163a4f57b491cf439fbbe8e5","role":"supporting_docume