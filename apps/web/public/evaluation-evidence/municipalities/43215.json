tml","verification":{"basis":[],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"unverified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":null,"inputStatus":"discovered","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"discovered"},"evaluationType":"unknown","format":"pdf","id":"e0b530146bd9c94f11351022","role":"candidate","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedCharacters":0,"extractionMethod":null,"inputTextSha256":null,"label":"unstructured_source_text","preview":null,"status":"not_acquired","textSha256":null,"truncated":false},"title":"１ 資料２－１ 第２次天草市総合計画における 行政評価について 総合政策部政策企画課 ２ １総合計画","titleBasis":"inventory_title","url":"https://www.city.amakusa.kumamoto.jp/kiji0038817/3_8817_34186_up_28c1j2vc.pdf","verification":{"basis":["national_government_directory_host_only"],"evaluationRelevance":"not_established","evidenceSha256":null,"evidenceSourceId":null,"status":"official_host_only"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-21T08:46:05.835Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"724ccf5ce7406ea96e6961e3203bf070bccdf45f7e0a61892b83a487535cb37e","state":"acquired"},"evaluationType":"business_project_evaluation","format":"pdf","id":"d32485e691a01bab89168c4e","navigationReview":{"checkedAt":"2026-10-12T12:19:36.041536+00:00","evidenceUrl":"https://www.city.amakusa.kumamoto.jp/kiji0031888/3_1888_5_up_s0ttyciv.pdf","method":"official_body_review","notes":"市の約1,400事務事業の内部評価から20事業を外部評価し最終評価。観光協会補助金等の縮小・改善方針を確認。歴史的広報で対象年度は本文末尾等の確認範囲に依存。 not_established_beyond_title_and_brief_evidence 確認範囲：Supported Web extracted text sampled; no locally archived full text.","originEvidenceUrl":"https://www.city.amakusa.kumamoto.jp/kiji0038024/index.html","publisher":"天草市","rawArchiveState":"collected","yearNotes":"Historical newsletter; exact assessment year not yet established from sampled text."},"role":"evaluation_document","text":{"assetBytes":7915,"assetPath":"documents/d32485e691a01bab89168c4e.json","assetSha256":"c1994257912ac94f7295141601d11a07b9edd1a60a9d7404c32aa0f69b23ae8c","characters":2553,"exportedCharacters":2553,"extractionMethod":"pdftotext_from_verified_bytes","inputTextSha256":"724ccf5ce7406ea96e6961e3203bf070bccdf45f7e0a61892b83a487535cb37e","label":"unstructured_source_text","preview":"行 財 政 改 革 事務事業評価を行いました\n\n事\n\n業\n\n名\n\n職員研修事業\n\n改善\n\n今後の市の方針\n\n改善\n\n行財政改革などの研修をさらに充実し、職員の意識改\n革を行う。\n\n天草市庁舎建設事業\n\n縮小\n\n改善\n\n縮小する方向で検討を行うが、具体的な規模や事業費\nについては、今後見直される市職員の定員適正化計画\nやワークショップ（研究集会）などにより、市民の意\n見を聞きながら進めていく。\n\n外出支援サービス事業\n\n改善\n\n改善\n\n「天草市公共交通連携計画」に基づき、公共交通全体に\nついて一体的に見直しを進める。\n\nスクールバス運行事業\n\n改善\n\n改善\n\n児童・生徒の安心安全を第一に、通学の利便性を損な\nわない範囲で、「天草市公共交通連携計画」に基づき公\n共交通全体について一体的に見直しを進める。\n\n乗合自動車運行事業\n\n改善\n\n改善\n\n「天草市公共交通連携計画」に基づき、公共交通全体に\nついて一体的に見直しを進める。\n\nNPO 支援事業\n\n拡充\n\n拡充\n\n情報の受発信や相談業務の拡充など、\n「サポートセン\nター」としての支援機能体制を充実する。\n\n天草国際トライアスロン大会\n\n改善\n\n改善\n\n観光客の誘致に関する総合的な取り組みを推進するこ\nとにより、さらなる地域発展につなげていく。\n\n観光イベント実施事業\n\n縮小\n\n改善\n\n補助金については、補助額・補助率ともにばらつきが\nあるため見直す。イベントについては、検討体制を構\n築して全庁的に見直しを行う。\n\n花しょうぶまつり事業\n\n改善\n\n改善\n\n雨天対策なども含めさらなる検討を行う。イベントに\nついては、検討体制を構築して全庁的に見直しを行う。\n\n物産地域イベント開催補助金\n\n改善\n\n改善\n\n事業内容を精査し、補助金の見直しを図る。イベント\nについては、検討体制を構築して全庁的に見直しを行う。\n\n改善\n\nそのまま\nごみの分別方法・減量方法などの情報を提供し、市民\n継続\n\n拡充\n\n拡充\n\n事務の簡素化の検討を行い、事業内容を見直す。新た\nに取り組む団体を増やすためにも、事業所などへの啓\n発活動を行う。\n\nごみ資源化減量化対策事業\n\n市道清掃ボランティア支援事業\n\n現在取り組んでいる事業系のごみ分別指導の強化や、\nのごみに対する意識向上にさらに取り組む。\n\n天草宝島観光協会補助金\n\n縮小\n\n縮小\n\n関係機関と連携・調","status":"available","textSha256":"4a969106964b4692b448cd62d85c5c60b550a84ca68f84246fbb4a95bb6b8f55","truncated":false},"title":"事務事業評価を行いました","titleBasis":"inventory_title","url":"https://www.city.amakusa.kumamoto.jp/kiji0031888/3_1888_5_up_s0ttyciv.pdf","verification":{"basis":["公式ページの本文・参照関係を確認（原本バイトは未保存）"],"evaluationRelevance":"verified","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]}]}
