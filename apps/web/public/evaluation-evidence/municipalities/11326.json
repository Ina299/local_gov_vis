","same_municipality_official_host"],"evaluationRelevance":"not_established","evidenceSha256":"6d4c36317abfdbd3b2bbd050fd60bb75b05d381a162f6ba8771a02a33625211e","evidenceSourceId":"276d175282554d5b2419d48a","status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-11T18:01:01.483009+00:00","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"ba5508b39952756348a2c68a122cfd15dfe357630dcfb0467e68b2e5aa53d3f2","state":"acquired"},"evaluationType":"unknown","format":"pdf","id":"57cac00ae16339e6a84a5cf6","role":"supporting_document","text":{"assetBytes":165208,"assetPath":"documents/57cac00ae16339e6a84a5cf6.json","assetSha256":"6caeb13e652a227943f6c52a1188a2d41a1deca25930828797954e299fd101eb","characters":57437,"exportedCharacters":57437,"extractionMethod":"cached_extracted_text_hash_verified","inputTextSha256":"36c8644789c2556e117ce73d13952cf977819cc855a8283f69e6a09ee8a51311","label":"unstructured_source_text","preview":"度 目 標 設 定 書 （企画財政課）\n企画財政課長 小 峰 一 俊\n１ 当課の主な業務は次のように定義されます。\n・重要政策の推進に関すること\n・行政改革及び行政評価に関すること\n・広域行政に関すること\n・統計に関すること\n・予算編成及び配当に関すること\n・高度情報化及び電子計算業務に関すること\n２ 当課の業務は次の方々のために行われます。\n重要政策の推進、行政改革及び行政評価、広域行政、予算編成及び配当に関する業務による行政サー\nビスの向上は全ての町民の皆さんのために。高度情報化に関する業務は、町内外に住む町の各種情報\nを取得する方のために。電子計算業務はシステムを利用する各課職員や毛呂山町に住む全ての町民の\n皆さんのために。\n３ 当課の掲げる数値目標と、その根拠は次のとおりです。\n目 標 名 雇用の創出\n指 標 名 企業誘致促進条例に基づく町内在住者雇用奨励金交付件数【延べ】\n初期値（令和５年度） ０件\n現状値（令和７年度） ０件\n数値目標\n目標値（令和８年度） １件\n最終目標値（令和11年度） ６件\n設定根拠 第六次毛呂山町総合振興計画前期基本計画\n毛呂山町企業誘致促進条例に基づき、町内進出企業に対して、町内在住者の雇用や従業\n事業概要\n員の転入に係る支援を行います。\n４ 目標達成に向けた取り組みにより、次の効果が期待されます。\n町内在住者が雇用され、また企業の従業員が町内に転入するすることにより、税収の増収や地域経済\nの活性化が期待されます。\n５ 昨年度の取り組みの反省点は次のとおりでした。\n町内に進出した企業の中には町内在住者の雇用実績はあるものの、企業誘致促進条例","status":"available","textSha256":"87149283cdddac9966e24832c0117dae16d9c63f52c299f3dbad05431ee91290","truncated":false},"title":"全体版 (PDFファイル: 3.2MB)","titleBasis":"official_link_label","url":"https://www.town.moroyama.saitama.jp/material/files/group/5/R8zentaibann.pdf","verification":{"basis":["directory_host_unique_to_municipality"],"evaluationRelevance":"verified","evidenceSha256":"ba5508b39952756348a2c68a122cfd15dfe357630dcfb0467e68b2e5aa53d3f2","evidenceSourceId":"57cac00ae16339e6a84a5cf6","status":"verified"},"years":[{"basis":"printed_text","calendarYear":2026,"label":"令和８年度","meaning":"fiscal_year_mentioned","quote":"令和８年度 目 標 設 定 書 （議会事務局） 議会事務局長 波 田 裕 一 １ 当課の主な業務は次のように定義されます"},{"basis":"printed_text","calendarYear":2023,"label":"令和５年度","meaning":"fiscal_year_mentioned","quote":"名 議会録画ネット放映視聴回数【年度末時点】 初期値（令和５年度） － 現状値（令和７年度） 9,000回 数値目標 目標値（令和８年度） 9,250回 最終目標値（令和11"},{"basis":"printed_text","calendarYear":2025,"label":"令和７年度","meaning":"fiscal_year_mentioned","quote":"聴回数【年度末時点】 初期値（令和５年度） － 現状値（令和７年度） 9,000回 数値目標 目標値（令和８年度） 9,250回 最終目標値（令和11年度） 2,500回 本事"},{"basis":"printed_text","calendarYear":2029,"label":"令和11年度","meaning":"fiscal_year_mentioned","quote":"値目標 目標値（令和８年度） 9,250回 最終目標値（令和11年度） 2,500回 本事業は令和７年度開始のため初期値設定はありません。当初は近隣町の視聴回数を参 設定根拠 考"},{"basis":"printed_text","calendarYear":2026,"label":"令和８年","meaning":"calendar_year_mentioned","quote":"等について双方で共通認識が持てるように努めました。また、令和８年１月 には毛呂山町の日本語教育の現状について学ぶため、町内の日本語ボランティアサークルの活動に キーパーソン２"},{"basis":"printed_text","calendarYear":2025,"label":"令和７年","meaning":"calendar_year_mentioned","quote":"す。 ５ 昨年度の取り組みの反省点は次のとおりでした。 令和７年４月１日からワゴン車５台体制への移行及び停留所の増設により、もろバスの利便性が向上 し、利用者数が大幅に増加し"},{"basis":"printed_text","calendarYear":2026,"label":"令和8年","meaning":"calendar_year_mentioned","quote":"実施した「毛呂山町公式ＬＩＮＥ」に関するアンケート調査（令和8年1月実施）で は、配信内容について約３割（２６．８％）は「どちらとも言えない、または不満」があると回答し てい"}]},{"acquisition":{"containerSha256":null,"fetchedAt":null,"httpStatus":null,"inputStatus":"blocked","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":null,"state":"blocked"},"evaluationType":"unknown","format":"pdf","id":"61ea8da379930d514acdfa9f","role":"supporting_document","text":{"assetBytes":0,"assetPath":null,"assetSha256":null,"characters":0,"exportedC