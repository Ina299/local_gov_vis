emberIndex":null,"memberPath":null,"method":"network","sourceSha256":"1edabcbdd471d01e83bc9eb34cb06ec8e821f8a3f3f5879787c9b2b9b7b7bcfe","state":"acquired"},"evaluationType":"policy_evaluation","format":"pdf","id":"8e4383584230e93c2905a437","navigationReview":{"checkedAt":"2026-10-30T00:46:43.790Z","evidenceUrl":"https://www.pref.kanagawa.jp/docs/r5k/cnt/f4895/hyoukahoukokusho2025.html","method":"official_body_review","notes":"都道府県の公式ページに掲載されたリンクを探索で確認（2026年10月）。資料区分は探索時の判断で、本文とは未照合。","originEvidenceUrl":null,"publisher":"神奈川県","rawArchiveState":"collected","yearNotes":"評価報告書2025（2025年度の政策評価、令和8年7月公表）"},"role":"evaluation_document","text":{"assetBytes":286569,"assetPath":"documents/8e4383584230e93c2905a437.json","assetSha256":"7aa6313d5c6cf15c9064bf63f9a410385ac10ff0d925d872408e7c14c17a5476","characters":149406,"continuations":[{"assetBytes":78417,"assetPath":"documents/8e4383584230e93c2905a437-2.json","assetSha256":"c6dfc98c59e0febde07c0ffe36e9c25fdf888bcf6de3ef2fa8d660756a7b8632","exportedCharacters":29406,"part":2,"startCharacter":120000,"textSha256":"f96c437648e3f79ee5194064956550bb71e8b649ab76093d6e7b93edc57e5b03"}],"exportedCharacters":120000,"extractionMethod":"pdftotext_from_verified_bytes","fullTextSha256":"df99519e9741c0639d7c31c7a8f348a58412911bcb080db445afd15632ae1f6a","inputTextSha256":"1edabcbdd471d01e83bc9eb34cb06ec8e821f8a3f3f5879787c9b2b9b7b7bcfe","label":"unstructured_source_text","preview":"新かながわグランドデザイン\n評価報告書 2025\n\n令和８年６月\n\n\n目\n\n次\n\n１\n\n評価の概要\n評価の概要\n凡例\n\n２\n\n総合計画審議会の評価\n\n・・・・・・・・・・・・・・・・・\n\n11\n\n３\n\nプロジェクトの評価\n・・・・・・・・・・・・・・・・・・\nテーマⅠ 希望の持てる神奈川\n・・・・・・・・・・・・・\n\n13\n14\n\n１\n２\n３\n４\n５\n\n78\n\n・・・・・・・・・\n\n112\n\n・・・・・・・・・・・\n\n138\n\n・・・・・・・・・・\n\n166\n\n・・・・・・・・・・・・・・・・・・\n\n177\n\n・・・・・・・・・・・・・・・・・・・・・\n\n178\n\n自分らしく生きられる神奈川\n\n安心してくらせる神奈川\n\nくらしの安心\n危機管理\n\nテーマⅤ\n13\n\n・・・・・・・・・・・\n\n生活困窮\n共生社会\n\nテーマⅣ\n11\n12\n\n持続的に発展する神奈川\n\n経済・労働\n農林水産\n脱炭素・環境\n\nテーマⅢ\n９\n10\n\n１\n２\n６\n\n子ども・若者\n教育\n未病・健康長寿\n文化・スポーツ\n観光・地域活性化\n\nテーマⅡ\n６\n７\n８\n\n・・・・・・・・・・・・・・・・・・・・・・\n・・・・・・・・・・・・・・・・・・・・・・\n・・・・・・・・・・・・・・・・・・・・・・\n\n神奈川を支える基盤づくり\n\n都市基盤\n\n４\n\nプロジェクト事業費\n\n５\n\n用語解説\n\n\n１\n\n評価の概要\n\n1\n\n\n評価の概要\n「新かながわグランドデザイン」とは\n県では、県政運営の総合的・基本的指針を示す総合計画として、2024（令和６）年\n３月に「新かながわグランドデザイン基本構想」（以下「基本構想」という。）及び\n「新かながわグランドデザイン実施計画」（以下「実施計画」という。）を策定し、\n超高齢社会や本格的な人口減少社会への対応に加え、新型コロナウイルス感染症のよ\nうな感染症の世界的流行、自然災害の激甚化、頻発化、国際情勢の不安定化などの不\n確実性の高まりや、デジタル化の加速、世界的な脱炭素化の潮流など、様々な変化や\n課題への対応を進めています。\n「基本構想」では、基本理念とする「いのち輝くマグネット神奈川」の実現をめざ\nし、2040（令和22）年を展望した神奈川の将来像や県の政策の基本方向を示していま\nす。また、「実施計画」では、「基本構想」の実現に向け、４年後の姿として「県民\n目線のデジタル行政","status":"available","textSha256":"3361672a526399abc820cec78c9d698c25c241620695411d3157c53fd34a2c25","truncated":true},"title":"新かながわグランドデザイン　評価報告書2025（PDF：9,440KB）","titleBasis":"official_link_label","url":"https://www.pref.kanagawa.jp/documents/136809/hyoukahoukokusho2025.pdf","verification":{"basis":["都道府県の公式ドメイン上のページに掲載されたリンク（探索時に確認）"],"evaluationRelevance":"verified","evidenceSha256":null,"evidenceSourceId":null,"status":"verified"},"years":[]},{"acquisition":{"containerSha256":null,"fetchedAt":"2026-10-30T00:45:29.311Z","httpStatus":200,"inputStatus":"fetched","memberIndex":null,"memberPath":null,"method":"network","sourceSha256":"3079c8fd6ac2d9cf48d48745f8e34e32721aa2f8d88e5f2c33ce5249d8a49379","state":"acquired"},"evaluationType":"policy_evaluation","format":"pdf","id":"a16f352ce5c4cd583cb14bc3","navigationReview":{"checkedAt":"2026-10-30T00:46:43.790Z","evidenceUrl":"https://www.pref.kanagawa.jp/docs/r5k/cnt/f4895/hyoukahoukokusho2025.html","method":"official_body_review","notes":"都道府県の公式ページに掲載されたリンクを探索で確認（2026年10月）。資料区分は探索時の判断で、本文とは未照合。","originEvidenceUrl":null,"publisher":"神奈川県","rawArchiveState":"collected","yearNotes":"評価報告書2025"},"role":"evaluation_document","text":{"assetBytes":39045,"assetPath":"documents/a16f352ce5c4cd583cb14bc3.json","assetSha256":"1c6c8fa12933dd5cb8ac1763c1384736c496c87d8d5bbf45bc8151d1b994c9b2","characters":15072,"exportedCharacters":15072,"extractionMethod":"pdft